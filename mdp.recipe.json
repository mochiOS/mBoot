{
  "format": 1,
  "steps": [
    "python3 $(PROJECT)/scripts/build-mdp.py"
  ],
  "package": {
    "name": "mboot",
    "version": "0.1.0",
    "target": "x86_64-mochios",
    "abi": "mochios-1"
  },
  "artifact": "out/mdp/mboot.tar.mdp",
  "exports": [
    {
      "source": "$(PROJECT)/out/mdp/hardware/mochiOS.img",
      "area": "hardware-media",
      "destination": "mochiOS.img"
    }
  ]
}
