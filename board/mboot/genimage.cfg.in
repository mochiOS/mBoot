image efi-part.vfat {
	vfat {
		extraargs = "--invariant -i @MBOOT_EFI_VOLUME_ID@"
		file EFI { image = "efi-part/EFI" }
		file bzImage { image = "bzImage" }
	}
	size = 64M
}

image disk.img {
	hdimage {
		partition-table-type = "gpt"
		disk-uuid = @MBOOT_DISK_GUID@
	}

	partition grub-core {
		partition-type-uuid = 21686148-6449-6E6F-744E-656564454649
		partition-uuid = @MBOOT_BIOS_PARTUUID@
		offset = 1M
		size = 1M
	}

	partition efi-system {
		partition-type-uuid = U
		partition-uuid = @MBOOT_EFI_PARTUUID@
		image = "efi-part.vfat"
		bootable = true
	}

	partition root {
		partition-type-uuid = @MBOOT_ROOT_PARTITION_TYPE@
		partition-uuid = @MBOOT_ROOT_PARTUUID@
		image = "rootfs.ext2"
	}
}
