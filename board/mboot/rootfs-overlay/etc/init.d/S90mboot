#!/bin/sh

DAEMON=/usr/libexec/mboot-launcher
CONTROL_SERVICE=/etc/init.d/S80mbootd
PIDFILE=/run/mboot/launcher.pid
LOG=/var/log/mboot/launcher.log

valid_pid() {
	[ -f "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null)
	case "$pid" in ''|*[!0-9]*) return 1;; esac
	[ -r "/proc/$pid/cmdline" ] && tr '\000' ' ' < "/proc/$pid/cmdline" | grep -Fq "$DAEMON"
}

start() {
	printf 'Starting mBoot launcher: '
	mkdir -p /run/mboot /var/log/mboot
	if valid_pid; then echo 'already running'; return 0; fi
	rm -f "$PIDFILE" /run/mboot/qemu.pid
	if ! "$CONTROL_SERVICE" status >/dev/null 2>&1 && ! "$CONTROL_SERVICE" start; then
		echo 'control daemon failed'
		return 1
	fi
	[ -x "$DAEMON" ] || { echo 'missing'; return 1; }
	start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" -- >>"$LOG" 2>&1
	count=0
	while [ "$count" -lt 50 ]; do
		if valid_pid; then echo 'OK'; return 0; fi
		count=$((count + 1)); sleep 0.1
	done
	rm -f "$PIDFILE"
	echo 'FAIL'
	return 1
}

stop() {
	printf 'Stopping mBoot launcher: '
	if ! valid_pid; then rm -f "$PIDFILE"; echo 'not running'; return 0; fi
	pid=$(cat "$PIDFILE")
	kill -TERM "$pid" 2>/dev/null || true
	count=0
	while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 100 ]; do
		count=$((count + 1)); sleep 0.1
	done
	if kill -0 "$pid" 2>/dev/null; then kill -KILL "$pid" 2>/dev/null || true; fi
	rm -f "$PIDFILE" /run/mboot/qemu.pid
	echo 'OK'
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	status) valid_pid ;;
	*) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 1 ;;
esac
