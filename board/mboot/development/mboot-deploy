#!/bin/sh
set -eu

MARKER=/etc/mboot-development
SERVICE=/etc/init.d/S90mboot
IMAGE=/var/lib/mboot/mochiOS.img
INCOMING=/var/lib/mboot/mochiOS.img.new
PREVIOUS=/var/lib/mboot/mochiOS.img.previous
QEMU_PIDFILE=/run/mboot/qemu.pid
MIGRATION_ROOT=/run/mboot/deploy-migration

fail() {
	echo "mboot-deploy: $*" >&2
	exit 1
}

qemu_started() {
	[ -r "$QEMU_PIDFILE" ] || return 1
	pid=$(cat "$QEMU_PIDFILE" 2>/dev/null || true)
	case "$pid" in ''|*[!0-9]*) return 1;; esac
	kill -0 "$pid" 2>/dev/null
}

start_and_verify() {
	"$SERVICE" start
	count=0
	while [ "$count" -lt 100 ]; do
		qemu_started && return 0
		count=$((count + 1))
		sleep 0.1
	done
	return 1
}

validate_directory_path() {
	root=$1
	relative=$2
	current=$root
	old_ifs=$IFS
	IFS=/
	set -- $relative
	IFS=$old_ifs
	for component do
		current=$current/$component
		[ ! -L "$current" ] || return 1
		[ -d "$current" ] || return 1
	done
}

ensure_directory_path() {
	root=$1
	relative=$2
	current=$root
	old_ifs=$IFS
	IFS=/
	set -- $relative
	IFS=$old_ifs
	for component do
		current=$current/$component
		if [ -e "$current" ] || [ -L "$current" ]; then
			[ ! -L "$current" ] && [ -d "$current" ] || return 1
		else
			mkdir "$current"
		fi
	done
}

migrate_missing_children() {
	old_root=$1
	new_root=$2
	relative=$3
	validate_directory_path "$old_root" "$relative" || return 1
	ensure_directory_path "$new_root" "$relative" || return 1
	for source in "$old_root/$relative"/*; do
		[ -e "$source" ] || [ -L "$source" ] || continue
		name=${source##*/}
		destination=$new_root/$relative/$name
		if [ ! -e "$destination" ] && [ ! -L "$destination" ]; then
			cp -a "$source" "$destination"
		fi
	done
}

migrate_persistent_state() (
	old_mount=$MIGRATION_ROOT/old
	new_mount=$MIGRATION_ROOT/new
	old_loop=
	new_loop=
	mounted_old=0
	mounted_new=0
	cleanup() {
		[ "$mounted_new" -eq 0 ] || umount "$new_mount" 2>/dev/null || true
		[ "$mounted_old" -eq 0 ] || umount "$old_mount" 2>/dev/null || true
		[ -z "$new_loop" ] || losetup -d "$new_loop" 2>/dev/null || true
		[ -z "$old_loop" ] || losetup -d "$old_loop" 2>/dev/null || true
	}
	trap cleanup EXIT

	mkdir -p "$old_mount" "$new_mount"
	old_loop=$(losetup -fPr --show "$IMAGE")
	new_loop=$(losetup -fP --show "$INCOMING")
	mount -o ro "${old_loop}p2" "$old_mount"
	mounted_old=1
	mount "${new_loop}p2" "$new_mount"
	mounted_new=1

	for path in var/config system/users home libraries/users libraries/applications; do
		if [ -e "$old_mount/$path" ] || [ -L "$old_mount/$path" ]; then
			validate_directory_path "$old_mount" "$path" || return 1
			ensure_directory_path "$new_mount" "$path" || return 1
			cp -a "$old_mount/$path/." "$new_mount/$path/"
		fi
	done
	# User-installed bundles and their package records live beside system-owned
	# entries. Carry forward only names absent from the new image so an installed
	# package cannot replace a newer system component during development deploys.
	for path in applications system/packages; do
		if [ -e "$old_mount/$path" ] || [ -L "$old_mount/$path" ]; then
			migrate_missing_children "$old_mount" "$new_mount" "$path" || return 1
		fi
	done
	sync
)

swap_images() {
	temporary=/var/lib/mboot/mochiOS.img.swap
	rm -f "$temporary"
	mv "$IMAGE" "$temporary"
	mv "$PREVIOUS" "$IMAGE"
	mv "$temporary" "$PREVIOUS"
	sync
}

install_image() {
	expected=${1:-}
	case "$expected" in *[!0-9a-f]*|'') fail 'invalid SHA-256';; esac
	[ "${#expected}" -eq 64 ] || fail 'SHA-256 must contain 64 characters'
	[ -f "$INCOMING" ] || fail "incoming image is missing: $INCOMING"
	[ "$(wc -c < "$INCOMING")" -ge 67108864 ] || fail 'incoming image is too small'
	[ "$(dd if="$INCOMING" bs=1 skip=512 count=8 2>/dev/null)" = 'EFI PART' ] ||
		fail 'incoming image is not a raw GPT disk'
	actual=$(sha256sum "$INCOMING" | awk '{print $1}')
	[ "$actual" = "$expected" ] || fail "checksum mismatch: $actual"

	"$SERVICE" stop
	if ! migrate_persistent_state; then
		"$SERVICE" start || true
		fail 'persistent state migration failed'
	fi
	rm -f "$PREVIOUS"
	ln "$IMAGE" "$PREVIOUS"
	chmod 0600 "$INCOMING"
	mv -f "$INCOMING" "$IMAGE"
	sync
	if start_and_verify; then
		echo "mboot-deploy: installed $actual"
		return 0
	fi
	echo 'mboot-deploy: new image failed to start; rolling back' >&2
	"$SERVICE" stop || true
	swap_images
	start_and_verify || fail 'rollback image also failed to start'
	fail 'new image was rolled back'
}

rollback() {
	[ -f "$PREVIOUS" ] || fail 'previous image is unavailable'
	"$SERVICE" stop
	swap_images
	start_and_verify || fail 'rolled-back image failed to start'
	echo 'mboot-deploy: rollback complete'
}

[ -f "$MARKER" ] || fail 'development mode is disabled'
case "${1:-}" in
	install) install_image "${2:-}" ;;
	rollback) rollback ;;
	restart) "$SERVICE" restart ;;
	*) fail 'usage: mboot-deploy {install SHA256|rollback|restart}' ;;
esac
