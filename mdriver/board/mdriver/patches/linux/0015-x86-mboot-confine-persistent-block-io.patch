-	BUILD_BUG_ON(sizeof(*info) != 16);
+	BUILD_BUG_ON(sizeof(*info) != 64);
 	info = kzalloc(sizeof(*info), GFP_KERNEL);
 	if (!info)
 		return -ENOMEM;
@@ -812,6 +863,8 @@
 static void *mboot_block_buffer;
 static unsigned long mboot_block_grant_ref;
 static u32 mboot_block_device_id;
+static u64 mboot_block_first_sector;
+static u64 mboot_block_sector_count;
 static u64 mboot_grant_window_start;
 static bool mboot_block_io_verified;
 static struct mboot_ring_page *mboot_block_ring;
@@ -848,6 +901,8 @@
 		features |= MBOOT_DEVICE_FEATURE_EPHEMERAL;
 	if (info->flags & MBOOT_PCI_FLAG_READ_ONLY)
 		features |= MBOOT_DEVICE_FEATURE_READ_ONLY;
+	if (info->flags & MBOOT_PCI_FLAG_PARTITIONED)
+		features |= MBOOT_DEVICE_FEATURE_PARTITIONED;
 	if (mboot_control_device_kind(info) == MBOOT_DEVICE_KIND_BLOCK)
 		features |= MBOOT_DEVICE_FEATURE_BLOCK_READ |
 			    MBOOT_DEVICE_FEATURE_BLOCK_ASYNC_QUEUE;
@@ -867,21 +922,319 @@
