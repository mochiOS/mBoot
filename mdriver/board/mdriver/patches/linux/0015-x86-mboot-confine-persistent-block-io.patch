From: tas0dev <156896971+tas0dev@users.noreply.github.com>
Subject: [PATCH] x86/mboot: confine persistent block I/O

Validate both GPT copies against the storage policy supplied by mBoot and
expose only the enrolled partition to mochiOS. Reject malformed, ambiguous,
or out-of-range layouts before allowing block I/O.

Signed-off-by: tas0dev <156896971+tas0dev@users.noreply.github.com>
---
--- a/arch/x86/kernel/cpu/mboot.c
+++ b/arch/x86/kernel/cpu/mboot.c
@@ -4,6 +4,7 @@
 #include <linux/bits.h>
 #include <linux/blkdev.h>
 #include <linux/build_bug.h>
+#include <linux/crc32.h>
 #include <linux/delay.h>
 #include <linux/device/class.h>
 #include <linux/errno.h>
@@ -19,6 +20,7 @@
 #include <linux/pci.h>
 #include <linux/slab.h>
 #include <linux/string.h>
+#include <linux/unaligned.h>
 
 #include <asm/apic.h>
 #include <asm/cpufeature.h>
@@ -53,6 +55,7 @@
 #define MBOOT_PCI_FLAG_CLAIMABLE BIT(0)
 #define MBOOT_PCI_FLAG_EPHEMERAL BIT(1)
 #define MBOOT_PCI_FLAG_READ_ONLY BIT(2)
