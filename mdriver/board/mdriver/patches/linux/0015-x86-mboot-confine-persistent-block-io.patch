+		    !memchr_inv(info->storage_partition_type_guid, 0, 16) ||
+		    !memchr_inv(info->storage_partition_guid, 0, 16))
+			return false;
+	} else if (memchr_inv(info->storage_disk_guid, 0, 16) ||
+		   memchr_inv(info->storage_partition_type_guid, 0, 16) ||
+		   memchr_inv(info->storage_partition_guid, 0, 16)) {
 		return false;
+	}
 
 	switch (info->state) {
 	case MBOOT_PCI_STATE_QUARANTINED:
@@ -407,7 +457,8 @@
 	case MBOOT_PCI_STATE_ACTIVE:
 		return info->owner_domain &&
 		       !(info->flags & ~(MBOOT_PCI_FLAG_EPHEMERAL |
-				       MBOOT_PCI_FLAG_READ_ONLY));
+				       MBOOT_PCI_FLAG_READ_ONLY |
+				       MBOOT_PCI_FLAG_PARTITIONED));
