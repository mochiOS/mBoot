 #define MBOOT_MAX_PCI_DEVICES 256
 #define MBOOT_MAX_ASSIGNED_DEVICES 32
 #define MBOOT_PCI_CONFIG_DWORDS 64
@@ -110,6 +113,7 @@
 #define MBOOT_DEVICE_FEATURE_PHYSICAL BIT_ULL(2)
 #define MBOOT_DEVICE_FEATURE_EPHEMERAL BIT_ULL(3)
 #define MBOOT_DEVICE_FEATURE_READ_ONLY BIT_ULL(4)
+#define MBOOT_DEVICE_FEATURE_PARTITIONED BIT_ULL(5)
 #define MBOOT_DEVICE_FEATURE_BLOCK_READ BIT_ULL(8)
 #define MBOOT_DEVICE_FEATURE_BLOCK_WRITE BIT_ULL(9)
 #define MBOOT_DEVICE_FEATURE_BLOCK_FLUSH BIT_ULL(10)
@@ -134,6 +138,12 @@
 #define MBOOT_BLOCK_STATUS_OUT_OF_RANGE 3
 #define MBOOT_BLOCK_STATUS_BAD_STATE 4
 #define MBOOT_BLOCK_STATUS_READ_ONLY 5
+#define MBOOT_GPT_SIGNATURE 0x5452415020494645ULL
+#define MBOOT_GPT_REVISION 0x00010000
+#define MBOOT_GPT_HEADER_MIN_SIZE 92
+#define MBOOT_GPT_ENTRY_MIN_SIZE 128
+#define MBOOT_GPT_MAX_ENTRIES 256
+#define MBOOT_GPT_MAX_ENTRY_BYTES (1024 * 1024)
 
 struct mboot_ring_header {
 	u64 magic;
@@ -212,6 +222,32 @@
 	u8 reserved[3];
 	u32 owner_domain;
 	u32 flags;
+	u8 storage_disk_guid[16];
+	u8 storage_partition_type_guid[16];
+	u8 storage_partition_guid[16];
+};
+
+struct mboot_gpt_header {
+	__le64 signature;
+	__le32 revision;
+	__le32 header_size;
+	__le32 header_crc32;
+	__le32 reserved;
+	__le64 current_lba;
+	__le64 backup_lba;
+	__le64 first_usable_lba;
+	__le64 last_usable_lba;
+	u8 disk_guid[16];
+	__le64 partition_entry_lba;
+	__le32 partition_entry_count;
+	__le32 partition_entry_size;
+	__le32 partition_entry_crc32;
+} __packed;
+
+struct mboot_gpt_copy {
+	struct mboot_gpt_header header;
+	u8 *entries;
+	size_t entries_size;
 };
 
