From: mochiOS <dev@mochios.local>
Subject: [PATCH] x86/mboot: wait for control ring events

The control ring carries synchronous display and input requests. A timed
Linux scheduler sleep cannot be woken by an mBoot Event Channel, so every
request pays at least one guest timer and scheduling cycle. Block the vCPU
on EventWait instead; mBoot resumes it directly with the delivered port.

--- a/arch/x86/kernel/cpu/mboot.c
+++ b/arch/x86/kernel/cpu/mboot.c
@@ -4007,19 +4007,18 @@ static int mboot_control_worker(void *unused)
 		bool ignored = false;
 
 		result = mboot_hypercall(MBOOT_HYPERCALL_EVENT_POLL, 0, 0, 0);
+		if (result == MBOOT_EVENT_NO_EVENT)
+			result = mboot_hypercall(MBOOT_HYPERCALL_EVENT_WAIT, 0, 0, 0);
 		if (result == MBOOT_CONTROL_RING_PORT) {
 			if (mboot_control_process(&ignored))
 				break;
 		} else if (result == MBOOT_BLOCK_RING_PORT) {
 			if (mboot_block_process())
 				break;
 		} else if (result != MBOOT_EVENT_NO_EVENT) {
 			break;
 		}
-		if (result == MBOOT_EVENT_NO_EVENT)
-			msleep_interruptible(10);
-		else
-			cond_resched();
+		cond_resched();
 	}
 	mboot_block_queue_close();
 	mboot_block_close();
