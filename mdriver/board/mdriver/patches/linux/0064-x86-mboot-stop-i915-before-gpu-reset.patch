From: mochiOS developers
Subject: [PATCH] x86/mboot: stop i915 before reset or on MMIO probe failure

Explicit diagnostic mode only. Preserve probe state and its report without
running the subsequent reset, GGTT setup, KMS, or failure teardown.

--- a/arch/x86/kernel/cpu/mboot.c
+++ b/arch/x86/kernel/cpu/mboot.c
@@ -363,6 +363,15 @@
 }
 early_param("mboot.mmio_check", mboot_mmio_check_param);
 
+static bool mboot_i915_check;
+static int __init mboot_i915_check_param(char *value)
+{
+	mboot_i915_check = true;
+	atomic_set(&mboot_gpu_probe_gate, 1);
+	return 0;
+}
+early_param("mboot.i915_check", mboot_i915_check_param);
+
 static unsigned long mboot_hypercall(unsigned long number,
 				     unsigned long arg0, unsigned long arg1,
 				     unsigned long arg2);
@@ -788,6 +797,7 @@
 };
 
 static DEFINE_SPINLOCK(mboot_probe_lock);
+static void mboot_gpu_probe_report(struct pci_dev *pdev);
 
 void mboot_gpu_probe_trace(struct device *dev, const char *event,
 			   const char *detail, int result)
@@ -821,6 +831,19 @@
 		frontend->probe_trace_len += len;
 	}
 	spin_unlock_irqrestore(&mboot_probe_lock, flags);
+	/* Explicit diagnostic boot only, in the sleepable i915 probe path.
+	 * Keep the failing state intact rather than running reset or cleanup.
+	 * No periodic redraw, watchdog, network gate, or attach retry. */
+	if (mboot_i915_check && pdev->vendor == PCI_VENDOR_ID_INTEL &&
+	    (!strcmp(event, "i915-stop") ||
+	     (result < 0 && (!strcmp(event, "mmio-error") ||
+			    !strncmp(event, "i915-", 5))))) {
+		mboot_gpu_probe_report(pdev);
+		for (;;) {
+			set_current_state(TASK_UNINTERRUPTIBLE);
+			schedule();
+		}
+	}
 }
 
 static ssize_t gpu_probe_show(struct device *dev,
--- a/drivers/gpu/drm/i915/i915_driver.c
+++ b/drivers/gpu/drm/i915/i915_driver.c
@@ -361,6 +361,8 @@
 	}
 
 	/* As early as possible, scrub existing GPU state before clobbering */
+	mboot_gpu_probe_trace(dev_priv->drm.dev, "i915-stop",
+			      "MMIO OK BEFORE GPU RESET", 0);
 	sanitize_gpu(dev_priv);
 
 	return 0;
@@ -791,6 +793,7 @@
 
 	stage = "I915 EARLY";
 	ret = i915_driver_early_probe(i915);
+	mboot_gpu_probe_trace(&pdev->dev, "i915-stage", stage, ret);
 	if (ret < 0)
 		goto out_pci_disable;
 
@@ -800,11 +803,13 @@
 
 	stage = "I915 GT";
 	ret = intel_gt_probe_all(i915);
+	mboot_gpu_probe_trace(&pdev->dev, "i915-stage", stage, ret);
 	if (ret < 0)
 		goto out_runtime_pm_put;
 
 	stage = "I915 MMIO";
 	ret = i915_driver_mmio_probe(i915);
+	mboot_gpu_probe_trace(&pdev->dev, "i915-stage", stage, ret);
 	if (ret < 0)
 		goto out_runtime_pm_put;
