+static bool __init mboot_pci_info_valid(const struct mboot_pci_device_info *info)
+{
+	if (memchr_inv(info->reserved, 0, sizeof(info->reserved)) ||
+	    info->flags & ~(MBOOT_PCI_FLAG_CLAIMABLE |
+			    MBOOT_PCI_FLAG_EPHEMERAL |
+			    MBOOT_PCI_FLAG_READ_ONLY |
+			    MBOOT_PCI_FLAG_PARTITIONED) ||
+	    (info->flags & MBOOT_PCI_FLAG_EPHEMERAL &&
+	     info->flags & (MBOOT_PCI_FLAG_READ_ONLY |
+			   MBOOT_PCI_FLAG_PARTITIONED)) ||
+	    (info->flags & MBOOT_PCI_FLAG_READ_ONLY &&
+	     info->flags & MBOOT_PCI_FLAG_PARTITIONED))
+		return false;
+	if (info->flags & MBOOT_PCI_FLAG_PARTITIONED) {
+		if (!memchr_inv(info->storage_disk_guid, 0, 16) ||
+		    !memchr_inv(info->storage_partition_type_guid, 0, 16) ||
+		    !memchr_inv(info->storage_partition_guid, 0, 16))
+			return false;
+	} else if (memchr_inv(info->storage_disk_guid, 0, 16) ||
+		   memchr_inv(info->storage_partition_type_guid, 0, 16) ||
+		   memchr_inv(info->storage_partition_guid, 0, 16)) {
+		return false;
+	}
+
+	switch (info->state) {
+	case MBOOT_PCI_STATE_QUARANTINED:
+		return !info->owner_domain;
+	case MBOOT_PCI_STATE_FIRMWARE_DEFERRED:
+		return !info->owner_domain &&
+		       !(info->flags & ~MBOOT_PCI_FLAG_CLAIMABLE);
+	case MBOOT_PCI_STATE_CLAIMED_DISABLED:
+	case MBOOT_PCI_STATE_ACTIVE:
+		return info->owner_domain &&
+		       !(info->flags & ~(MBOOT_PCI_FLAG_EPHEMERAL |
+				       MBOOT_PCI_FLAG_READ_ONLY |
+				       MBOOT_PCI_FLAG_PARTITIONED));
+	default:
+		return false;
+	}
+}
