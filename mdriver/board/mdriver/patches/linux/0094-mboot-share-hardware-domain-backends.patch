+static struct mboot_pci_frontend *mboot_pci_find(unsigned int bus,
+						 unsigned int devfn)
+{
+	u16 requester = bus << 8 | devfn;
+	unsigned int index;
+
+	for (index = 0; index < mboot_pci_device_count; index++)
+		if (mboot_pci_devices[index].info.requester == requester)
+			return &mboot_pci_devices[index];
+	return NULL;
+}
+
+static bool mboot_pci_config_only(const struct mboot_pci_frontend *device)
+{
+	return device->info.requester == 0 &&
+	       device->info.class == PCI_BASE_CLASS_BRIDGE &&
+	       device->info.subclass == 0 &&
+	       device->info.flags & MBOOT_PCI_FLAG_READ_ONLY;
+}
