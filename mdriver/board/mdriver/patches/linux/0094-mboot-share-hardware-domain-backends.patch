+// SPDX-License-Identifier: GPL-2.0
+/* Native mBoot HVC transport; PCI/DMA assignment is not implemented here. */
+#include <linux/err.h>
+#include <linux/mboot_guest.h>
+#include <linux/of.h>
+#include <linux/mm.h>
+
+static struct device_node *mboot_node(void)
+{
+    struct device_node *node = of_find_node_by_path("/hypervisor");
+    u32 version;
+    if (!node) return NULL;
+    if (!of_device_is_compatible(node, "mochios,mboot") ||
+        of_property_read_u32(node, "mochios,abi-version", &version) || version != 1) {
+        of_node_put(node);
+        return NULL;
+    }
+    return node;
+}
+bool mboot_arch_present(void)
+{
+    struct device_node *node = mboot_node();
+    if (!node) return false;
+    of_node_put(node);
+    return true;
+}
+bool mboot_arch_grant_window(u64 *start, u64 *size)
+{
+    struct device_node *node = mboot_node();
+    u64 range[2];
+    int result;
+    if (!node) return false;
+    result = of_property_count_u64_elems(node, "mochios,grant-window") == 2 ?
+        of_property_read_u64_array(node, "mochios,grant-window", range, 2) : -EINVAL;
+    of_node_put(node);
+    if (result || !range[1] || (range[0] | range[1]) & (PAGE_SIZE - 1) ||
+        range[0] > U64_MAX - range[1]) return false;
+    *start = range[0]; *size = range[1];
+    return true;
+}
+unsigned long mboot_hypercall(unsigned long number, unsigned long a,
+                              unsigned long b, unsigned long c)
+{
+    register unsigned long x0 asm("x0") = number;
+    register unsigned long x1 asm("x1") = a;
+    register unsigned long x2 asm("x2") = b;
+    register unsigned long x3 asm("x3") = c;
+    asm volatile("hvc #0" : "+r"(x0) : "r"(x1), "r"(x2), "r"(x3) : "memory");
+    return x0;
+}
+int __init mboot_arch_irq_alloc(u32 requester, unsigned int count, void *context)
+{ return -EOPNOTSUPP; }
+void *__init mboot_arch_pci_data(unsigned int bus) { return ERR_PTR(-EOPNOTSUPP); }
+int __init mboot_arch_intel_stolen(const u32 *config) { return -EOPNOTSUPP; }
+
+int mboot_arch_irq_vector(unsigned int irq) { return -EOPNOTSUPP; }
