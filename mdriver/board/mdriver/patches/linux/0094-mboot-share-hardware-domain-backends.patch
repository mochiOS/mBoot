-	if (mboot_control_device_kind(info) == MBOOT_DEVICE_KIND_BLOCK)
-		features |= MBOOT_DEVICE_FEATURE_BLOCK_READ |
-			    MBOOT_DEVICE_FEATURE_BLOCK_ASYNC_QUEUE;
-	if (mboot_control_device_kind(info) == MBOOT_DEVICE_KIND_BLOCK &&
-	    !(info->flags & MBOOT_PCI_FLAG_READ_ONLY))
-		features |= MBOOT_DEVICE_FEATURE_BLOCK_WRITE |
-			    MBOOT_DEVICE_FEATURE_BLOCK_FLUSH;
-	if (mboot_control_device_kind(info) == MBOOT_DEVICE_KIND_DISPLAY) {
-		features |= MBOOT_DEVICE_FEATURE_DISPLAY_TILE;
-		if (mboot_grant_window_size >= MBOOT_DISPLAY_BULK_MAX_TRANSFER +
-					       MBOOT_DISPLAY_BULK_FIRST_PAGE * PAGE_SIZE)
-			features |= MBOOT_DEVICE_FEATURE_DISPLAY_BULK;
-		if (mboot_grant_window_size >=
-		    (MBOOT_DISPLAY_SURFACE_FIRST_PAGE +
-		     MBOOT_DISPLAY_SURFACE_MIN_PAGE_COUNT) * PAGE_SIZE)
-			features |= MBOOT_DEVICE_FEATURE_DISPLAY_SHARED_SURFACE;
-		if (READ_ONCE(mboot_gpu_open))
-			features |= MBOOT_DEVICE_FEATURE_DISPLAY_GPU_SCENE;
-	}
-	return features;
-}
