+static ssize_t mboot_gpu_probe_start_store(struct kobject *kobj,
+					  struct kobj_attribute *attr,
+					  const char *buf, size_t count)
+{
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	if (atomic_cmpxchg(&mboot_gpu_probe_gate, 1, 2) != 1)
+		return -EALREADY;
+	/* No framebuffer diagnostic writes once GPU publication is released. */
+	if (!mboot_text_console)
+		unregister_console(&mboot_log_console);
+	pr_info("mDriver: log receiver acknowledged; starting first GPU probe\n");
+	mod_delayed_work(system_wq, &mboot_ready_work, 0);
+	return count;
+}
+static struct kobj_attribute mboot_gpu_probe_start_attr =
+	__ATTR_WO(mboot_gpu_probe_start);
+static atomic_t mboot_ready_started = ATOMIC_INIT(0);
+static struct notifier_block mboot_fb_notifier;
+static bool mboot_display_reprobe_done;
+
+static void mboot_reprobe_display(void)
+{
+	unsigned int index;
+
+	if (mboot_display_reprobe_done)
+		return;
+	mboot_display_reprobe_done = true;
+	wait_for_device_probe();
+	if (mboot_display_probe_error) {
+		pr_err("mDriver: display probe failed; preserving boot diagnostics\n");
+		return;
+	}
+	for (index = 0; index < mboot_pci_device_count; index++) {
+		struct mboot_pci_frontend *device = &mboot_pci_devices[index];
+		struct pci_dev *pdev;
+		int result;
+
+		if (device->info.class != PCI_BASE_CLASS_DISPLAY)
+			continue;
+		pdev = pci_get_domain_bus_and_slot(0,
+					       device->info.requester >> 8,
+					       device->info.requester & 0xff);
+		if (!pdev)
+			continue;
+		if (!device->driver_published) {
+			/* PCI drivers and the log transport are ready; publish once. */
+			pci_bus_add_device(pdev);
+			device->driver_published = true;
+		} else if (!device_is_bound(&pdev->dev) &&
+			   atomic_read(&mboot_gpu_probe_gate) == 0) {
+			mboot_boot_device_error("GPU RETRY",
+						device->info.requester);
+			result = device_attach(&pdev->dev);
+			mboot_gpu_probe_trace(&pdev->dev, "attach-late", NULL, result);
+			pr_info("mDriver: display %04x reprobe result=%d\n",
+				device->info.requester, result);
+		}
+		device->driver_matched = pdev->dev.can_match;
+		device->driver_bound = device_is_bound(&pdev->dev);
+		mboot_gpu_probe_report(pdev);
+		pci_dev_put(pdev);
+	}
+}
+
+static void mboot_ready_workfn(struct work_struct *work)
+{
+	if (atomic_read(&mboot_gpu_probe_gate) == 1)
+		return;
+	mboot_reprobe_display();
+	if (!mboot_display_backend_ready()) {
+		/* Do not reset the deadline on each 100 ms readiness retry. */
+		if (!mboot_text_console && !READ_ONCE(mboot_gpu_open))
+			schedule_delayed_work(&mboot_gpu_watchdog_work,
+					      msecs_to_jiffies(5000));
+		/* The DRM framebuffer can appear before the userspace renderer has
+		 * completed EGL setup and its first KMS commit. */
+		mod_delayed_work(system_wq, &mboot_ready_work,
+				 msecs_to_jiffies(100));
+		return;
+	}
+	if (atomic_cmpxchg(&mboot_ready_started, 0, 1))
+		return;
+	fb_unregister_client(&mboot_fb_notifier);
+	if (mboot_finish_ready()) {
+		pr_err("mDriver: hardware backend startup failed\n");
+		return;
+	}
+}
+
+static int mboot_fb_event(struct notifier_block *notifier,
+			  unsigned long event, void *data)
+{
+	if (event == FB_EVENT_FB_REGISTERED) {
+		if (mboot_text_console && READ_ONCE(mboot_text_console_active)) {
+			const char end[] = "BOOT TEXT END\n";
+
+			WRITE_ONCE(mboot_text_console_active, false);
+			mboot_console_write_buffer(end, sizeof(end) - 1, 0);
+		}
+		mod_delayed_work(system_wq, &mboot_ready_work, 0);
+	}
+	return NOTIFY_OK;
+}
+
+static struct notifier_block mboot_fb_notifier = {
+	.notifier_call = mboot_fb_event,
+};
+
+static int __init mboot_report_ready(void)
+{
+	int error;
+
+	if (!mboot_arch_present())
+		return 0;
+
+	mboot_boot_status("DISPLAY\nMDRIVER DEVICES");
+	if (mboot_query_and_claim_devices())
+		return -EIO;
+	mboot_boot_status("DISPLAY\nMDRIVER PCI");
+	error = mboot_pci_device_count ? mboot_pci_publish_frontend() : 0;
+	if (error)
+		return error;
+	if (mboot_mmio_check) {
+		mboot_check_gpu_mmio();
+		/* Deliberate diagnostic stop: no GPU publication or release endpoint. */
+		return 0;
+	}
+	if (fb_register_client(&mboot_fb_notifier))
+		return -EIO;
+	if (atomic_read(&mboot_gpu_probe_gate) == 1) {
+		int error = sysfs_create_file(kernel_kobj, &mboot_gpu_probe_start_attr.attr);
+
+		if (error)
+			pr_warn("mDriver: optional GPU probe status endpoint: %d\n", error);
+		mboot_boot_status("DISPLAY\nMDRIVER PCI PUBLISHED\nSTARTING GPU PROBE\nLOG RECEIVER OPTIONAL");
+		/* Drivers are registered. Network readiness must not gate the GPU. */
+		atomic_set(&mboot_gpu_probe_gate, 2);
+		if (!mboot_text_console)
+			unregister_console(&mboot_log_console);
+		pr_info("mDriver: starting first GPU probe without log receiver ACK\n");
+	}
+	/* Run after late init returns so a GPU probe cannot block initcalls. */
+	mod_delayed_work(system_wq, &mboot_ready_work, msecs_to_jiffies(100));
+	return 0;
+}
+late_initcall(mboot_report_ready);
+
+static int __init mboot_report_initcalls_done(void)
+{
+	if (!mboot_arch_present())
+		return 0;
+	if (atomic_read(&mboot_gpu_probe_gate) == 1)
+		mboot_boot_status("DISPLAY\nMDRIVER INITCALLS DONE\nWAIT LOG RECEIVER ACK\nGPU PROBE NOT STARTED");
+	return 0;
+}
+late_initcall_sync(mboot_report_initcalls_done);
+
+
+
+
+void __init mboot_early_console(void)
+{
+	if (atomic_read(&mboot_gpu_probe_gate) == 1) {
+		register_console(&mboot_log_console);
+		pr_info("mDriver: early hypercall log console active; GPU probe held\n");
+	}
+}
+
+static int __init mboot_backend_early(void)
+{
+    if (IS_ENABLED(CONFIG_ARM64) && mboot_arch_present())
+        mboot_early_console();
+    return 0;
+}
+early_initcall(mboot_backend_early);
+
+static int __init mboot_irq_alloc(struct mboot_pci_frontend *device,
+                                unsigned int count)
+{
+    return mboot_arch_irq_alloc(device->info.requester, count, device);
+}
