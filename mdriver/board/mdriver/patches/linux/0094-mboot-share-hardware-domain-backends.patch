+static bool mboot_display_backend_ready(void)
+{
+	unsigned int index;
+	bool display_present = false;
+	bool driver_bound = false;
+	bool driver_matched = false;
+
+	for (index = 0; index < mboot_pci_device_count; index++) {
+		const struct mboot_pci_frontend *device =
+			&mboot_pci_devices[index];
+
+		if (mboot_control_device_kind(&device->info) !=
+		    MBOOT_DEVICE_KIND_DISPLAY)
+			continue;
+		display_present = true;
+		driver_matched = device->driver_matched;
+		driver_bound = device->driver_bound;
+		pr_info("mDriver: display matched=%u, bound=%u\n",
+			driver_matched, driver_bound);
+		if (driver_bound)
+			break;
+	}
+	if (!display_present)
+		return true;
+	if (!driver_bound)
+		return false;
+
+	if (num_registered_fb && registered_fb[0] &&
+	    registered_fb[0]->var.bits_per_pixel == 32 &&
+	    registered_fb[0]->fbops && registered_fb[0]->fbops->fb_imageblit)
+		return READ_ONCE(mboot_gpu_open);
+	return false;
+}
+
+static u64 mboot_control_device_kind(const struct mboot_pci_device_info *info)
+{
+	switch (info->class) {
+	case PCI_BASE_CLASS_STORAGE:
+		return MBOOT_DEVICE_KIND_BLOCK;
+	case PCI_BASE_CLASS_NETWORK:
+		return MBOOT_DEVICE_KIND_NETWORK;
+	case PCI_BASE_CLASS_DISPLAY:
+		return MBOOT_DEVICE_KIND_DISPLAY;
+	case PCI_BASE_CLASS_MULTIMEDIA:
+		return MBOOT_DEVICE_KIND_SOUND;
+	case PCI_BASE_CLASS_SERIAL:
+		return info->subclass == (PCI_CLASS_SERIAL_USB & 0xff) ?
+			MBOOT_DEVICE_KIND_USB : MBOOT_DEVICE_KIND_OTHER;
+	default:
+		return MBOOT_DEVICE_KIND_OTHER;
+	}
+}
+
+static u64 mboot_control_device_features(const struct mboot_pci_device_info *info)
+{
+	u64 features = MBOOT_DEVICE_FEATURES_BASE;
+
+	if (info->flags & MBOOT_PCI_FLAG_EPHEMERAL)
+		features |= MBOOT_DEVICE_FEATURE_EPHEMERAL;
+	if (info->flags & MBOOT_PCI_FLAG_READ_ONLY)
+		features |= MBOOT_DEVICE_FEATURE_READ_ONLY;
+	if (info->flags & MBOOT_PCI_FLAG_PARTITIONED)
+		features |= MBOOT_DEVICE_FEATURE_PARTITIONED;
+	if (mboot_control_device_kind(info) == MBOOT_DEVICE_KIND_BLOCK)
+		features |= MBOOT_DEVICE_FEATURE_BLOCK_READ |
+			    MBOOT_DEVICE_FEATURE_BLOCK_ASYNC_QUEUE;
+	if (mboot_control_device_kind(info) == MBOOT_DEVICE_KIND_BLOCK &&
+	    !(info->flags & MBOOT_PCI_FLAG_READ_ONLY))
+		features |= MBOOT_DEVICE_FEATURE_BLOCK_WRITE |
+			    MBOOT_DEVICE_FEATURE_BLOCK_FLUSH;
+	if (mboot_control_device_kind(info) == MBOOT_DEVICE_KIND_DISPLAY) {
+		features |= MBOOT_DEVICE_FEATURE_DISPLAY_TILE;
+		if (mboot_grant_window_size >= MBOOT_DISPLAY_BULK_MAX_TRANSFER +
+					       MBOOT_DISPLAY_BULK_FIRST_PAGE * PAGE_SIZE)
+			features |= MBOOT_DEVICE_FEATURE_DISPLAY_BULK;
+		if (mboot_grant_window_size >=
+		    (MBOOT_DISPLAY_SURFACE_FIRST_PAGE +
+		     MBOOT_DISPLAY_SURFACE_MIN_PAGE_COUNT) * PAGE_SIZE)
+			features |= MBOOT_DEVICE_FEATURE_DISPLAY_SHARED_SURFACE;
+		if (READ_ONCE(mboot_gpu_open))
+			features |= MBOOT_DEVICE_FEATURE_DISPLAY_GPU_SCENE;
+	}
+	return features;
+}
+
+static void mboot_display_close(void)
+{
+	unsigned int index;
+
+	if (mboot_display_buffer) {
+		memunmap(mboot_display_buffer);
+		mboot_display_buffer = NULL;
+	}
+	if (mboot_display_grant_ref) {
+		mboot_hypercall(MBOOT_HYPERCALL_GRANT_UNMAP,
+				mboot_display_grant_ref, 0, 0);
+		mboot_display_grant_ref = 0;
+	}
+	for (index = 0; index < mboot_display_bulk_count; index++) {
+		mboot_hypercall(MBOOT_HYPERCALL_GRANT_UNMAP,
+				mboot_display_bulk_refs[index], 0, 0);
+		mboot_display_bulk_refs[index] = 0;
+	}
+	mboot_display_bulk_count = 0;
+	mboot_display_buffer_size = 0;
+	mboot_display_buffer_phys = 0;
+	mboot_display_shared_surface = false;
+	mboot_display_device_id = 0;
+	mboot_display_info = NULL;
+}
+
+static int mboot_display_register(u32 device_id, u64 index,
+				  unsigned long grant_ref)
+{
+	const struct mboot_pci_frontend *device;
+	unsigned long result;
+	u64 address;
+
+	if (!device_id || device_id > mboot_pci_device_count ||
+	    index != mboot_display_bulk_count ||
+	    index >= MBOOT_DISPLAY_BULK_PAGE_COUNT || !grant_ref ||
+	    mboot_grant_window_size < MBOOT_DISPLAY_BULK_MAX_TRANSFER +
+				      MBOOT_DISPLAY_BULK_FIRST_PAGE * PAGE_SIZE ||
+	    mboot_display_buffer || mboot_display_device_id)
+		return -EINVAL;
+	device = &mboot_pci_devices[device_id - 1];
+	if (mboot_control_device_kind(&device->info) != MBOOT_DEVICE_KIND_DISPLAY)
+		return -ENODEV;
+	address = mboot_grant_window_start +
+		(MBOOT_DISPLAY_BULK_FIRST_PAGE + index) * PAGE_SIZE;
+	result = mboot_hypercall(MBOOT_HYPERCALL_GRANT_MAP, grant_ref, address, 0);
+	if (result)
+		return -EINVAL;
+	mboot_display_bulk_refs[index] = grant_ref;
+	mboot_display_bulk_count++;
+	return 0;
+}
+
+static int mboot_display_open(u32 device_id, unsigned long grant_ref,
+			      u64 page_count, u64 max_transfer, u64 mode)
+{
+	const struct mboot_pci_frontend *device;
+	unsigned long result;
+	u64 address;
+	u64 surface_bytes;
+
+	bool shared = mode == MBOOT_DISPLAY_OPEN_SHARED_SURFACE;
+	bool bulk = !grant_ref;
+
+	if (!device_id || device_id > mboot_pci_device_count ||
+	    mboot_display_buffer || mboot_display_grant_ref)
+		return -EINVAL;
+	device = &mboot_pci_devices[device_id - 1];
+	if (mboot_control_device_kind(&device->info) != MBOOT_DEVICE_KIND_DISPLAY)
+		return -ENODEV;
+	if (!num_registered_fb || !registered_fb[0] ||
+	    registered_fb[0]->var.bits_per_pixel != 32 ||
+	    !registered_fb[0]->fbops || !registered_fb[0]->fbops->fb_imageblit)
+		return -EAGAIN;
+	if (shared) {
+		if (!grant_ref || page_count < MBOOT_DISPLAY_SURFACE_MIN_PAGE_COUNT ||
+		    page_count > U32_MAX ||
+		    mboot_grant_window_size <
+			MBOOT_DISPLAY_SURFACE_FIRST_PAGE * PAGE_SIZE ||
+		    check_mul_overflow(page_count, (u64)PAGE_SIZE,
+				       &surface_bytes) ||
+		    max_transfer != surface_bytes ||
+		    surface_bytes > mboot_grant_window_size -
+				   MBOOT_DISPLAY_SURFACE_FIRST_PAGE * PAGE_SIZE)
+			return -EINVAL;
+		if ((u64)registered_fb[0]->fix.line_length *
+		    registered_fb[0]->var.yres > surface_bytes)
+			return -ENOSPC;
+		address = mboot_grant_window_start +
+			MBOOT_DISPLAY_SURFACE_FIRST_PAGE * PAGE_SIZE;
+		result = mboot_hypercall(MBOOT_HYPERCALL_GRANT_MAP,
+					 grant_ref, address, 0);
+		if (result)
+			return -EINVAL;
+		mboot_display_grant_ref = grant_ref;
+		mboot_display_buffer_size = surface_bytes;
+		mboot_display_shared_surface = true;
+	} else if (bulk) {
+		if (page_count != MBOOT_DISPLAY_BULK_PAGE_COUNT ||
+		    max_transfer != MBOOT_DISPLAY_BULK_MAX_TRANSFER ||
+		    mboot_display_bulk_count != MBOOT_DISPLAY_BULK_PAGE_COUNT)
+			return -EINVAL;
+		address = mboot_grant_window_start +
+			MBOOT_DISPLAY_BULK_FIRST_PAGE * PAGE_SIZE;
+		mboot_display_buffer_size = MBOOT_DISPLAY_BULK_MAX_TRANSFER;
+	} else {
+		if (page_count || max_transfer || mboot_display_bulk_count)
+			return -EINVAL;
+		address = mboot_grant_window_start +
+			MBOOT_DISPLAY_BUFFER_PAGE * PAGE_SIZE;
+		result = mboot_hypercall(MBOOT_HYPERCALL_GRANT_MAP,
+					 grant_ref, address, 0);
+		if (result)
+			return -EINVAL;
+		mboot_display_grant_ref = grant_ref;
+		mboot_display_buffer_size = MBOOT_DISPLAY_MAX_TRANSFER;
+	}
+	mboot_display_buffer = memremap(address, mboot_display_buffer_size,
+					MEMREMAP_WB);
+	if (!mboot_display_buffer) {
+		mboot_display_close();
+		return -EIO;
+	}
+	mboot_display_buffer_phys = address;
+	mboot_display_device_id = device_id;
+	mboot_display_info = registered_fb[0];
+	return 0;
+}
+
+static int mboot_display_present(const struct mboot_control_request *request)
+{
+	struct fb_info *info = mboot_display_info;
+	struct fb_image image = { };
+	u64 pixels;
+	u64 bytes;
+
+	if (!info || !mboot_display_buffer ||
+	    request->device_id != mboot_display_device_id ||
+	    !request->arguments[2] || !request->arguments[3] ||
+	    request->arguments[0] > U32_MAX || request->arguments[1] > U32_MAX ||
+	    request->arguments[2] > U32_MAX || request->arguments[3] > U32_MAX ||
+	    check_mul_overflow(request->arguments[2], request->arguments[3], &pixels) ||
+	    check_mul_overflow(pixels, (u64)MBOOT_DISPLAY_PIXEL_BYTES, &bytes) ||
+	    bytes > mboot_display_buffer_size ||
+	    request->arguments[0] + request->arguments[2] > info->var.xres ||
+	    request->arguments[1] + request->arguments[3] > info->var.yres)
+		return -EINVAL;
+	image.dx = request->arguments[0];
+	image.dy = request->arguments[1];
+	image.width = request->arguments[2];
+	image.height = request->arguments[3];
+	image.depth = info->var.bits_per_pixel;
+	lock_fb_info(info);
+	if (info->state != FBINFO_STATE_RUNNING || !info->fbops->fb_imageblit) {
+		unlock_fb_info(info);
+		return -EIO;
+	}
+	if (mboot_display_shared_surface &&
+	    info->fix.line_length ==
+		(u64)info->var.xres * MBOOT_DISPLAY_PIXEL_BYTES) {
+		/*
+		 * The shared surface already contains the complete scanlines.  Expand
+		 * horizontal damage and submit the affected rows in one operation;
+		 * calling fb_imageblit once per row dominates desktop rendering time.
+		 */
+		image.dx = 0;
+		image.width = info->var.xres;
+		image.data = mboot_display_buffer +
+			(image.dy * info->fix.line_length);
+		info->fbops->fb_imageblit(info, &image);
+	} else if (mboot_display_shared_surface) {
+		/* A padded framebuffer pitch cannot be represented by fb_image. */
+		image.height = 1;
+		for (u32 row = 0; row < request->arguments[3]; row++) {
+			image.dy = request->arguments[1] + row;
+			image.data = mboot_display_buffer +
+				(image.dy * info->fix.line_length) +
+				(request->arguments[0] * MBOOT_DISPLAY_PIXEL_BYTES);
+			info->fbops->fb_imageblit(info, &image);
+		}
+	} else {
+		image.data = mboot_display_shared_surface ?
+			mboot_display_buffer +
+			(request->arguments[1] * info->fix.line_length) :
+			mboot_display_buffer;
+		info->fbops->fb_imageblit(info, &image);
+	}
+	if (info->fbops->fb_sync)
+		info->fbops->fb_sync(info);
+	unlock_fb_info(info);
+	return 0;
+}
+
+static int mboot_gpu_submit(const struct mboot_control_request *request)
+{
+	long waited;
+	int status;
+
+	if (!mboot_display_shared_surface || !mboot_display_buffer ||
+	    request->device_id != mboot_display_device_id ||
+	    !request->arguments[0] ||
+	    request->arguments[0] > mboot_display_buffer_size ||
+	    request->arguments[1] || request->arguments[2] || request->arguments[3])
+		return -EINVAL;
+	waited = wait_event_interruptible_timeout(mboot_gpu_request_wait,
+		READ_ONCE(mboot_gpu_open), msecs_to_jiffies(5000));
+	if (waited <= 0)
+		return waited ? waited : -ETIMEDOUT;
+	mutex_lock(&mboot_gpu_lock);
+	if (!mboot_gpu_open || mboot_gpu_pending) {
+		mutex_unlock(&mboot_gpu_lock);
+		return -ENODEV;
+	}
+	mboot_gpu_generation++;
+	if (!mboot_gpu_generation)
+		mboot_gpu_generation++;
+	mboot_gpu_scene_length = request->arguments[0];
+	mboot_gpu_response_status = -EIO;
+	mboot_gpu_pending = true;
+	mboot_gpu_delivered = false;
+	mboot_gpu_responded = false;
+	wake_up_interruptible(&mboot_gpu_request_wait);
+	mutex_unlock(&mboot_gpu_lock);
+
+	waited = wait_event_interruptible_timeout(mboot_gpu_response_wait,
+		READ_ONCE(mboot_gpu_responded), msecs_to_jiffies(5000));
+	mutex_lock(&mboot_gpu_lock);
+	status = waited > 0 && mboot_gpu_responded ?
+		mboot_gpu_response_status : -ETIMEDOUT;
+	mboot_gpu_pending = false;
+	mboot_gpu_delivered = false;
+	mboot_gpu_responded = false;
+	mutex_unlock(&mboot_gpu_lock);
+	return status;
+}
+
+static u32 mboot_gpu_diagnostic_component(u8 value,
+					 const struct fb_bitfield *field)
+{
+	u64 maximum;
+
+	if (!field->length || field->offset >= 32)
+		return 0;
+	maximum = field->length >= 32 ? U32_MAX : BIT_ULL(field->length) - 1;
+	return (u32)(((u64)value * maximum / 255) << field->offset);
+}
+
+static u32 mboot_gpu_diagnostic_color(const struct fb_var_screeninfo *var,
+				      u8 red, u8 green, u8 blue)
+{
+	return mboot_gpu_diagnostic_component(red, &var->red) |
+		mboot_gpu_diagnostic_component(green, &var->green) |
+		mboot_gpu_diagnostic_component(blue, &var->blue);
+}
+
+static void mboot_gpu_diagnostic_draw(void)
+{
+	static const char message[] = "MDRIVER GPU PROCESS 10";
+	const struct font_desc *font = find_font("VGA8x16");
+	struct fb_info *info;
+	struct fb_image image = { };
+	u32 background;
+	u32 foreground;
+	u32 *pixels;
+	u32 width;
+	u32 height;
+	u32 scale = 2;
+	u32 text_width;
+	u32 text_height;
+	u32 text_x;
+	u32 text_y;
+	size_t index;
+
+	if (!num_registered_fb || !registered_fb[0])
+		return;
+	info = registered_fb[0];
+	if (info->var.bits_per_pixel != 32 || !info->fbops ||
+	    !info->fbops->fb_imageblit)
+		return;
+	width = min_t(u32, info->var.xres, 640);
+	height = min_t(u32, info->var.yres, 160);
+	if (!width || !height)
+		return;
+	pixels = kvmalloc_array((size_t)width * height, sizeof(*pixels),
+				 GFP_KERNEL | __GFP_ZERO);
+	if (!pixels)
+		return;
+	background = mboot_gpu_diagnostic_color(&info->var, 176, 24, 40);
+	foreground = mboot_gpu_diagnostic_color(&info->var, 255, 255, 255);
+	for (index = 0; index < (size_t)width * height; index++)
+		pixels[index] = background;
+
+	if (font && font->width <= 8) {
+		text_width = (sizeof(message) - 1) * font->width * scale;
+		text_height = font->height * scale;
+		if (text_width > width || text_height > height) {
+			scale = 1;
+			text_width = (sizeof(message) - 1) * font->width;
+			text_height = font->height;
+		}
+		text_x = width > text_width ? (width - text_width) / 2 : 0;
+		text_y = height > text_height ? (height - text_height) / 2 : 0;
+		for (index = 0; index < sizeof(message) - 1; index++) {
+			const u8 *glyph = font->data +
+				((u8)message[index] * font->height);
+			u32 row;
+
+			for (row = 0; row < font->height; row++) {
+				u32 column;
+
+				for (column = 0; column < font->width; column++) {
+					u32 sx;
+					u32 sy;
+
+					if (!(glyph[row] & BIT(7 - column)))
+						continue;
+					for (sy = 0; sy < scale; sy++)
+						for (sx = 0; sx < scale; sx++) {
+							u32 x = text_x +
+								index * font->width * scale +
+								column * scale + sx;
+							u32 y = text_y + row * scale + sy;
+
+							if (x < width && y < height)
+								pixels[(size_t)y * width + x] =
+									foreground;
+						}
+				}
+			}
+		}
+	}
+
+	image.dx = (info->var.xres - width) / 2;
+	image.dy = (info->var.yres - height) / 2;
+	image.width = width;
+	image.height = height;
+	image.depth = 32;
+	image.data = (u8 *)pixels;
+	lock_fb_info(info);
+	if (info->state == FBINFO_STATE_RUNNING && info->fbops->fb_imageblit) {
+		info->fbops->fb_imageblit(info, &image);
+		if (info->fbops->fb_sync)
+			info->fbops->fb_sync(info);
+	}
+	unlock_fb_info(info);
+	kvfree(pixels);
+}
+
+static void mboot_gpu_watchdog_workfn(struct work_struct *work)
+{
+	if (!READ_ONCE(mboot_gpu_open)) {
+		pr_err("mDriver: GPU renderer did not become ready\n");
+		mboot_gpu_diagnostic_draw();
+	}
+}
+
+static DECLARE_DELAYED_WORK(mboot_gpu_watchdog_work,
+				    mboot_gpu_watchdog_workfn);
+
+static int mboot_gpu_open_device(struct inode *inode, struct file *file)
+{
+	mutex_lock(&mboot_gpu_lock);
+	if (mboot_gpu_open) {
+		mutex_unlock(&mboot_gpu_lock);
+		return -EBUSY;
+	}
+	mboot_gpu_open = true;
+	wake_up_interruptible(&mboot_gpu_request_wait);
+	mutex_unlock(&mboot_gpu_lock);
+	cancel_delayed_work(&mboot_gpu_watchdog_work);
+	return 0;
+}
+
+static int mboot_gpu_release_device(struct inode *inode, struct file *file)
+{
+	mutex_lock(&mboot_gpu_lock);
+	mboot_gpu_open = false;
+	if (mboot_gpu_pending) {
+		mboot_gpu_response_status = -ENODEV;
+		mboot_gpu_responded = true;
+		wake_up_interruptible(&mboot_gpu_response_wait);
+	}
+	mutex_unlock(&mboot_gpu_lock);
+	return 0;
+}
+
+static ssize_t mboot_gpu_read(struct file *file, char __user *buffer,
+			      size_t length, loff_t *offset)
+{
+	struct mboot_gpu_request request;
+	int result;
+
+	if (length < sizeof(request))
+		return -EINVAL;
+	result = wait_event_interruptible(mboot_gpu_request_wait,
+		READ_ONCE(mboot_gpu_pending) && !READ_ONCE(mboot_gpu_delivered));
+	if (result)
+		return result;
+	mutex_lock(&mboot_gpu_lock);
+	if (!mboot_gpu_pending || mboot_gpu_delivered) {
+		mutex_unlock(&mboot_gpu_lock);
+		return -EAGAIN;
+	}
+	request.generation = mboot_gpu_generation;
+	request.buffer_size = mboot_display_buffer_size;
+	request.scene_length = mboot_gpu_scene_length;
+	request.reserved = 0;
+	mboot_gpu_delivered = true;
+	mutex_unlock(&mboot_gpu_lock);
+	if (copy_to_user(buffer, &request, sizeof(request)))
+		return -EFAULT;
+	return sizeof(request);
+}
+
+static ssize_t mboot_gpu_write(struct file *file, const char __user *buffer,
+			       size_t length, loff_t *offset)
+{
+	struct mboot_gpu_response response;
+
+	if (length != sizeof(response) || copy_from_user(&response, buffer, sizeof(response)))
+		return length == sizeof(response) ? -EFAULT : -EINVAL;
+	mutex_lock(&mboot_gpu_lock);
+	if (!mboot_gpu_pending || !mboot_gpu_delivered || mboot_gpu_responded ||
+	    response.generation != mboot_gpu_generation || response.reserved) {
+		mutex_unlock(&mboot_gpu_lock);
+		return -EINVAL;
+	}
+	mboot_gpu_response_status = response.status;
+	mboot_gpu_responded = true;
+	wake_up_interruptible(&mboot_gpu_response_wait);
+	mutex_unlock(&mboot_gpu_lock);
+	return sizeof(response);
+}
+
+static int mboot_gpu_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	unsigned long size = vma->vm_end - vma->vm_start;
+
+	if (!mboot_display_buffer_phys || !mboot_display_buffer_size ||
+	    vma->vm_pgoff || size > PAGE_ALIGN(mboot_display_buffer_size))
+		return -ENODEV;
+	return remap_pfn_range(vma, vma->vm_start,
+		mboot_display_buffer_phys >> PAGE_SHIFT, size, vma->vm_page_prot);
+}
+
+static const struct file_operations mboot_gpu_fops = {
+	.owner = THIS_MODULE,
+	.open = mboot_gpu_open_device,
+	.release = mboot_gpu_release_device,
+	.read = mboot_gpu_read,
+	.write = mboot_gpu_write,
+	.mmap = mboot_gpu_mmap,
+	.llseek = noop_llseek,
+};
+
+static struct miscdevice mboot_gpu_device = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = "mboot-gpu",
+	.fops = &mboot_gpu_fops,
+	.mode = 0600,
+};
+
+static bool mboot_device_descends_from(struct device *device,
+				       const struct device *ancestor)
+{
+	for (; device; device = device->parent)
+		if (device == ancestor)
+			return true;
+	return false;
+}
+
+static u32 mboot_gpt_crc32(const void *buffer, size_t length)
+{
+	return crc32_le(~0U, buffer, length) ^ ~0U;
+}
+
+static int mboot_block_read_exact(struct file *file, u64 offset,
+				  void *buffer, size_t length)
+{
+	loff_t position;
+
+	if (offset > LLONG_MAX || length > LLONG_MAX - offset)
+		return -ERANGE;
+	position = offset;
+	return kernel_read(file, buffer, length, &position) == (ssize_t)length ? 0 : -EIO;
+}
+
+static int mboot_block_write_exact(struct file *file, u64 offset,
+				   const void *buffer, size_t length)
+{
+	loff_t position;
+
+	if (offset > LLONG_MAX || length > LLONG_MAX - offset)
+		return -ERANGE;
+	position = offset;
+	return kernel_write(file, buffer, length, &position) == (ssize_t)length ? 0 : -EIO;
+}
+
+static bool mboot_gpt_guid_zero(const u8 guid[16])
+{
+	return !memchr_inv(guid, 0, 16);
+}
+
+static int mboot_gpt_validate_pmbr(struct file *file, u64 total_lbas,
+				   u32 logical_block_size)
+{
+	u8 mbr[512];
+	u32 expected_size;
+	unsigned int protective = 0;
+	unsigned int index;
+
+	if (logical_block_size < sizeof(mbr) ||
+	    mboot_block_read_exact(file, 0, mbr, sizeof(mbr)) ||
+	    get_unaligned_le16(mbr + 510) != 0xaa55)
+		return -EINVAL;
+	for (index = 0; index < 4; index++) {
+		const u8 *entry = mbr + 446 + index * 16;
+
+		if (entry[4] == 0) {
+			if (memchr_inv(entry, 0, 16))
+				return -EINVAL;
+			continue;
+		}
+		if (entry[0] != 0 || entry[4] != 0xee ||
+		    get_unaligned_le32(entry + 8) != 1)
+			return -EINVAL;
+		protective++;
+		expected_size = total_lbas - 1 > U32_MAX ? U32_MAX : total_lbas - 1;
+		if (get_unaligned_le32(entry + 12) != expected_size)
+			return -EINVAL;
+	}
+	return protective == 1 ? 0 : -EINVAL;
+}
+
+static void mboot_gpt_copy_free(struct mboot_gpt_copy *copy)
+{
+	kvfree(copy->entries);
+	memset(copy, 0, sizeof(*copy));
+}
+
+static int mboot_gpt_read_copy(struct file *file, u64 header_lba,
+			       u64 other_header_lba, u64 total_lbas,
+			       u32 logical_block_size,
+			       const u8 expected_disk_guid[16],
+			       struct mboot_gpt_copy *copy)
+{
+	struct mboot_gpt_header *header;
+	u64 entries_lba;
+	u64 entries_lbas;
+	u64 entries_end;
+	u64 entries_offset;
+	u64 entries_size64;
+	u32 header_size;
+	u32 header_crc;
+	u32 entry_count;
+	u32 entry_size;
+	u8 *sector;
+	int result = -EINVAL;
+
+	memset(copy, 0, sizeof(*copy));
+	sector = kmalloc(logical_block_size, GFP_KERNEL);
+	if (!sector)
+		return -ENOMEM;
+	if (check_mul_overflow(header_lba, (u64)logical_block_size,
+			       &entries_offset) ||
+	    mboot_block_read_exact(file, entries_offset, sector,
+				   logical_block_size)) {
+		result = -EIO;
+		goto out;
+	}
+	header = (struct mboot_gpt_header *)sector;
+	header_size = le32_to_cpu(header->header_size);
+	if (le64_to_cpu(header->signature) != MBOOT_GPT_SIGNATURE ||
+	    le32_to_cpu(header->revision) != MBOOT_GPT_REVISION ||
+	    header_size < MBOOT_GPT_HEADER_MIN_SIZE ||
+	    header_size > logical_block_size || le32_to_cpu(header->reserved) ||
+	    le64_to_cpu(header->current_lba) != header_lba ||
+	    le64_to_cpu(header->backup_lba) != other_header_lba ||
+	    le64_to_cpu(header->first_usable_lba) >
+		le64_to_cpu(header->last_usable_lba) ||
+	    le64_to_cpu(header->first_usable_lba) < 2 ||
+	    le64_to_cpu(header->last_usable_lba) >= total_lbas ||
+	    (expected_disk_guid &&
+	     memcmp(header->disk_guid, expected_disk_guid, 16)))
+		goto out;
+	header_crc = le32_to_cpu(header->header_crc32);
+	header->header_crc32 = 0;
+	if (mboot_gpt_crc32(sector, header_size) != header_crc)
+		goto out;
+	header->header_crc32 = cpu_to_le32(header_crc);
+	entry_count = le32_to_cpu(header->partition_entry_count);
+	entry_size = le32_to_cpu(header->partition_entry_size);
+	if (!entry_count || entry_count > MBOOT_GPT_MAX_ENTRIES ||
+	    entry_size < MBOOT_GPT_ENTRY_MIN_SIZE || entry_size & 7 ||
+	    check_mul_overflow((u64)entry_count, (u64)entry_size,
+			       &entries_size64) ||
+	    !entries_size64 || entries_size64 > MBOOT_GPT_MAX_ENTRY_BYTES)
+		goto out;
+	entries_lba = le64_to_cpu(header->partition_entry_lba);
+	entries_lbas = DIV_ROUND_UP_ULL(entries_size64, logical_block_size);
+	if (check_add_overflow(entries_lba, entries_lbas, &entries_end) ||
+	    entries_lba >= total_lbas || entries_end > total_lbas)
+		goto out;
+	if (header_lba == 1) {
+		if (entries_lba <= header_lba ||
+		    entries_end > le64_to_cpu(header->first_usable_lba))
+			goto out;
+	} else if (entries_lba <= le64_to_cpu(header->last_usable_lba) ||
+		   entries_end > header_lba) {
+		goto out;
+	}
+	copy->entries = kvmalloc(entries_size64, GFP_KERNEL);
+	if (!copy->entries) {
+		result = -ENOMEM;
+		goto out;
+	}
+	if (check_mul_overflow(entries_lba, (u64)logical_block_size,
+			       &entries_offset) ||
+	    mboot_block_read_exact(file, entries_offset, copy->entries,
+				   entries_size64)) {
+		result = -EIO;
+		goto fail;
+	}
+	if (mboot_gpt_crc32(copy->entries, entries_size64) !=
+	    le32_to_cpu(header->partition_entry_crc32))
+		goto fail;
+	copy->header = *header;
+	copy->entries_size = entries_size64;
+	result = 0;
+	goto out;
+
+fail:
+	mboot_gpt_copy_free(copy);
+out:
+	kfree(sector);
+	return result;
+}
+
+static int mboot_gpt_select_partition(const struct mboot_gpt_copy *copy,
+				      const u8 expected_type_guid[16],
+				      const u8 expected_partition_guid[16],
+				      u64 *first_lba, u64 *last_lba)
+{
+	u64 usable_first = le64_to_cpu(copy->header.first_usable_lba);
+	u64 usable_last = le64_to_cpu(copy->header.last_usable_lba);
+	u32 count = le32_to_cpu(copy->header.partition_entry_count);
+	u32 size = le32_to_cpu(copy->header.partition_entry_size);
+	unsigned int matches = 0;
+	unsigned int index;
+
+	for (index = 0; index < count; index++) {
+		const u8 *entry = copy->entries + (size_t)index * size;
+		u64 first;
+		u64 last;
+		unsigned int previous;
+
+		if (mboot_gpt_guid_zero(entry))
+			continue;
+		first = get_unaligned_le64(entry + 32);
+		last = get_unaligned_le64(entry + 40);
+		if (mboot_gpt_guid_zero(entry + 16) || first > last ||
+		    first < usable_first || last > usable_last)
+			return -EINVAL;
+		for (previous = 0; previous < index; previous++) {
+			const u8 *other = copy->entries + (size_t)previous * size;
+			u64 other_first;
+			u64 other_last;
+
+			if (mboot_gpt_guid_zero(other))
+				continue;
+			if (!memcmp(entry + 16, other + 16, 16))
+				return -EINVAL;
+			other_first = get_unaligned_le64(other + 32);
+			other_last = get_unaligned_le64(other + 40);
+			if (first <= other_last && other_first <= last)
+				return -EINVAL;
+		}
+		if (!memcmp(entry, expected_type_guid, 16) &&
+		    !memcmp(entry + 16, expected_partition_guid, 16)) {
+			*first_lba = first;
+			*last_lba = last;
+			matches++;
+		}
+	}
+	return matches == 1 ? 0 : -EINVAL;
+}
+
+static bool mboot_gpt_copies_match(const struct mboot_gpt_copy *primary,
+				    const struct mboot_gpt_copy *backup)
+{
+	return primary->entries_size == backup->entries_size &&
+	       !memcmp(primary->entries, backup->entries, primary->entries_size) &&
+	       primary->header.first_usable_lba == backup->header.first_usable_lba &&
+	       primary->header.last_usable_lba == backup->header.last_usable_lba &&
+	       primary->header.partition_entry_count == backup->header.partition_entry_count &&
+	       primary->header.partition_entry_size == backup->header.partition_entry_size &&
+	       primary->header.partition_entry_crc32 == backup->header.partition_entry_crc32 &&
+	       !memcmp(primary->header.disk_guid, backup->header.disk_guid, 16);
+}
+
+static int mboot_gpt_partition_at(const struct mboot_gpt_copy *copy,
+				  u32 ordinal, const u8 **selected,
+				  u32 *selected_slot)
+{
+	u64 usable_first = le64_to_cpu(copy->header.first_usable_lba);
+	u64 usable_last = le64_to_cpu(copy->header.last_usable_lba);
+	u32 count = le32_to_cpu(copy->header.partition_entry_count);
+	u32 size = le32_to_cpu(copy->header.partition_entry_size);
+	u32 used = 0;
+	unsigned int index;
+
+	*selected = NULL;
+	for (index = 0; index < count; index++) {
+		const u8 *entry = copy->entries + (size_t)index * size;
+		u64 first;
+		u64 last;
+		unsigned int previous;
+
+		if (mboot_gpt_guid_zero(entry))
+			continue;
+		first = get_unaligned_le64(entry + 32);
+		last = get_unaligned_le64(entry + 40);
+		if (mboot_gpt_guid_zero(entry + 16) || first > last ||
+		    first < usable_first || last > usable_last)
+			return -EINVAL;
+		for (previous = 0; previous < index; previous++) {
+			const u8 *other = copy->entries + (size_t)previous * size;
+			u64 other_first;
+			u64 other_last;
+
+			if (mboot_gpt_guid_zero(other))
+				continue;
+			if (!memcmp(entry + 16, other + 16, 16))
+				return -EINVAL;
+			other_first = get_unaligned_le64(other + 32);
+			other_last = get_unaligned_le64(other + 40);
+			if (first <= other_last && other_first <= last)
+				return -EINVAL;
+		}
+		if (used++ == ordinal) {
+			*selected = entry;
+			*selected_slot = index;
+		}
+	}
+	return *selected ? 0 : -ENOENT;
+}
+
+static int mboot_gpt_partition_window(struct file *file,
+				      const struct mboot_pci_device_info *info,
+				      u64 *first_sector, u64 *sector_count)
+{
+	struct block_device *bdev = file_bdev(file);
+	struct mboot_gpt_copy primary;
+	struct mboot_gpt_copy backup;
+	u32 logical_block_size = bdev_logical_block_size(bdev);
+	u64 total_lbas;
+	u64 first_lba;
+	u64 last_lba;
+	u64 lba_count;
+	u64 sectors_per_lba;
+	int result;
+
+	if (logical_block_size < MBOOT_BLOCK_SECTOR_SIZE ||
+	    logical_block_size > PAGE_SIZE ||
+	    logical_block_size % MBOOT_BLOCK_SECTOR_SIZE)
+		return -EINVAL;
+	total_lbas = div_u64(bdev_nr_bytes(bdev), logical_block_size);
+	if (total_lbas < 6)
+		return -EINVAL;
+	result = mboot_gpt_validate_pmbr(file, total_lbas, logical_block_size);
+	if (result) {
+		pr_err("mDriver: storage policy rejected protective MBR: %d\n", result);
+		return result;
+	}
+	result = mboot_gpt_read_copy(file, 1, total_lbas - 1, total_lbas,
+				     logical_block_size, info->storage_disk_guid,
+				     &primary);
+	if (result) {
+		pr_err("mDriver: storage policy rejected primary GPT: %d\n", result);
+		return result;
+	}
+	result = mboot_gpt_read_copy(file, total_lbas - 1, 1, total_lbas,
+				     logical_block_size, info->storage_disk_guid,
+				     &backup);
+	if (result) {
+		pr_err("mDriver: storage policy rejected backup GPT: %d\n", result);
+		goto out_primary;
+	}
+	if (!mboot_gpt_copies_match(&primary, &backup)) {
+		result = -EINVAL;
+		pr_err("mDriver: storage policy rejected mismatched GPT copies\n");
+		goto out;
+	}
+	result = mboot_gpt_select_partition(&primary,
+				    info->storage_partition_type_guid,
+				    info->storage_partition_guid,
+				    &first_lba, &last_lba);
+	if (result) {
+		pr_err("mDriver: enrolled GPT partition was not uniquely valid: %d\n",
+		       result);
+		goto out;
+	}
+	sectors_per_lba = logical_block_size / MBOOT_BLOCK_SECTOR_SIZE;
+	lba_count = last_lba - first_lba + 1;
+	if (check_mul_overflow(first_lba, sectors_per_lba, first_sector) ||
+	    check_mul_overflow(lba_count, sectors_per_lba, sector_count) ||
+	    !*sector_count || *sector_count > bdev_nr_sectors(bdev) ||
+	    *first_sector > bdev_nr_sectors(bdev) - *sector_count) {
+		result = -ERANGE;
+		goto out;
+	}
+	result = 0;
+out:
+	mboot_gpt_copy_free(&backup);
+out_primary:
+	mboot_gpt_copy_free(&primary);
+	return result;
+}
+
+static int mboot_block_apply_policy(struct file *file,
+				    const struct mboot_pci_device_info *info,
+				    u64 *first_sector, u64 *sector_count)
+{
+	if (info->flags & MBOOT_PCI_FLAG_PARTITIONED)
+		return mboot_gpt_partition_window(file, info, first_sector,
+					  sector_count);
+	*first_sector = 0;
+	*sector_count = bdev_nr_sectors(file_bdev(file));
+	return *sector_count ? 0 : -EINVAL;
+}
+
+static bool mboot_scope_conflicts(struct file *file);
+static bool mboot_scope_active(void);
+static void mboot_scope_close(void);
+
+static struct file *mboot_block_lookup(const struct mboot_pci_device_info *info,
+                                      u64 *selected_first, u64 *selected_count)
+{
+	struct class_dev_iter iterator;
+	struct pci_dev *pdev;
+	struct device *device;
+	struct file *selected = NULL;
+	u8 bus = info->requester >> 8;
+	u8 devfn = info->requester & 0xff;
+
+	pdev = pci_get_domain_bus_and_slot(0, bus, devfn);
+	if (!pdev)
+		return ERR_PTR(-ENODEV);
+	class_dev_iter_init(&iterator, &block_class, NULL, &disk_type);
+	while ((device = class_dev_iter_next(&iterator))) {
+		struct gendisk *disk;
+		struct file *file;
+		u64 first_sector;
+		u64 sector_count;
+
+		if (!mboot_device_descends_from(device, &pdev->dev))
+			continue;
+		disk = dev_to_disk(device);
+		if (!disk_live(disk))
+			continue;
+		if (info->flags & MBOOT_PCI_FLAG_READ_ONLY)
+			set_disk_ro(disk, true);
+		file = bdev_file_open_by_dev(disk_devt(disk),
+					     BLK_OPEN_READ |
+					     (info->flags & MBOOT_PCI_FLAG_READ_ONLY ?
+					      0 : BLK_OPEN_WRITE),
+					     NULL, NULL);
+		if (IS_ERR(file))
+			continue;
+		if (mboot_scope_conflicts(file) ||
+            mboot_block_apply_policy(file, info, &first_sector,
+					     &sector_count)) {
+			fput(file);
+			continue;
+		}
+		if (selected) {
+			fput(file);
+			fput(selected);
+			selected = ERR_PTR(-EEXIST);
+			break;
+		}
+		selected = file;
+		*selected_first = first_sector;
+		*selected_count = sector_count;
+	}
+	class_dev_iter_exit(&iterator);
+	pci_dev_put(pdev);
+	return selected ?: ERR_PTR(-ENODEV);
+}
+
+static struct file *mboot_block_open(const struct mboot_pci_device_info *info)
+{
+    return mboot_block_lookup(info, &mboot_block_first_sector, &mboot_block_sector_count);
+}
+
+static void mboot_block_close(void)
+{
+	if (mboot_block_file) {
+		fput(mboot_block_file);
+		mboot_block_file = NULL;
+	}
+	if (mboot_block_buffer) {
+		memunmap(mboot_block_buffer);
+		mboot_block_buffer = NULL;
+	}
+	if (mboot_block_grant_ref) {
+		mboot_hypercall(MBOOT_HYPERCALL_GRANT_UNMAP,
+				mboot_block_grant_ref, 0, 0);
+		mboot_block_grant_ref = 0;
+	}
+	mboot_block_device_id = 0;
+	mboot_block_first_sector = 0;
+	mboot_block_sector_count = 0;
+}
+
+static int mboot_block_open_grant(u32 device_id, unsigned long grant_ref)
+{
+	const struct mboot_pci_frontend *device;
+	unsigned long result;
+	u64 address;
+
+	if (!device_id || device_id > mboot_pci_device_count ||
+	    mboot_block_file || mboot_block_buffer || mboot_block_grant_ref)
+		return -EINVAL;
+	device = &mboot_pci_devices[device_id - 1];
+	if (mboot_control_device_kind(&device->info) != MBOOT_DEVICE_KIND_BLOCK)
+		return -ENODEV;
+	address = mboot_grant_window_start + MBOOT_BLOCK_DATA_PAGE * PAGE_SIZE;
+	result = mboot_hypercall(MBOOT_HYPERCALL_GRANT_MAP, grant_ref, address, 0);
+	if (result)
+		return -EINVAL;
+	mboot_block_grant_ref = grant_ref;
+	mboot_block_buffer = memremap(address, PAGE_SIZE, MEMREMAP_WB);
+	if (!mboot_block_buffer)
+		goto fail;
+	mboot_block_file = mboot_block_open(&device->info);
+	if (IS_ERR(mboot_block_file)) {
+		mboot_block_file = NULL;
+		goto fail;
+	}
+	mboot_block_device_id = device_id;
+	return 0;
+
+fail:
+	mboot_block_close();
+	return -EIO;
+}
+
+static int mboot_block_request_valid(const struct mboot_control_request *request,
+				     loff_t *position, size_t *length,
+				     size_t *buffer_offset)
+{
+	struct block_device *bdev;
+	u64 byte_position;
+	u64 end_sector;
+	u64 physical_sector;
+	u64 logical_block_size;
+
+	if (!mboot_block_file || request->device_id != mboot_block_device_id ||
+	    request->arguments[3] || !request->arguments[1] ||
+	    request->arguments[1] > MBOOT_BLOCK_MAX_TRANSFER ||
+	    request->arguments[1] > SIZE_MAX || request->arguments[2] > SIZE_MAX)
+		return -EINVAL;
+	*length = request->arguments[1];
+	*buffer_offset = request->arguments[2];
+	if (*buffer_offset > PAGE_SIZE - *length)
+		return -EINVAL;
+	bdev = file_bdev(mboot_block_file);
+	logical_block_size = bdev_logical_block_size(bdev);
+	if (*length % logical_block_size || *buffer_offset % logical_block_size)
+		return -EINVAL;
+	if (check_add_overflow(request->arguments[0],
+			       request->arguments[1] / MBOOT_BLOCK_SECTOR_SIZE,
+			       &end_sector) ||
+	    end_sector > mboot_block_sector_count ||
+	    check_add_overflow(mboot_block_first_sector, request->arguments[0],
+			       &physical_sector) ||
+	    check_mul_overflow(physical_sector, (u64)MBOOT_BLOCK_SECTOR_SIZE,
+			       &byte_position) || byte_position > LLONG_MAX)
+		return -ERANGE;
+	if (byte_position % logical_block_size)
+		return -EINVAL;
+	*position = byte_position;
+	return 0;
+}
+
+static void mboot_block_queue_close(void)
+{
+	unsigned int index;
+
+	mboot_block_queue_active = false;
+	for (index = 0; index < MBOOT_BLOCK_BUFFER_COUNT; index++) {
+		if (mboot_block_buffers[index]) {
+			memunmap(mboot_block_buffers[index]);
+			mboot_block_buffers[index] = NULL;
+		}
+		if (mboot_block_buffer_refs[index]) {
+			mboot_hypercall(MBOOT_HYPERCALL_GRANT_UNMAP,
+					mboot_block_buffer_refs[index], 0, 0);
+			mboot_block_buffer_refs[index] = 0;
+		}
+	}
+	if (mboot_block_ring) {
+		memunmap(mboot_block_ring);
+		mboot_block_ring = NULL;
+	}
+	if (mboot_block_ring_ref) {
+		mboot_hypercall(MBOOT_HYPERCALL_GRANT_UNMAP,
+				mboot_block_ring_ref, 0, 0);
+		mboot_block_ring_ref = 0;
+	}
+	if (mboot_block_file) {
+		fput(mboot_block_file);
+		mboot_block_file = NULL;
+	}
+	mboot_block_device_id = 0;
+	mboot_block_first_sector = 0;
+	mboot_block_sector_count = 0;
+}
+
+static int mboot_block_queue_open(u32 device_id, unsigned long grant_ref)
+{
+	const struct mboot_pci_frontend *device;
+	unsigned long result;
+	u64 address;
+
+	if (!device_id || device_id > mboot_pci_device_count ||
+	    mboot_block_file || mboot_block_ring || mboot_block_ring_ref)
+		return -EINVAL;
+	device = &mboot_pci_devices[device_id - 1];
+	if (mboot_control_device_kind(&device->info) != MBOOT_DEVICE_KIND_BLOCK)
+		return -ENODEV;
+	address = mboot_grant_window_start + MBOOT_BLOCK_RING_PAGE * PAGE_SIZE;
+	result = mboot_hypercall(MBOOT_HYPERCALL_GRANT_MAP, grant_ref, address, 0);
+	if (result)
+		return -EINVAL;
+	mboot_block_ring_ref = grant_ref;
+	mboot_block_ring = memremap(address, PAGE_SIZE, MEMREMAP_WB);
+	if (!mboot_block_ring ||
+	    !mboot_ring_valid(mboot_block_ring, MBOOT_BLOCK_RING_GENERATION))
+		goto fail;
+	mboot_block_file = mboot_block_open(&device->info);
+	if (IS_ERR(mboot_block_file)) {
+		mboot_block_file = NULL;
+		goto fail;
+	}
+	mboot_block_device_id = device_id;
+	return 0;
+
+fail:
+	mboot_block_queue_close();
+	return -EIO;
+}
+
+static int mboot_block_queue_register(unsigned int buffer_id,
+				      unsigned long grant_ref)
+{
+	unsigned long result;
+	u64 address;
+
+	if (!mboot_block_ring || !mboot_block_file || mboot_block_queue_active ||
+	    buffer_id >= MBOOT_BLOCK_BUFFER_COUNT ||
+	    mboot_block_buffers[buffer_id] || mboot_block_buffer_refs[buffer_id])
+		return -EINVAL;
+	address = mboot_grant_window_start +
+		  (MBOOT_BLOCK_BUFFER_FIRST_PAGE + buffer_id) * PAGE_SIZE;
+	result = mboot_hypercall(MBOOT_HYPERCALL_GRANT_MAP, grant_ref, address, 0);
+	if (result)
+		return -EINVAL;
+	mboot_block_buffer_refs[buffer_id] = grant_ref;
+	mboot_block_buffers[buffer_id] = memremap(address, PAGE_SIZE, MEMREMAP_WB);
+	if (!mboot_block_buffers[buffer_id]) {
+		mboot_hypercall(MBOOT_HYPERCALL_GRANT_UNMAP, grant_ref, 0, 0);
+		mboot_block_buffer_refs[buffer_id] = 0;
+		return -EIO;
+	}
+	return 0;
+}
+
+static bool mboot_block_queue_complete(void)
+{
+	unsigned int index;
+
+	for (index = 0; index < MBOOT_BLOCK_BUFFER_COUNT; index++)
+		if (!mboot_block_buffers[index])
+			return false;
+	return true;
+}
+
+static int mboot_block_queue_request_valid(const struct mboot_block_request *request,
+					   loff_t *position, size_t *length,
+					   size_t *buffer_offset)
+{
+	struct block_device *bdev;
+	u64 byte_position;
+	u64 end_sector;
+	u64 physical_sector;
+	u64 logical_block_size;
+
+	if (!mboot_block_queue_active || !mboot_block_file ||
+	    request->device_id != mboot_block_device_id ||
+	    request->buffer_id >= MBOOT_BLOCK_BUFFER_COUNT ||
+	    !mboot_block_buffers[request->buffer_id] || !request->length ||
+	    request->length > MBOOT_BLOCK_MAX_TRANSFER)
+		return -EINVAL;
+	*length = request->length;
+	*buffer_offset = request->buffer_offset;
+	if (*buffer_offset > PAGE_SIZE - *length)
+		return -EINVAL;
+	bdev = file_bdev(mboot_block_file);
+	logical_block_size = bdev_logical_block_size(bdev);
+	if (*length % logical_block_size || *buffer_offset % logical_block_size)
+		return -EINVAL;
+	if (check_add_overflow(request->sector,
+			       request->length / MBOOT_BLOCK_SECTOR_SIZE,
+			       &end_sector) ||
+	    end_sector > mboot_block_sector_count ||
+	    check_add_overflow(mboot_block_first_sector, request->sector,
+			       &physical_sector) ||
+	    check_mul_overflow(physical_sector, (u64)MBOOT_BLOCK_SECTOR_SIZE,
+			       &byte_position) || byte_position > LLONG_MAX)
+		return -ERANGE;
+	if (byte_position % logical_block_size)
+		return -EINVAL;
+	*position = byte_position;
+	return 0;
+}
+
+static bool mboot_control_zero_arguments(const u64 arguments[4])
+{
+	return !memchr_inv(arguments, 0, sizeof(u64) * 4);
+}
+
+static int mboot_storage_inspect(struct file *file, u64 query, u32 ordinal,
+				 u64 values[4])
+{
+	struct block_device *bdev = file_bdev(file);
+	struct mboot_gpt_copy primary;
+	struct mboot_gpt_copy backup;
+	u32 logical_block_size = bdev_logical_block_size(bdev);
+	u64 total_lbas;
+	const u8 *entry;
+	u32 slot = 0;
+	u64 sectors_per_lba;
+	u64 first;
+	u64 count;
+	int result;
+
+	if (logical_block_size < MBOOT_BLOCK_SECTOR_SIZE ||
+	    logical_block_size > PAGE_SIZE ||
+	    logical_block_size % MBOOT_BLOCK_SECTOR_SIZE)
+		return -EINVAL;
+	total_lbas = div_u64(bdev_nr_bytes(bdev), logical_block_size);
+	if (total_lbas < 6)
+		return -EINVAL;
+	result = mboot_gpt_validate_pmbr(file, total_lbas, logical_block_size);
+    if (result && query == MBOOT_STORAGE_QUERY_DISK) {
+        values[0] = values[1] = 0;
+        values[2] = bdev_nr_sectors(bdev);
+        values[3] = logical_block_size;
+        return 0;
+    }
+	if (result)
+		return result;
+	result = mboot_gpt_read_copy(file, 1, total_lbas - 1, total_lbas,
+				     logical_block_size, NULL, &primary);
+	if (result)
+		return result;
+	result = mboot_gpt_read_copy(file, total_lbas - 1, 1, total_lbas,
+				     logical_block_size, NULL, &backup);
+	if (result)
+		goto out_primary;
+	if (!mboot_gpt_copies_match(&primary, &backup)) {
+		result = -EINVAL;
+		goto out;
+	}
+	if (query == MBOOT_STORAGE_QUERY_DISK) {
+		values[0] = get_unaligned_le64(primary.header.disk_guid);
+		values[1] = get_unaligned_le64(primary.header.disk_guid + 8);
+		values[2] = bdev_nr_sectors(bdev);
+		values[3] = logical_block_size;
+		result = 0;
+		goto out;
+	}
+	result = mboot_gpt_partition_at(&primary, ordinal, &entry, &slot);
+	if (result)
+		goto out;
+	if (query == MBOOT_STORAGE_QUERY_PARTITION_GUIDS) {
+		values[0] = get_unaligned_le64(entry);
+		values[1] = get_unaligned_le64(entry + 8);
+		values[2] = get_unaligned_le64(entry + 16);
+		values[3] = get_unaligned_le64(entry + 24);
+		result = 0;
+		goto out;
+	}
+	if (query != MBOOT_STORAGE_QUERY_PARTITION_RANGE) {
+		result = -EINVAL;
+		goto out;
+	}
+	sectors_per_lba = logical_block_size / MBOOT_BLOCK_SECTOR_SIZE;
+	first = get_unaligned_le64(entry + 32);
+	count = get_unaligned_le64(entry + 40) - first + 1;
+	if (check_mul_overflow(first, sectors_per_lba, &values[0]) ||
+	    check_mul_overflow(count, sectors_per_lba, &values[1])) {
+		result = -ERANGE;
+		goto out;
+	}
+	values[2] = get_unaligned_le64(entry + 48);
+	values[3] = slot;
+	result = 0;
+out:
+	mboot_gpt_copy_free(&backup);
+out_primary:
+	mboot_gpt_copy_free(&primary);
+	return result;
+}
+
+static int mboot_gpt_write_copy(struct file *file,
+				struct mboot_gpt_copy *copy,
+				u32 logical_block_size)
+{
+	struct mboot_gpt_header *header;
+	u64 entries_offset;
+	u64 header_offset;
+	u32 header_size = le32_to_cpu(copy->header.header_size);
+	u32 crc;
+	u8 *sector;
+	int result;
+
+	if (header_size != sizeof(copy->header) ||
+	    copy->entries_size % logical_block_size)
+		return -EINVAL;
+	sector = kzalloc(logical_block_size, GFP_KERNEL);
+	if (!sector)
+		return -ENOMEM;
+	copy->header.partition_entry_crc32 =
+		cpu_to_le32(mboot_gpt_crc32(copy->entries, copy->entries_size));
+	copy->header.header_crc32 = 0;
+	memcpy(sector, &copy->header, sizeof(copy->header));
+	crc = mboot_gpt_crc32(sector, header_size);
+	header = (struct mboot_gpt_header *)sector;
+	header->header_crc32 = cpu_to_le32(crc);
+	copy->header.header_crc32 = cpu_to_le32(crc);
+	if (check_mul_overflow(le64_to_cpu(copy->header.partition_entry_lba),
+			       (u64)logical_block_size, &entries_offset) ||
+	    check_mul_overflow(le64_to_cpu(copy->header.current_lba),
+			       (u64)logical_block_size, &header_offset)) {
+		result = -ERANGE;
+		goto out;
+	}
+	result = mboot_block_write_exact(file, entries_offset, copy->entries,
+					 copy->entries_size);
+	if (!result)
+		result = mboot_block_write_exact(file, header_offset, sector,
+						 logical_block_size);
+out:
+	kfree(sector);
+	return result;
+}
+
+static int mboot_gpt_persist(struct file *file,
+			     struct mboot_gpt_copy *primary,
+			     struct mboot_gpt_copy *backup,
+			     u32 logical_block_size)
+{
+	int result;
+
+	result = mboot_gpt_write_copy(file, backup, logical_block_size);
+	if (result || vfs_fsync(file, 0))
+		return result ?: -EIO;
+	result = mboot_gpt_write_copy(file, primary, logical_block_size);
+	if (result || vfs_fsync(file, 0))
+		return result ?: -EIO;
+	return 0;
+}
+
+static int mboot_gpt_load_mutable(struct file *file,
+				  struct mboot_gpt_copy *primary,
+				  struct mboot_gpt_copy *backup,
+				  u32 *logical_block_size)
+{
+	struct block_device *bdev = file_bdev(file);
+	u64 total_lbas;
+	int result;
+
+	*logical_block_size = bdev_logical_block_size(bdev);
+	if (*logical_block_size < MBOOT_BLOCK_SECTOR_SIZE ||
+	    *logical_block_size > PAGE_SIZE ||
+	    *logical_block_size % MBOOT_BLOCK_SECTOR_SIZE)
+		return -EINVAL;
+	total_lbas = div_u64(bdev_nr_bytes(bdev), *logical_block_size);
+	if (total_lbas < 6)
+		return -EINVAL;
+	result = mboot_gpt_validate_pmbr(file, total_lbas, *logical_block_size);
+	if (result)
+		return result;
+	result = mboot_gpt_read_copy(file, 1, total_lbas - 1, total_lbas,
+				     *logical_block_size, NULL, primary);
+	if (result)
+		return result;
+	result = mboot_gpt_read_copy(file, total_lbas - 1, 1, total_lbas,
+				     *logical_block_size, NULL, backup);
+	if (result)
+		goto out_primary;
+	if (!mboot_gpt_copies_match(primary, backup) ||
+	    le32_to_cpu(primary->header.header_size) != sizeof(primary->header) ||
+	    primary->entries_size % *logical_block_size) {
+		result = -EINVAL;
+		goto out;
+	}
+	return 0;
+out:
+	mboot_gpt_copy_free(backup);
+out_primary:
+	mboot_gpt_copy_free(primary);
+	return result;
+}
+
+static bool mboot_gpt_unique_guid(const struct mboot_gpt_copy *copy,
+				  const u8 guid[16])
+{
+	u32 count = le32_to_cpu(copy->header.partition_entry_count);
+	u32 size = le32_to_cpu(copy->header.partition_entry_size);
+	u32 index;
+
+	if (mboot_gpt_guid_zero(guid))
+		return false;
+	for (index = 0; index < count; index++) {
+		const u8 *entry = copy->entries + (size_t)index * size;
+
+		if (!mboot_gpt_guid_zero(entry) && !memcmp(entry + 16, guid, 16))
+			return false;
+	}
+	return true;
+}
+
+static int mboot_storage_create_partition(struct file *file,
+					  const u64 arguments[4],
+					  u64 values[4])
+{
+	static const u16 name[] = { 'm', 'o', 'c', 'h', 'i', 'O', 'S' };
+	struct mboot_gpt_copy primary;
+	struct mboot_gpt_copy backup;
+	u32 logical_block_size;
+	u32 entry_count;
+	u32 entry_size;
+	u32 slot = U32_MAX;
+	u64 sectors_per_lba;
+	u64 first;
+	u64 count;
+	u64 last;
+	u8 guid[16];
+	u8 *entry;
+	u32 index;
+	int result;
+
+	if (!arguments[1] || (!arguments[2] && !arguments[3]))
+		return -EINVAL;
+	result = mboot_gpt_load_mutable(file, &primary, &backup,
+					 &logical_block_size);
+	if (result)
+		return result;
+	sectors_per_lba = logical_block_size / MBOOT_BLOCK_SECTOR_SIZE;
+	if (arguments[0] % sectors_per_lba || arguments[1] % sectors_per_lba) {
+		result = -EINVAL;
+		goto out;
+	}
+	first = div_u64(arguments[0], sectors_per_lba);
+	count = div_u64(arguments[1], sectors_per_lba);
+	if (!count || check_add_overflow(first, count - 1, &last) ||
+	    first < le64_to_cpu(primary.header.first_usable_lba) ||
+	    last > le64_to_cpu(primary.header.last_usable_lba)) {
+		result = -ERANGE;
+		goto out;
+	}
+	entry_count = le32_to_cpu(primary.header.partition_entry_count);
+	entry_size = le32_to_cpu(primary.header.partition_entry_size);
+	for (index = 0; index < entry_count; index++) {
+		const u8 *candidate = primary.entries + (size_t)index * entry_size;
+		u64 current_first;
+		u64 current_last;
+
+		if (mboot_gpt_guid_zero(candidate)) {
+			if (slot == U32_MAX)
+				slot = index;
+			continue;
+		}
+		current_first = get_unaligned_le64(candidate + 32);
+		current_last = get_unaligned_le64(candidate + 40);
+		if (first <= current_last && current_first <= last) {
+			result = -EEXIST;
+			goto out;
+		}
+	}
+	if (slot == U32_MAX) {
+		result = -ENOSPC;
+		goto out;
+	}
+	do {
+		get_random_bytes(guid, sizeof(guid));
+	} while (!mboot_gpt_unique_guid(&primary, guid));
+	entry = primary.entries + (size_t)slot * entry_size;
+	memset(entry, 0, entry_size);
+	put_unaligned_le64(arguments[2], entry);
+	put_unaligned_le64(arguments[3], entry + 8);
+	memcpy(entry + 16, guid, sizeof(guid));
+	put_unaligned_le64(first, entry + 32);
+	put_unaligned_le64(last, entry + 40);
+	for (index = 0; index < ARRAY_SIZE(name) && 56 + index * 2 + 1 < entry_size;
+	     index++)
+		put_unaligned_le16(name[index], entry + 56 + index * 2);
+	memcpy(backup.entries, primary.entries, primary.entries_size);
+	result = mboot_gpt_persist(file, &primary, &backup, logical_block_size);
+	if (!result) {
+		values[0] = get_unaligned_le64(guid);
+		values[1] = get_unaligned_le64(guid + 8);
+		values[2] = slot;
+		values[3] = arguments[0];
+	}
+out:
+	mboot_gpt_copy_free(&backup);
+	mboot_gpt_copy_free(&primary);
+	return result;
+}
+
+static int mboot_storage_delete_partition(struct file *file,
+					  const u64 arguments[4],
+					  u64 values[4])
+{
+	struct mboot_gpt_copy primary;
+	struct mboot_gpt_copy backup;
+	const u8 *selected;
+	u32 logical_block_size;
+	u32 entry_size;
+	u32 slot;
+	int result;
+
+	if (arguments[0] > U32_MAX || arguments[3] ||
+	    (!arguments[1] && !arguments[2]))
+		return -EINVAL;
+	result = mboot_gpt_load_mutable(file, &primary, &backup,
+					 &logical_block_size);
+	if (result)
+		return result;
+	result = mboot_gpt_partition_at(&primary, arguments[0], &selected, &slot);
+	if (result)
+		goto out;
+	if (get_unaligned_le64(selected + 16) != arguments[1] ||
+	    get_unaligned_le64(selected + 24) != arguments[2]) {
+		result = -ESTALE;
+		goto out;
+	}
+	entry_size = le32_to_cpu(primary.header.partition_entry_size);
+	memset(primary.entries + (size_t)slot * entry_size, 0, entry_size);
+	memcpy(backup.entries, primary.entries, primary.entries_size);
+	result = mboot_gpt_persist(file, &primary, &backup, logical_block_size);
+	if (!result)
+		values[0] = slot;
+out:
+	mboot_gpt_copy_free(&backup);
+	mboot_gpt_copy_free(&primary);
+	return result;
+}
+
+static void mboot_control_mutate_storage(const struct mboot_control_request *request,
+					 struct mboot_control_response *response)
+{
+	const struct mboot_pci_frontend *device;
+	struct file *file;
+	int result;
+
+	if (!request->device_id || request->device_id > mboot_pci_device_count)
+		return;
+	device = &mboot_pci_devices[request->device_id - 1];
+	if (mboot_control_device_kind(&device->info) != MBOOT_DEVICE_KIND_BLOCK ||
+	    device->info.flags & (MBOOT_PCI_FLAG_READ_ONLY |
+				  MBOOT_PCI_FLAG_PARTITIONED)) {
+		response->status = MBOOT_CONTROL_STATUS_UNSUPPORTED_OPERATION;
+		return;
+	}
+	if (mboot_block_file || mboot_block_ring) {
+		response->status = MBOOT_CONTROL_STATUS_BAD_STATE;
+		return;
+	}
+	file = mboot_block_open(&device->info);
+	if (IS_ERR(file)) {
+		response->status = MBOOT_CONTROL_STATUS_IO_ERROR;
+		return;
+	}
+	if (request->operation == MBOOT_CONTROL_CREATE_PARTITION)
+		result = mboot_storage_create_partition(file, request->arguments,
+							response->values);
+	else
+		result = mboot_storage_delete_partition(file, request->arguments,
+							response->values);
+	fput(file);
+	mboot_block_first_sector = 0;
+	mboot_block_sector_count = 0;
+	if (!result)
+		response->status = MBOOT_CONTROL_STATUS_OK;
+	else if (result == -ENOENT)
+		response->status = MBOOT_CONTROL_STATUS_NOT_FOUND;
+	else if (result == -ERANGE)
+		response->status = MBOOT_CONTROL_STATUS_OUT_OF_RANGE;
+	else if (result == -EINVAL || result == -EEXIST || result == -ENOSPC ||
+		 result == -ESTALE)
+		response->status = MBOOT_CONTROL_STATUS_INVALID_REQUEST;
+	else
+		response->status = MBOOT_CONTROL_STATUS_IO_ERROR;
+}
+
+static void mboot_control_inspect_storage(const struct mboot_control_request *request,
+					  struct mboot_control_response *response)
+{
+	const struct mboot_pci_frontend *device;
+	struct file *file;
+	int result;
+    u64 first, count;
+
+	if (!request->device_id || request->device_id > mboot_pci_device_count ||
+	    request->arguments[0] > 3 ||
+	    request->arguments[1] > U32_MAX || request->arguments[2] ||
+	    request->arguments[3])
+		return;
+	device = &mboot_pci_devices[request->device_id - 1];
+	if (mboot_control_device_kind(&device->info) != MBOOT_DEVICE_KIND_BLOCK ||
+	    device->info.flags & MBOOT_PCI_FLAG_PARTITIONED) {
+		response->status = MBOOT_CONTROL_STATUS_UNSUPPORTED_OPERATION;
+		return;
+	}
+	file = mboot_block_lookup(&device->info, &first, &count);
+	if (IS_ERR(file)) {
+		response->status = MBOOT_CONTROL_STATUS_IO_ERROR;
+		return;
+	}
+	if (request->arguments[0] == 3) {
+        response->values[0] = file_bdev(file)->bd_disk->diskseq;
+        response->values[1] = bdev_nr_sectors(file_bdev(file));
+        response->values[2] = bdev_logical_block_size(file_bdev(file));
+        response->values[3] = bdev_read_only(file_bdev(file));
+        result = request->arguments[1] ? -EINVAL : 0;
+    } else result = mboot_storage_inspect(file, request->arguments[0],
+				       request->arguments[1], response->values);
+	fput(file);
+	if (!result)
+		response->status = MBOOT_CONTROL_STATUS_OK;
+	else if (result == -ENOENT)
+		response->status = MBOOT_CONTROL_STATUS_END;
+	else
+		response->status = MBOOT_CONTROL_STATUS_IO_ERROR;
+}
+
+static int mboot_installer_find_payload(struct block_device *target_bdev,
+					struct file **source_file,
+					u64 *source_first, u64 *source_count)
+{
+	struct class_dev_iter iterator;
+	struct device *device;
+	int found = 0;
+	int result = -ENOENT;
+
+	*source_file = NULL;
+	class_dev_iter_init(&iterator, &block_class, NULL, &disk_type);
+	while ((device = class_dev_iter_next(&iterator))) {
+		struct gendisk *disk = dev_to_disk(device);
+		struct file *file;
+		u32 ordinal;
+
+		if (!disk_live(disk) || disk_devt(disk) == target_bdev->bd_dev)
+			continue;
+		file = bdev_file_open_by_dev(disk_devt(disk), BLK_OPEN_READ,
+					     NULL, NULL);
+		if (IS_ERR(file))
+			continue;
+		for (ordinal = 0; ordinal < 128; ordinal++) {
+			u64 guids[4] = { 0 };
+			u64 range[4] = { 0 };
+
+			result = mboot_storage_inspect(file,
+					MBOOT_STORAGE_QUERY_PARTITION_GUIDS,
+					ordinal, guids);
+			if (result == -ENOENT)
+				break;
+			if (result)
+				continue;
+			if (guids[0] != get_unaligned_le64(mboot_installer_payload_type) ||
+			    guids[1] != get_unaligned_le64(mboot_installer_payload_type + 8))
+				continue;
+			result = mboot_storage_inspect(file,
+					MBOOT_STORAGE_QUERY_PARTITION_RANGE,
+					ordinal, range);
+			if (result)
+				break;
+			if (found++) {
+				result = -EEXIST;
+				fput(file);
+				goto out;
+			}
+			*source_file = file;
+			*source_first = range[0];
+			*source_count = range[1];
+			file = NULL;
+			result = 0;
+			break;
+		}
+		if (file)
+			fput(file);
+	}
+out:
+	class_dev_iter_exit(&iterator);
+	if (result && *source_file) {
+		fput(*source_file);
+		*source_file = NULL;
+	}
+	return found == 1 && !result ? 0 : result ?: -ENOENT;
+}
+
+static int mboot_installer_verify_payload(struct file *source, u64 first,
+					   u64 count, unsigned long grant_ref)
+{
+	struct crypto_shash *tfm;
+	struct shash_desc *desc;
+	u8 actual[32];
+	u8 *buffer;
+	void *expected = NULL;
+	u64 length;
+	u64 offset = 0;
+	u64 address = mboot_grant_window_start +
+		MBOOT_INSTALL_METADATA_PAGE * PAGE_SIZE;
+	int result;
+
+	if (!grant_ref || check_mul_overflow(count,
+					     (u64)MBOOT_BLOCK_SECTOR_SIZE,
+					     &length) || !length)
+		return -EINVAL;
+	result = mboot_hypercall(MBOOT_HYPERCALL_GRANT_MAP,
+				 grant_ref, address, 0);
+	if (result)
+		return -EINVAL;
+	expected = memremap(address, PAGE_SIZE, MEMREMAP_WB);
+	if (!expected) {
+		result = -ENOMEM;
+		goto out_unmap;
+	}
+	tfm = crypto_alloc_shash("sha256", 0, 0);
+	if (IS_ERR(tfm)) {
+		result = PTR_ERR(tfm);
+		goto out_expected;
+	}
+	desc = kzalloc(sizeof(*desc) + crypto_shash_descsize(tfm), GFP_KERNEL);
+	buffer = kvmalloc(SZ_1M, GFP_KERNEL);
+	if (!desc || !buffer) {
+		result = -ENOMEM;
+		goto out_crypto;
+	}
+	desc->tfm = tfm;
+	result = crypto_shash_init(desc);
+	while (!result && offset < length) {
+		size_t chunk = min_t(u64, SZ_1M, length - offset);
+		u64 source_offset = first * MBOOT_BLOCK_SECTOR_SIZE + offset;
+
+		result = mboot_block_read_exact(source, source_offset, buffer, chunk);
+		if (!result)
+			result = crypto_shash_update(desc, buffer, chunk);
+		offset += chunk;
+	}
+	if (!result)
+		result = crypto_shash_final(desc, actual);
+	if (!result && memcmp(actual, expected, sizeof(actual)))
+		result = -EKEYREJECTED;
+out_crypto:
+	kvfree(buffer);
+	kfree(desc);
+	crypto_free_shash(tfm);
+out_expected:
+	memunmap(expected);
+out_unmap:
+	mboot_hypercall(MBOOT_HYPERCALL_GRANT_UNMAP, grant_ref, 0, 0);
+	return result;
+}
+
+static int mboot_installer_copy_partition(struct file *target,
+					   const u64 arguments[4], u64 values[4])
+{
+	struct file *source = NULL;
+	u64 guids[4] = { 0 };
+	u64 range[4] = { 0 };
+	u64 source_first = 0;
+	u64 source_count = 0;
+	u64 copied = 0;
+	u8 *buffer;
+	int result;
+
+	if (arguments[0] > U32_MAX || !arguments[3] || arguments[3] > U32_MAX ||
+	    (!arguments[1] && !arguments[2]))
+		return -EINVAL;
+	result = mboot_storage_inspect(target,
+				       MBOOT_STORAGE_QUERY_PARTITION_GUIDS,
+				       arguments[0], guids);
+	if (result)
+		return result;
+	if (guids[0] != get_unaligned_le64(mboot_mochios_partition_type) ||
+	    guids[1] != get_unaligned_le64(mboot_mochios_partition_type + 8) ||
+	    guids[2] != arguments[1] || guids[3] != arguments[2])
+		return -ESTALE;
+	result = mboot_storage_inspect(target,
+				       MBOOT_STORAGE_QUERY_PARTITION_RANGE,
+				       arguments[0], range);
+	if (result)
+		return result;
+	result = mboot_installer_find_payload(file_bdev(target), &source,
+					      &source_first, &source_count);
+	if (result)
+		return result;
+	if (!source_count || source_count > range[1]) {
+		result = -ENOSPC;
+		goto out_source;
+	}
+	result = mboot_installer_verify_payload(source, source_first,
+						 source_count, arguments[3]);
+	if (result)
+		goto out_source;
+	buffer = kvmalloc(SZ_1M, GFP_KERNEL);
+	if (!buffer) {
+		result = -ENOMEM;
+		goto out_source;
+	}
+	while (copied < source_count * MBOOT_BLOCK_SECTOR_SIZE) {
+		size_t chunk = min_t(u64, SZ_1M,
+				     source_count * MBOOT_BLOCK_SECTOR_SIZE - copied);
+		u64 source_offset = source_first * MBOOT_BLOCK_SECTOR_SIZE + copied;
+		u64 target_offset = range[0] * MBOOT_BLOCK_SECTOR_SIZE + copied;
+
+		result = mboot_block_read_exact(source, source_offset, buffer, chunk);
+		if (!result)
+			result = mboot_block_write_exact(target, target_offset, buffer, chunk);
+		if (result)
+			break;
+		copied += chunk;
+	}
+	kvfree(buffer);
+	if (!result && vfs_fsync(target, 0))
+		result = -EIO;
+	if (!result) {
+		values[0] = copied;
+		values[1] = range[0];
+		values[2] = range[1];
+	}
+out_source:
+	fput(source);
+	return result;
+}
+
+static void mboot_control_install_partition(const struct mboot_control_request *request,
+					     struct mboot_control_response *response)
+{
+	const struct mboot_pci_frontend *device;
+	struct file *file;
+	int result;
+
+	if (!request->device_id || request->device_id > mboot_pci_device_count)
+		return;
+	device = &mboot_pci_devices[request->device_id - 1];
+	if (mboot_control_device_kind(&device->info) != MBOOT_DEVICE_KIND_BLOCK ||
+	    device->info.flags & (MBOOT_PCI_FLAG_READ_ONLY |
+				  MBOOT_PCI_FLAG_PARTITIONED)) {
+		response->status = MBOOT_CONTROL_STATUS_UNSUPPORTED_OPERATION;
+		return;
+	}
+	if (mboot_block_file || mboot_block_ring || mboot_scope_active()) {
+		response->status = MBOOT_CONTROL_STATUS_BAD_STATE;
+		return;
+	}
+	file = mboot_block_open(&device->info);
+	if (IS_ERR(file)) {
+		response->status = MBOOT_CONTROL_STATUS_IO_ERROR;
+		return;
+	}
+	result = mboot_installer_copy_partition(file, request->arguments,
+						response->values);
+	fput(file);
+	mboot_block_first_sector = 0;
+	mboot_block_sector_count = 0;
+	if (!result)
+		response->status = MBOOT_CONTROL_STATUS_OK;
+	else if (result == -ENOENT)
+		response->status = MBOOT_CONTROL_STATUS_NOT_FOUND;
+	else if (result == -ENOSPC || result == -ERANGE)
+		response->status = MBOOT_CONTROL_STATUS_OUT_OF_RANGE;
+	else if (result == -EINVAL || result == -ESTALE || result == -EEXIST ||
+		 result == -EKEYREJECTED)
+		response->status = MBOOT_CONTROL_STATUS_INVALID_REQUEST;
+	else
+		response->status = MBOOT_CONTROL_STATUS_IO_ERROR;
+}
+
+static int mboot_block_open_mochios_partition(u32 device_id,
+					       unsigned long grant_ref,
+					       u64 guid_low, u64 guid_high)
+{
+	u32 ordinal;
+	int result;
+
+	if ((!guid_low && !guid_high) ||
+	    mboot_block_open_grant(device_id, grant_ref))
+		return -EINVAL;
+	for (ordinal = 0; ordinal < 128; ordinal++) {
+		u64 guids[4] = { 0 };
+		u64 range[4] = { 0 };
+
+		result = mboot_storage_inspect(mboot_block_file,
+					MBOOT_STORAGE_QUERY_PARTITION_GUIDS,
+					ordinal, guids);
+		if (result)
+			break;
+		if (guids[0] != get_unaligned_le64(mboot_mochios_partition_type) ||
+		    guids[1] != get_unaligned_le64(mboot_mochios_partition_type + 8) ||
+		    guids[2] != guid_low || guids[3] != guid_high)
+			continue;
+		result = mboot_storage_inspect(mboot_block_file,
+					MBOOT_STORAGE_QUERY_PARTITION_RANGE,
+					ordinal, range);
+		if (!result && range[1]) {
+			mboot_block_first_sector = range[0];
+			mboot_block_sector_count = range[1];
+			return 0;
+		}
+		break;
+	}
+	mboot_block_close();
+	return result ?: -ENOENT;
+}
+
+#include "mboot_input.h"
+#include "mboot_scoped_storage.h"
+
+static void mboot_control_handle(const struct mboot_control_request *request,
+				 struct mboot_control_response *response)
+{
+	const struct mboot_pci_frontend *device;
+	u32 index;
+
+	memset(response, 0, sizeof(*response));
+	response->version = MBOOT_CONTROL_VERSION;
+	response->operation = request->operation;
+	response->device_id = request->device_id;
+	response->status = MBOOT_CONTROL_STATUS_INVALID_REQUEST;
+	if (request->flags || request->reserved)
+		return;
+	if (request->version != MBOOT_CONTROL_VERSION) {
+		response->status = MBOOT_CONTROL_STATUS_UNSUPPORTED_VERSION;
+		return;
+	}
+	if (request->operation == MBOOT_CONTROL_NEGOTIATE) {
+		if (request->device_id || request->arguments[2] ||
+		    request->arguments[3])
+			return;
+		if (request->arguments[0] > MBOOT_CONTROL_VERSION ||
+		    request->arguments[1] < MBOOT_CONTROL_VERSION) {
+			response->status = MBOOT_CONTROL_STATUS_UNSUPPORTED_VERSION;
+			return;
+		}
+		mboot_control_negotiated = true;
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		response->values[0] = MBOOT_CONTROL_VERSION;
+		response->values[1] = MBOOT_CONTROL_CAPABILITIES;
+		response->values[2] = mboot_pci_device_count;
+		response->values[3] = mboot_control_ring->header.generation;
+		return;
+	}
+	if (!mboot_control_negotiated) {
+		response->status = MBOOT_CONTROL_STATUS_BAD_STATE;
+		return;
+	}
+	switch (request->operation) {
+    case MBOOT_CONTROL_OPEN_REGION:
+    case MBOOT_CONTROL_REGION_READ:
+    case MBOOT_CONTROL_REGION_WRITE:
+    case MBOOT_CONTROL_REGION_FLUSH:
+    case MBOOT_CONTROL_CLOSE_REGION:
+        mboot_scope_control(request, response);
+        return;
+	case MBOOT_CONTROL_READ_POINTER:
+		mboot_control_read_pointer(request, response);
+		return;
+	case MBOOT_CONTROL_INSTALL_PARTITION:
+		mboot_control_install_partition(request, response);
+		return;
+	case MBOOT_CONTROL_CREATE_PARTITION:
+	case MBOOT_CONTROL_DELETE_PARTITION:
+		mboot_control_mutate_storage(request, response);
+		return;
+	case MBOOT_CONTROL_INSPECT_STORAGE:
+		mboot_control_inspect_storage(request, response);
+		return;
+	case MBOOT_CONTROL_ENUMERATE:
+		if (request->device_id || request->arguments[1] ||
+		    request->arguments[2] || request->arguments[3] ||
+		    request->arguments[0] > U32_MAX)
+			return;
+		index = request->arguments[0];
+		if (index >= mboot_pci_device_count) {
+			response->status = MBOOT_CONTROL_STATUS_END;
+			return;
+		}
+		device = &mboot_pci_devices[index];
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		response->device_id = index + 1;
+		response->values[0] = index + 1;
+		response->values[1] = mboot_control_device_kind(&device->info);
+		response->values[2] = MBOOT_DEVICE_STATE_ONLINE;
+		response->values[3] = mboot_control_device_features(&device->info);
+		return;
+	case MBOOT_CONTROL_DESCRIBE:
+		if (!mboot_control_zero_arguments(request->arguments))
+			return;
+		if (!request->device_id ||
+		    request->device_id > mboot_pci_device_count) {
+			response->status = MBOOT_CONTROL_STATUS_NOT_FOUND;
+			return;
+		}
+		device = &mboot_pci_devices[request->device_id - 1];
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		response->values[0] = mboot_control_device_kind(&device->info);
+		response->values[1] = MBOOT_DEVICE_STATE_ONLINE;
+		response->values[2] = mboot_control_device_features(&device->info);
+		response->values[3] = device->info.requester |
+				      (u64)device->info.class << 16 |
+				      (u64)device->info.subclass << 24;
+		return;
+	case MBOOT_CONTROL_PING:
+		if (request->device_id || request->arguments[1] ||
+		    request->arguments[2] || request->arguments[3])
+			return;
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		response->values[0] = request->arguments[0];
+		return;
+	case MBOOT_CONTROL_START_SESSION:
+		if (request->device_id ||
+		    !mboot_control_zero_arguments(request->arguments))
+			return;
+		if (mboot_control_active) {
+			response->status = MBOOT_CONTROL_STATUS_BAD_STATE;
+			return;
+		}
+		mboot_control_active = true;
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		response->values[0] = mboot_control_ring->header.generation;
+		return;
+	case MBOOT_CONTROL_OPEN_DEVICE:
+		if (!mboot_control_active || !request->device_id ||
+		    !request->arguments[0] ||
+		    request->arguments[0] > U32_MAX ||
+		    request->arguments[1] != MBOOT_BLOCK_MAX_TRANSFER ||
+		    request->arguments[2] || request->arguments[3])
+			return;
+		if (mboot_block_open_grant(request->device_id,
+					   request->arguments[0])) {
+			response->status = MBOOT_CONTROL_STATUS_IO_ERROR;
+			return;
+		}
+		device = &mboot_pci_devices[request->device_id - 1];
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		response->values[0] = mboot_block_sector_count;
+		response->values[1] =
+			bdev_logical_block_size(file_bdev(mboot_block_file));
+		response->values[2] = MBOOT_BLOCK_MAX_TRANSFER;
+		response->values[3] = mboot_control_device_features(&device->info);
+		return;
+	case MBOOT_CONTROL_OPEN_PARTITION:
+		if (!mboot_control_active || !request->device_id ||
+		    !request->arguments[0] || request->arguments[0] > U32_MAX ||
+		    request->arguments[1] != MBOOT_BLOCK_MAX_TRANSFER ||
+		    (!request->arguments[2] && !request->arguments[3]))
+			return;
+		if (mboot_block_open_mochios_partition(request->device_id,
+						 request->arguments[0],
+						 request->arguments[2],
+						 request->arguments[3])) {
+			response->status = MBOOT_CONTROL_STATUS_IO_ERROR;
+			return;
+		}
+		device = &mboot_pci_devices[request->device_id - 1];
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		response->values[0] = mboot_block_sector_count;
+		response->values[1] =
+			bdev_logical_block_size(file_bdev(mboot_block_file));
+		response->values[2] = MBOOT_BLOCK_MAX_TRANSFER;
+		response->values[3] = mboot_control_device_features(&device->info);
+		return;
+	case MBOOT_CONTROL_CLOSE_DEVICE:
+		if (!mboot_control_active ||
+		    !mboot_control_zero_arguments(request->arguments))
+			return;
+		if (!mboot_block_file ||
+		    request->device_id != mboot_block_device_id) {
+			response->status = MBOOT_CONTROL_STATUS_BAD_STATE;
+			return;
+		}
+		mboot_block_close();
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		return;
+	case MBOOT_CONTROL_BLOCK_READ:
+	case MBOOT_CONTROL_BLOCK_WRITE: {
+		loff_t position;
+		size_t length;
+		size_t buffer_offset;
+		ssize_t transferred;
+		int validation;
+
+		if (!mboot_control_active)
+			return;
+		validation = mboot_block_request_valid(request, &position,
+						       &length, &buffer_offset);
+		if (validation) {
+			response->status = validation == -ERANGE ?
+				MBOOT_CONTROL_STATUS_OUT_OF_RANGE :
+				MBOOT_CONTROL_STATUS_INVALID_REQUEST;
+			return;
+		}
+		if (request->operation == MBOOT_CONTROL_BLOCK_WRITE &&
+		    mboot_pci_devices[request->device_id - 1].info.flags &
+			MBOOT_PCI_FLAG_READ_ONLY) {
+			response->status = MBOOT_CONTROL_STATUS_UNSUPPORTED_OPERATION;
+			return;
+		}
+		if (request->operation == MBOOT_CONTROL_BLOCK_READ)
+			transferred = kernel_read(mboot_block_file,
+						  mboot_block_buffer + buffer_offset,
+						  length, &position);
+		else
+			transferred = kernel_write(mboot_block_file,
+						   mboot_block_buffer + buffer_offset,
+						   length, &position);
+		if (transferred != (ssize_t)length) {
+			response->status = MBOOT_CONTROL_STATUS_IO_ERROR;
+			return;
+		}
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		response->values[0] = transferred;
+		if (!mboot_block_io_verified) {
+			mboot_block_io_verified = true;
+			pr_info("mDriver: block data I/O completed\n");
+		}
+		return;
+	}
+	case MBOOT_CONTROL_BLOCK_FLUSH:
+		if (!mboot_control_active ||
+		    !mboot_control_zero_arguments(request->arguments))
+			return;
+		if (!mboot_block_file ||
+		    request->device_id != mboot_block_device_id) {
+			response->status = MBOOT_CONTROL_STATUS_BAD_STATE;
+			return;
+		}
+		if (mboot_pci_devices[request->device_id - 1].info.flags &
+		    MBOOT_PCI_FLAG_READ_ONLY) {
+			response->status = MBOOT_CONTROL_STATUS_UNSUPPORTED_OPERATION;
+			return;
+		}
+		response->status = vfs_fsync(mboot_block_file, 0) ?
+			MBOOT_CONTROL_STATUS_IO_ERROR : MBOOT_CONTROL_STATUS_OK;
+		return;
+	case MBOOT_CONTROL_OPEN_BLOCK_QUEUE:
+		if (!mboot_control_active || !request->device_id ||
+		    !request->arguments[0] || request->arguments[0] > U32_MAX ||
+		    request->arguments[1] != MBOOT_BLOCK_RING_GENERATION ||
+		    request->arguments[2] != MBOOT_BLOCK_BUFFER_COUNT ||
+		    request->arguments[3] != MBOOT_BLOCK_MAX_TRANSFER)
+			return;
+		if (mboot_block_queue_open(request->device_id,
+					   request->arguments[0])) {
+			response->status = MBOOT_CONTROL_STATUS_IO_ERROR;
+			return;
+		}
+		device = &mboot_pci_devices[request->device_id - 1];
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		response->values[0] = mboot_block_sector_count;
+		response->values[1] =
+			bdev_logical_block_size(file_bdev(mboot_block_file));
+		response->values[2] = MBOOT_BLOCK_BUFFER_COUNT;
+		response->values[3] = mboot_control_device_features(&device->info);
+		return;
+	case MBOOT_CONTROL_REGISTER_BLOCK_BUFFER:
+		if (!mboot_control_active ||
+		    request->device_id != mboot_block_device_id ||
+		    request->arguments[0] >= MBOOT_BLOCK_BUFFER_COUNT ||
+		    !request->arguments[1] || request->arguments[1] > U32_MAX ||
+		    request->arguments[2] || request->arguments[3])
+			return;
+		if (mboot_block_queue_register(request->arguments[0],
+					       request->arguments[1])) {
+			response->status = MBOOT_CONTROL_STATUS_IO_ERROR;
+			return;
+		}
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		response->values[0] = request->arguments[0];
+		return;
+	case MBOOT_CONTROL_START_BLOCK_QUEUE:
+		if (!mboot_control_active ||
+		    request->device_id != mboot_block_device_id ||
+		    !mboot_control_zero_arguments(request->arguments))
+			return;
+		if (!mboot_block_ring || mboot_block_queue_active ||
+		    !mboot_block_queue_complete()) {
+			response->status = MBOOT_CONTROL_STATUS_BAD_STATE;
+			return;
+		}
+		mboot_block_queue_active = true;
+		pr_info("mDriver: asynchronous block queue ready\n");
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		response->values[0] = MBOOT_BLOCK_RING_GENERATION;
+		response->values[1] = MBOOT_BLOCK_BUFFER_COUNT;
+		return;
+	case MBOOT_CONTROL_STOP_BLOCK_QUEUE:
+		if (!mboot_control_active ||
+		    request->device_id != mboot_block_device_id ||
+		    !mboot_control_zero_arguments(request->arguments))
+			return;
+		if (!mboot_block_queue_active) {
+			response->status = MBOOT_CONTROL_STATUS_BAD_STATE;
+			return;
+		}
+		mboot_block_queue_close();
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		return;
+	case MBOOT_CONTROL_OPEN_DISPLAY:
+		if (!mboot_control_active || !request->device_id ||
+		    request->arguments[0] > U32_MAX ||
+		    request->arguments[3] > MBOOT_DISPLAY_OPEN_SHARED_SURFACE)
+			return;
+		if (mboot_display_open(request->device_id, request->arguments[0],
+				       request->arguments[1], request->arguments[2],
+				       request->arguments[3])) {
+			response->status = MBOOT_CONTROL_STATUS_BAD_STATE;
+			return;
+		}
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		response->values[0] = mboot_display_buffer_size;
+		response->values[1] = MBOOT_DISPLAY_PIXEL_BYTES;
+		return;
+	case MBOOT_CONTROL_REGISTER_DISPLAY_BUFFER:
+		if (!mboot_control_active || !request->device_id ||
+		    !request->arguments[1] || request->arguments[1] > U32_MAX ||
+		    request->arguments[2] || request->arguments[3])
+			return;
+		if (mboot_display_register(request->device_id,
+					   request->arguments[0],
+					   request->arguments[1])) {
+			response->status = MBOOT_CONTROL_STATUS_BAD_STATE;
+			return;
+		}
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		response->values[0] = request->arguments[0];
+		return;
+	case MBOOT_CONTROL_DISPLAY_INFO:
+		if (!mboot_control_active ||
+		    request->device_id != mboot_display_device_id ||
+		    !mboot_control_zero_arguments(request->arguments) ||
+		    !mboot_display_info)
+			return;
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		response->values[0] = mboot_display_info->var.xres;
+		response->values[1] = mboot_display_info->var.yres;
+		response->values[2] = mboot_display_info->fix.line_length;
+		response->values[3] = mboot_display_info->var.bits_per_pixel |
+			(u64)mboot_display_info->var.red.offset << 8 |
+			(u64)mboot_display_info->var.green.offset << 16 |
+			(u64)mboot_display_info->var.blue.offset << 24 |
+			(u64)mboot_display_info->var.transp.offset << 32;
+		return;
+	case MBOOT_CONTROL_PRESENT_DISPLAY:
+		if (!mboot_control_active)
+			return;
+		response->status = mboot_display_present(request) ?
+			MBOOT_CONTROL_STATUS_IO_ERROR : MBOOT_CONTROL_STATUS_OK;
+		return;
+	case MBOOT_CONTROL_PRESENT_GPU_SCENE:
+		if (!mboot_control_active)
+			return;
+		response->status = mboot_gpu_submit(request) ?
+			MBOOT_CONTROL_STATUS_IO_ERROR : MBOOT_CONTROL_STATUS_OK;
+		return;
+	case MBOOT_CONTROL_CLOSE_DISPLAY:
+		if (!mboot_control_active ||
+		    request->device_id != mboot_display_device_id ||
+		    !mboot_control_zero_arguments(request->arguments))
+			return;
+		mboot_display_close();
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		return;
+	default:
+		response->status = MBOOT_CONTROL_STATUS_UNSUPPORTED_OPERATION;
+	}
+}
+
+static int mboot_control_process(bool *session_started)
+{
+	struct mboot_control_response control_response;
+	struct mboot_control_request control_request;
+	struct mboot_ring_message response;
+	struct mboot_ring_message request;
+	u32 response_producer;
+	u32 response_consumer;
+	u32 response_index;
+	u32 producer;
+	u32 consumer;
+	bool processed = false;
+
+	/* Pair with the System Domain's request publication. */
+	producer = smp_load_acquire(&mboot_control_ring->header.request_producer);
+	consumer = READ_ONCE(mboot_control_ring->header.request_consumer);
+	if (producer - consumer > MBOOT_CONTROL_RING_SLOTS)
+		return -EIO;
+	while (consumer != producer) {
+		bool valid_request;
+
+		memcpy(&request,
+		       &mboot_control_ring->requests[consumer % MBOOT_CONTROL_RING_SLOTS],
+		       sizeof(request));
+		memset(&control_request, 0, sizeof(control_request));
+		valid_request = request.kind == MBOOT_CONTROL_REQUEST_KIND &&
+				!request.flags &&
+				request.len == sizeof(control_request);
+		if (valid_request)
+			memcpy(&control_request, request.payload,
+			       sizeof(control_request));
+		if (valid_request) {
+			mboot_control_handle(&control_request, &control_response);
+		} else {
+			memset(&control_response, 0, sizeof(control_response));
+			control_response.version = MBOOT_CONTROL_VERSION;
+			control_response.status =
+				MBOOT_CONTROL_STATUS_INVALID_REQUEST;
+		}
+		memset(&response, 0, sizeof(response));
+		response.kind = MBOOT_CONTROL_RESPONSE_KIND;
+		response.len = sizeof(control_response);
+		response.request_id = request.request_id;
+		memcpy(response.payload, &control_response,
+		       sizeof(control_response));
+
+		response_producer = READ_ONCE(mboot_control_ring->header.response_producer);
+		/* Pair with the System Domain returning a response slot. */
+		response_consumer = smp_load_acquire(&mboot_control_ring->header.response_consumer);
+		if (response_producer - response_consumer >= MBOOT_CONTROL_RING_SLOTS)
+			return -ENOSPC;
+		response_index = response_producer % MBOOT_CONTROL_RING_SLOTS;
+		memcpy(&mboot_control_ring->responses[response_index], &response,
+		       sizeof(response));
+		/* Publish the response only after its contents are visible. */
+		smp_store_release(&mboot_control_ring->header.response_producer,
+				  response_producer + 1);
+		consumer++;
+		/* Finish reading the request before returning its slot. */
+		smp_store_release(&mboot_control_ring->header.request_consumer,
+				  consumer);
+		if (control_request.operation == MBOOT_CONTROL_START_SESSION &&
+		    control_response.status == MBOOT_CONTROL_STATUS_OK)
+			*session_started = true;
+		processed = true;
+	}
+	if (!processed)
+		return 0;
+	if (!mboot_block_queue_verified) {
+		mboot_block_queue_verified = true;
+		pr_info("mDriver: asynchronous block batch completed\n");
+	}
+	return mboot_hypercall(MBOOT_HYPERCALL_EVENT_SEND,
+			       MBOOT_CONTROL_RING_PORT, 0, 0) ? -EIO : 0;
+}
+
+static void mboot_block_handle(const struct mboot_block_request *request,
+			       struct mboot_block_response *response)
+{
+	loff_t position;
+	size_t length;
+	size_t buffer_offset;
+	ssize_t transferred;
+	int validation;
+
+	memset(response, 0, sizeof(*response));
+	response->version = MBOOT_BLOCK_VERSION;
+	response->operation = request->operation;
+	response->device_id = request->device_id;
+	response->buffer_id = request->buffer_id;
+	response->sector = request->sector;
+	response->status = MBOOT_BLOCK_STATUS_INVALID_REQUEST;
+	if (request->version != MBOOT_BLOCK_VERSION || request->flags ||
+	    memchr_inv(request->reserved, 0, sizeof(request->reserved)))
+		return;
+	if (!mboot_block_queue_active) {
+		response->status = MBOOT_BLOCK_STATUS_BAD_STATE;
+		return;
+	}
+	if (request->operation == MBOOT_BLOCK_FLUSH) {
+		if (request->device_id != mboot_block_device_id ||
+		    request->buffer_id || request->sector || request->length ||
+		    request->buffer_offset)
+			return;
+		if (mboot_pci_devices[request->device_id - 1].info.flags &
+		    MBOOT_PCI_FLAG_READ_ONLY) {
+			response->status = MBOOT_BLOCK_STATUS_READ_ONLY;
+			return;
+		}
+		response->status = vfs_fsync(mboot_block_file, 0) ?
+			MBOOT_BLOCK_STATUS_IO_ERROR : MBOOT_BLOCK_STATUS_OK;
+		return;
+	}
+	if (request->operation != MBOOT_BLOCK_READ &&
+	    request->operation != MBOOT_BLOCK_WRITE)
+		return;
+	validation = mboot_block_queue_request_valid(request, &position, &length,
+						     &buffer_offset);
+	if (validation) {
+		response->status = validation == -ERANGE ?
+			MBOOT_BLOCK_STATUS_OUT_OF_RANGE :
+			MBOOT_BLOCK_STATUS_INVALID_REQUEST;
+		return;
+	}
+	if (request->operation == MBOOT_BLOCK_WRITE &&
+	    mboot_pci_devices[request->device_id - 1].info.flags &
+		MBOOT_PCI_FLAG_READ_ONLY) {
+		response->status = MBOOT_BLOCK_STATUS_READ_ONLY;
+		return;
+	}
+	if (request->operation == MBOOT_BLOCK_READ)
+		transferred = kernel_read(mboot_block_file,
+					  mboot_block_buffers[request->buffer_id] +
+						buffer_offset,
+					  length, &position);
+	else
+		transferred = kernel_write(mboot_block_file,
+					   mboot_block_buffers[request->buffer_id] +
+						 buffer_offset,
+					   length, &position);
+	if (transferred != (ssize_t)length) {
+		response->status = MBOOT_BLOCK_STATUS_IO_ERROR;
+		return;
+	}
+	response->status = MBOOT_BLOCK_STATUS_OK;
+	response->transferred = transferred;
+}
+
+static int mboot_block_process(void)
+{
+	struct mboot_block_response block_response;
+	struct mboot_block_request block_request;
+	struct mboot_ring_message response;
+	struct mboot_ring_message request;
+	u32 response_producer;
+	u32 response_consumer;
+	u32 response_index;
+	u32 producer;
+	u32 consumer;
+	bool processed = false;
+
+	if (!mboot_block_queue_active || !mboot_block_ring)
+		return -EIO;
+	/* Pair with the System Domain's request publication. */
+	producer = smp_load_acquire(&mboot_block_ring->header.request_producer);
+	consumer = READ_ONCE(mboot_block_ring->header.request_consumer);
+	if (producer - consumer > MBOOT_BLOCK_BUFFER_COUNT)
+		return -EIO;
+	while (consumer != producer) {
+		bool valid_request;
+
+		memcpy(&request,
+		       &mboot_block_ring->requests[consumer % MBOOT_CONTROL_RING_SLOTS],
+		       sizeof(request));
+		memset(&block_request, 0, sizeof(block_request));
+		valid_request = request.kind == MBOOT_BLOCK_REQUEST_KIND &&
+				!request.flags &&
+				request.len == sizeof(block_request);
+		if (valid_request)
+			memcpy(&block_request, request.payload,
+			       sizeof(block_request));
+		if (valid_request) {
+			mboot_block_handle(&block_request, &block_response);
+		} else {
+			memset(&block_response, 0, sizeof(block_response));
+			block_response.version = MBOOT_BLOCK_VERSION;
+			block_response.status = MBOOT_BLOCK_STATUS_INVALID_REQUEST;
+		}
+		memset(&response, 0, sizeof(response));
+		response.kind = MBOOT_BLOCK_RESPONSE_KIND;
+		response.len = sizeof(block_response);
+		response.request_id = request.request_id;
+		memcpy(response.payload, &block_response,
+		       sizeof(block_response));
+		response_producer =
+			READ_ONCE(mboot_block_ring->header.response_producer);
+		response_consumer =
+			/* Pair with the System Domain returning a response slot. */
+			smp_load_acquire(&mboot_block_ring->header.response_consumer);
+		if (response_producer - response_consumer >= MBOOT_CONTROL_RING_SLOTS)
+			return -ENOSPC;
+		response_index = response_producer % MBOOT_CONTROL_RING_SLOTS;
+		memcpy(&mboot_block_ring->responses[response_index], &response,
+		       sizeof(response));
+		/* Publish the response after its contents are visible. */
+		smp_store_release(&mboot_block_ring->header.response_producer,
+				  response_producer + 1);
+		consumer++;
+		/* Finish reading the request before returning its slot. */
+		smp_store_release(&mboot_block_ring->header.request_consumer,
+				  consumer);
+		processed = true;
+	}
+	if (!processed)
+		return 0;
+	return mboot_hypercall(MBOOT_HYPERCALL_EVENT_SEND,
+			       MBOOT_BLOCK_RING_PORT, 0, 0) ? -EIO : 0;
+}
+
+static int mboot_control_worker(void *unused)
+{
+	while (!kthread_should_stop()) {
+		unsigned long result;
+		bool ignored = false;
+
+		result = mboot_hypercall(MBOOT_HYPERCALL_EVENT_POLL, 0, 0, 0);
+		if (result == MBOOT_EVENT_NO_EVENT)
+			result = mboot_hypercall(MBOOT_HYPERCALL_EVENT_WAIT, 0, 0, 0);
+		if (result == MBOOT_CONTROL_RING_PORT) {
+			if (mboot_control_process(&ignored))
+				break;
+		} else if (result == MBOOT_BLOCK_RING_PORT) {
+			if (mboot_block_process())
+				break;
+		} else if (result != MBOOT_EVENT_NO_EVENT) {
+			break;
+		}
+		cond_resched();
+	}
+	mboot_block_queue_close();
+	mboot_scope_close();
+	mboot_block_close();
+	mboot_display_close();
+	pr_err("mDriver: device control worker stopped\n");
+	return -EIO;
+}
+
+static int mboot_control_ring_start(void)
+{
+	struct task_struct *worker;
+	unsigned long grant_ref;
+	unsigned long result;
+	u64 grant_window_size;
+	bool session_started = false;
+
+	BUILD_BUG_ON(sizeof(struct mboot_ring_header) != 64);
+	BUILD_BUG_ON(sizeof(struct mboot_ring_message) != 64);
+	BUILD_BUG_ON(sizeof(struct mboot_ring_page) != PAGE_SIZE);
+	BUILD_BUG_ON(sizeof(struct mboot_control_request) != 48);
+	BUILD_BUG_ON(sizeof(struct mboot_control_response) != 48);
+	BUILD_BUG_ON(sizeof(struct mboot_block_request) != 48);
+	BUILD_BUG_ON(sizeof(struct mboot_block_response) != 48);
+
+	result = mboot_hypercall(MBOOT_HYPERCALL_EVENT_WAIT, 0, 0, 0);
+	if (result != MBOOT_CONTROL_RING_PORT)
+		return -EIO;
+	if (!mboot_arch_grant_window(&mboot_grant_window_start, &grant_window_size))
+		return -EIO;
+	if (!mboot_grant_window_start ||
+	    mboot_grant_window_start & (PAGE_SIZE - 1) ||
+	    grant_window_size <
+		(MBOOT_BLOCK_BUFFER_FIRST_PAGE + MBOOT_BLOCK_BUFFER_COUNT) * PAGE_SIZE)
+		return -EIO;
+	mboot_grant_window_size = grant_window_size;
+	grant_ref = mboot_hypercall(MBOOT_HYPERCALL_GRANT_QUERY, 0, 0, 0);
+	if (grant_ref == MBOOT_HYPERCALL_INVALID_ARGUMENT || grant_ref > U32_MAX)
+		return -EIO;
+	result = mboot_hypercall(MBOOT_HYPERCALL_GRANT_MAP, grant_ref,
+				 mboot_grant_window_start, 0);
+	if (result)
+		return -EIO;
+	mboot_control_ring = memremap(mboot_grant_window_start, PAGE_SIZE,
+				      MEMREMAP_WB);
+	if (!mboot_control_ring)
+		goto unmap;
+	if (!mboot_ring_valid(mboot_control_ring, MBOOT_CONTROL_RING_GENERATION))
+		goto unmap_memory;
+	while (!session_started) {
+		if (mboot_control_process(&session_started))
+			goto unmap_memory;
+		if (!session_started) {
+			result = mboot_hypercall(MBOOT_HYPERCALL_EVENT_WAIT, 0, 0, 0);
+			if (result != MBOOT_CONTROL_RING_PORT)
+				goto unmap_memory;
+		}
+	}
+	worker = kthread_run(mboot_control_worker, NULL, "mboot-control");
+	if (IS_ERR(worker))
+		goto unmap_memory;
+	pr_info("mDriver: mBoot device control protocol ready\n");
+	return 0;
+
+unmap_memory:
+	memunmap(mboot_control_ring);
+	mboot_control_ring = NULL;
+unmap:
+	mboot_hypercall(MBOOT_HYPERCALL_GRANT_UNMAP, grant_ref, 0, 0);
+	return -EIO;
+}
+
+static int __init mboot_gpu_device_init(void)
+{
+	if (!mboot_arch_present())
+		return 0;
+	return misc_register(&mboot_gpu_device);
+}
+device_initcall(mboot_gpu_device_init);
+
+static int mboot_finish_ready(void)
+{
+	unsigned long result;
+
+	result = mboot_hypercall(MBOOT_HYPERCALL_EVENT_SEND,
+				 MBOOT_CONTROL_PORT, 0, 0);
+	if (result)
+		return -EIO;
+	result = mboot_hypercall(MBOOT_HYPERCALL_EVENT_WAIT, 0, 0, 0);
+	if (result != MBOOT_CONTROL_PORT)
+		return -EIO;
+	result = mboot_hypercall(MBOOT_HYPERCALL_EVENT_SEND,
+				 MBOOT_CONTROL_IRQ_PORT, 0, 0);
+	if (result)
+		return -EIO;
+	result = mboot_hypercall(MBOOT_HYPERCALL_EVENT_WAIT, 0, 0, 0);
+	if (result != MBOOT_CONTROL_IRQ_PORT)
+		return -EIO;
+	pr_info("mDriver: mBoot control Event Channel ready\n");
+	result = mboot_hypercall(MBOOT_HYPERCALL_READY, 0, 0, 0);
+	if (result) {
+		pr_err("mDriver: mBoot Ready hypercall failed: %lu\n", result);
+		return -EIO;
+	}
+	pr_info("mDriver: hardware backend ready\n");
+	if (mboot_control_ring_start())
+		return -EIO;
+	pr_info("mDriver: mBoot control path ready\n");
+	return 0;
+}
