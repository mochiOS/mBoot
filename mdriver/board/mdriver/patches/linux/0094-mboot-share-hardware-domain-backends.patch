+void mboot_gpu_probe_trace(struct device *dev, const char *event,
+			   const char *detail, int result)
+{
+	struct mboot_pci_frontend *frontend;
+	struct pci_dev *pdev;
+	unsigned long flags;
+	char line[192];
+	size_t len;
+
+	if (!dev_is_pci(dev))
+		return;
+	pdev = to_pci_dev(dev);
+	if (pdev->bus->ops != &mboot_pci_ops ||
+	    pdev->class >> 16 != PCI_BASE_CLASS_DISPLAY)
+		return;
+	frontend = mboot_pci_find(pdev->bus->number, pdev->devfn);
+	if (!frontend)
+		return;
+	if (mboot_text_console && !mboot_i915_check && !strcmp(event, "i915-stop"))
+		event = "i915-stage";
+	len = scnprintf(line, sizeof(line), "%s %s rc=%d\n",
+			event, detail ?: "-", result);
+	/* Defer reasons can contain a trailing newline. Keep one event per line. */
+	for (size_t i = 0; i + 1 < len; i++)
+		if (line[i] < ' ' || line[i] > '~')
+			line[i] = ' ';
+	pr_info("mDriver GPU %s: %s", pci_name(pdev), line);
+	spin_lock_irqsave(&mboot_probe_lock, flags);
+	/* Preserve the first attempt; do not let readiness polling erase it. */
+	if (frontend->probe_trace_len + len < sizeof(frontend->probe_trace)) {
+		memcpy(frontend->probe_trace + frontend->probe_trace_len, line, len + 1);
+		frontend->probe_trace_len += len;
+	}
+	spin_unlock_irqrestore(&mboot_probe_lock, flags);
+	/* Explicit diagnostic boot only, in the sleepable i915 probe path.
+	 * Keep the failing state intact rather than running reset or cleanup.
+	 * No periodic redraw, watchdog, network gate, or attach retry. */
+	if (mboot_i915_check && pdev->vendor == PCI_VENDOR_ID_INTEL &&
+	    (!strcmp(event, "i915-stop") ||
+	     (result < 0 && (!strcmp(event, "mmio-error") ||
+			    !strncmp(event, "i915-", 5))))) {
+		mboot_gpu_probe_report(pdev);
+		for (;;) {
+			set_current_state(TASK_UNINTERRUPTIBLE);
+			schedule();
+		}
+	}
+}
+
+static ssize_t gpu_probe_show(struct device *dev,
+			      struct device_attribute *attr, char *buf)
+{
+	struct pci_dev *pdev = to_pci_dev(dev);
+	struct mboot_pci_frontend *frontend =
+		mboot_pci_find(pdev->bus->number, pdev->devfn);
+	unsigned long flags;
+	u32 opregion = 0, bdsm = 0, bgsm = 0;
+	u16 command = 0;
+	unsigned long physical_command;
+	size_t len = 0;
+	unsigned int i;
+
+	pci_read_config_word(pdev, PCI_COMMAND, &command);
+	pci_read_config_dword(pdev, 0xfc, &opregion);
+	pci_read_config_dword(pdev, 0x5c, &bdsm);
+	pci_read_config_dword(pdev, 0x70, &bgsm);
+	physical_command = mboot_hypercall(MBOOT_HYPERCALL_DEVICE_CONFIG_READ,
+					  frontend->info.requester, PCI_COMMAND, 0);
+	len += scnprintf(buf + len, PAGE_SIZE - len,
+		"GPU PROBE REPORT %s\n"
+		"id=%04x:%04x rev=%02x class=%06x command=%04x (guest shadow)\n"
+		"pci:v%08Xd%08Xsv%08Xsd%08Xbc%02Xsc%02Xi%02X\n"
+		"bound=%u driver=%s can_match=%u match_driver=%u\n",
+		pci_name(pdev), pdev->vendor, pdev->device, pdev->revision,
+		pdev->class, command, pdev->vendor, pdev->device,
+		pdev->subsystem_vendor, pdev->subsystem_device,
+		pdev->class >> 16, (pdev->class >> 8) & 0xff, pdev->class & 0xff,
+		device_is_bound(dev), dev_driver_string(dev), dev->can_match,
+		pdev->match_driver);
+	len += scnprintf(buf + len, PAGE_SIZE - len,
+		"i915_registered=%u physical_config=%lx (command=low16; error if >ffffffff)\n",
+		!!driver_find("i915", &pci_bus_type), physical_command);
+	if (pdev->vendor == PCI_VENDOR_ID_INTEL && frontend->info.requester == 0x10) {
+		struct mboot_pci_frontend *bridge = mboot_pci_find(0, 0);
+
+		if (bridge)
+			len += scnprintf(buf + len, PAGE_SIZE - len,
+				"host bridge BDSM=%08x BGSM=%08x TOLUD=%08x (raw)\n",
+				bridge->config[0xb0 / 4], bridge->config[0xb4 / 4],
+				bridge->config[0xbc / 4]);
+	}
+	for (i = 0; i <= 2; i += 2)
+		len += scnprintf(buf + len, PAGE_SIZE - len,
+			"BAR%u start=%llx size=%llx flags=%lx\n", i,
+			(unsigned long long)pci_resource_start(pdev, i),
+			(unsigned long long)pci_resource_len(pdev, i),
+			pci_resource_flags(pdev, i));
+	len += scnprintf(buf + len, PAGE_SIZE - len,
+		"OpRegion=%08x address_set=%u BDSM=%08x BGSM=%08x (raw)\n"
+		"IRQ transport=%s linux_irq=%u vectors=%u\n",
+		opregion, opregion && opregion != ~0U, bdsm, bgsm,
+		pci_msix_vec_count(pdev) > 0 ? "MSI-X" : "MSI", pdev->irq,
+		frontend->irq_count);
+	for (i = 0; i < frontend->irq_count; i++) {
+		int vector = mboot_arch_irq_vector(frontend->irqs[i]);
+
+		len += scnprintf(buf + len, PAGE_SIZE - len,
+			"IRQ%u linux=%d vector=%x\n", i, frontend->irqs[i],
+			vector < 0 ? 0 : vector);
+	}
+	{
+		int vector = mboot_arch_irq_vector(pdev->irq);
+
+		len += scnprintf(buf + len, PAGE_SIZE - len,
+			"PCI MSI_ENABLED=%u MSIX_ENABLED=%u CURRENT_IRQ=%u VECTOR=%x\n",
+			pdev->msi_enabled, pdev->msix_enabled, pdev->irq,
+			vector < 0 ? 0 : vector);
+	}
+	spin_lock_irqsave(&mboot_probe_lock, flags);
+	len += scnprintf(buf + len, PAGE_SIZE - len, "%s", frontend->probe_trace);
+	spin_unlock_irqrestore(&mboot_probe_lock, flags);
+	return len;
+}
+static DEVICE_ATTR_RO(gpu_probe);
+
+static void __init mboot_check_gpu_mmio(void)
+{
+	unsigned int index;
+	bool found = false;
+
+	for (index = 0; index < mboot_pci_device_count; index++) {
+		struct mboot_pci_frontend *device = &mboot_pci_devices[index];
+		struct pci_dev *pdev;
+		void __iomem *reg = NULL;
+		char report[768];
+		u16 command = 0;
+		u32 first = 0, second = 0;
+		u32 asls = 0;
+		int len;
+
+		if (device->info.class != PCI_BASE_CLASS_DISPLAY)
+			continue;
+		pdev = pci_get_domain_bus_and_slot(0, device->info.requester >> 8,
+						 device->info.requester & 0xff);
+		if (!pdev)
+			continue;
+		if (pdev->vendor != PCI_VENDOR_ID_INTEL || pdev->devfn != PCI_DEVFN(2, 0)) {
+			pci_dev_put(pdev);
+			continue;
+		}
+		found = true;
+		pci_read_config_word(pdev, PCI_COMMAND, &command);
+		pci_read_config_dword(pdev, 0xfc, &asls);
+		if ((command & PCI_COMMAND_MEMORY) &&
+		    (pci_resource_flags(pdev, 0) & IORESOURCE_MEM) &&
+		    pci_resource_len(pdev, 0) >= 0xa18c)
+			reg = ioremap(pci_resource_start(pdev, 0) + 0xa188, 4);
+		if (reg) {
+			first = readl(reg);
+			second = readl(reg);
+			iounmap(reg);
+		}
+		len = scnprintf(report, sizeof(report),
+			"GPU MMIO CHECK\nSTOPPED BEFORE I915 / NO KMS\n"
+			"BDF %s ID %04x:%04x REV %02x\n"
+			"LINUX COMMAND %04x ASLS %08x\n"
+			"LINUX BAR0 GPA %llx SIZE %llx FLAGS %lx\n"
+			"LINUX BAR2 GPA %llx SIZE %llx FLAGS %lx\n"
+			"LINUX FORCEWAKE_MT OFFSET 0000a188\n"
+			"LINUX READ_VALID %u VALUES %08x %08x\n",
+			pci_name(pdev), pdev->vendor, pdev->device, pdev->revision,
+			command, asls, (u64)pci_resource_start(pdev, 0),
+			(u64)pci_resource_len(pdev, 0), pci_resource_flags(pdev, 0),
+			(u64)pci_resource_start(pdev, 2),
+			(u64)pci_resource_len(pdev, 2), pci_resource_flags(pdev, 2),
+			!!reg, first, second);
+		mboot_console_write_buffer(report, len, MBOOT_CONSOLE_ERROR | 1);
+		pci_dev_put(pdev);
+	}
+	if (!found) {
+		const char *report = "GPU MMIO CHECK\nSTOPPED BEFORE I915 / NO KMS\nNO ASSIGNED INTEL GPU AT SLOT 02.0\n";
+		mboot_console_write_buffer(report, strlen(report), MBOOT_CONSOLE_ERROR | 1);
+	}
+}
+
+static void mboot_gpu_probe_report(struct pci_dev *pdev)
+{
+	char *report = (char *)get_zeroed_page(GFP_KERNEL);
+	ssize_t len;
+
+	if (!report)
+		return;
+	len = gpu_probe_show(&pdev->dev, NULL, report);
+	pr_info("mDriver: %s", report);
+	/* Existing error channel; never request a modeset or a scanout change. */
+	if (!device_is_bound(&pdev->dev))
+		mboot_console_write_buffer(report, len, MBOOT_CONSOLE_ERROR | 1);
+	free_page((unsigned long)report);
+}
+
+static int __init mboot_pci_load_config(struct mboot_pci_frontend *device)
+{
+	unsigned int offset;
+
+	for (offset = 0; offset < PCI_CFG_SPACE_SIZE; offset += 4) {
+		unsigned long value;
+
+		value = mboot_hypercall(MBOOT_HYPERCALL_DEVICE_CONFIG_READ,
+					device->info.requester, offset, 0);
+		if (value == MBOOT_HYPERCALL_INVALID_ARGUMENT || value > U32_MAX)
+			return -EIO;
+		device->config[offset / 4] = value;
+	}
+	if (mboot_pci_config_only(device) &&
+	    (device->config[PCI_VENDOR_ID / 4] & 0xffff) == PCI_VENDOR_ID_INTEL)
+		return mboot_arch_intel_stolen(device->config);
+	return 0;
+}
+
+static int __init mboot_pci_load_resources(struct mboot_pci_frontend *device)
+{
+	unsigned int index;
+
+	BUILD_BUG_ON(sizeof(struct mboot_pci_resource) != 32);
+	for (index = 0; index < MBOOT_PCI_MAX_BARS; index++) {
+		struct mboot_pci_resource *resource = &device->resources[index];
+		unsigned long result;
+		u32 attributes;
+
+		memset(resource, 0, sizeof(*resource));
+		result = mboot_hypercall(MBOOT_HYPERCALL_DEVICE_RESOURCE_QUERY,
+					 device->info.requester, index,
+					 virt_to_phys(resource));
+		if (result == MBOOT_HYPERCALL_INVALID_ARGUMENT)
+			break;
+		if (result ||
+		    !mboot_pci_resource_valid(resource, device->info.requester))
+			return -EIO;
+		attributes = device->config[PCI_BASE_ADDRESS_0 / 4 +
+					    resource->bar_index] &
+			     ~PCI_BASE_ADDRESS_MEM_MASK;
+		device->config[PCI_BASE_ADDRESS_0 / 4 + resource->bar_index] =
+			(resource->guest_address & PCI_BASE_ADDRESS_MEM_MASK) |
+			attributes;
+		if ((attributes & PCI_BASE_ADDRESS_MEM_TYPE_MASK) ==
+		    PCI_BASE_ADDRESS_MEM_TYPE_64)
+			device->config[PCI_BASE_ADDRESS_0 / 4 +
+				       resource->bar_index + 1] =
+				resource->guest_address >> 32;
+	}
+	device->resource_count = index;
+	return index ? 0 : -ENODEV;
+}
+
+static int __init mboot_pci_scan_bus(unsigned int bus_number)
+{
+	struct pci_bus *bus;
+	void *sysdata;
+	unsigned int index;
+	bool found = false;
+	LIST_HEAD(resources);
+
+	sysdata = mboot_arch_pci_data(bus_number);
+	if (IS_ERR(sysdata))
+		return PTR_ERR(sysdata);
+
+	for (index = 0; index < mboot_pci_device_count; index++) {
+		struct mboot_pci_frontend *device = &mboot_pci_devices[index];
+		unsigned int resource_index;
+
+		if (device->info.requester >> 8 != bus_number)
+			continue;
+		for (resource_index = 0;
+		     resource_index < device->resource_count; resource_index++) {
+			const struct mboot_pci_resource *resource =
+				&device->resources[resource_index];
+			u32 attributes = device->config[PCI_BASE_ADDRESS_0 / 4 +
+							 resource->bar_index];
+			bool prefetch = attributes & PCI_BASE_ADDRESS_MEM_PREFETCH;
+			struct resource *window =
+				&mboot_pci_bus_windows[bus_number][prefetch];
+			resource_size_t end = resource->guest_address +
+					      resource->length - 1;
+
+			if (!window->flags || resource->guest_address < window->start)
+				window->start = resource->guest_address;
+			if (!window->flags || end > window->end)
+				window->end = end;
+			window->flags = IORESOURCE_MEM | IORESOURCE_PCI_FIXED |
+				(prefetch ? IORESOURCE_PREFETCH : 0);
+			window->name = prefetch ? "mBoot PCI prefetchable MMIO" :
+						  "mBoot PCI MMIO";
+			found = true;
+		}
+	}
+	if (!found) {
+		kfree(sysdata);
+		return -ENODEV;
+	}
+	for (index = 0; index < ARRAY_SIZE(mboot_pci_bus_windows[bus_number]); index++)
+		if (mboot_pci_bus_windows[bus_number][index].flags)
+			pci_add_resource(&resources,
+					 &mboot_pci_bus_windows[bus_number][index]);
+	bus = pci_scan_root_bus(NULL, bus_number, &mboot_pci_ops, sysdata,
+				&resources);
+	if (!bus) {
+		pci_free_resource_list(&resources);
+		kfree(sysdata);
+		return -ENOMEM;
+	}
+	pci_bus_claim_resources(bus);
+	mboot_pci_buses[bus_number] = bus;
+	return 0;
+}
+
+static int __init mboot_pci_publish_failure(struct mboot_pci_frontend *device,
+					  const char *stage, int error,
+					  unsigned long detail)
+{
+	char report[2048];
+	struct pci_dev *pdev;
+	unsigned int index;
+	u32 identity = device->config[PCI_VENDOR_ID / 4];
+	u32 class_rev = device->config[PCI_CLASS_REVISION / 4];
+	int len;
+
+	len = scnprintf(report, sizeof(report),
+		"PCI PROBE REPORT\nSTAGE %s ERRNO %d DETAIL %lx\n"
+		"BDF %02x:%02x.%u REQUESTER %04x\n"
+		"ID %04x:%04x REV %02x CLASS %06x COMMAND %04x\n"
+		"IRQ COUNT %u IRQ0 %d IRQ1 %d STATE %u\n",
+		stage, error, detail, device->info.requester >> 8,
+		(device->info.requester >> 3) & 31, device->info.requester & 7,
+		device->info.requester, identity & 0xffff, identity >> 16,
+		class_rev & 0xff, class_rev >> 8,
+		device->config[PCI_COMMAND / 4] & 0xffff,
+		device->irq_count, device->irqs[0], device->irqs[1], device->info.state);
+	pdev = pci_get_domain_bus_and_slot(0, device->info.requester >> 8,
+					 device->info.requester & 0xff);
+	if (pdev) {
+		len += scnprintf(report + len, sizeof(report) - len,
+			"PCI IRQ %u MSI CAP %x MSIX CAP %x MSIX COUNT %d\n",
+			pdev->irq, pdev->msi_cap, pdev->msix_cap, pci_msix_vec_count(pdev));
+	} else {
+		len += scnprintf(report + len, sizeof(report) - len,
+			"PCI DEVICE NOT ENUMERATED\n");
+	}
+	for (index = 0; index < device->resource_count; index++) {
+		const struct mboot_pci_resource *resource = &device->resources[index];
+
+		len += scnprintf(report + len, sizeof(report) - len,
+			"BAR%u EXPECT START %llx SIZE %llx FLAGS %x\n",
+			resource->bar_index, resource->guest_address,
+			resource->length, resource->flags);
+		if (pdev) {
+			const struct resource *actual = &pdev->resource[resource->bar_index];
+
+			len += scnprintf(report + len, sizeof(report) - len,
+				"BAR%u ACTUAL START %llx SIZE %llx FLAGS %lx\n",
+				resource->bar_index, (unsigned long long)actual->start,
+				(unsigned long long)resource_size(actual), actual->flags);
+		}
+	}
+	if (pdev)
+		pci_dev_put(pdev);
+	/* One complete report, never a repeated retry or a modeset request. */
+	mboot_console_write_buffer(report, len, MBOOT_CONSOLE_ERROR | 1);
+	pr_err("mDriver: PCI publication failed: %s requester=%04x errno=%d detail=%lx\n",
+		stage, device->info.requester, error, detail);
+	return error;
+}
+
+static int __init mboot_pci_publish_frontend(void)
+{
+	unsigned int active = 0;
+	unsigned int resource_count = 0;
+	unsigned int index;
+	unsigned int pass;
+
+	for (index = 0; index < mboot_pci_device_count; index++) {
+		struct mboot_pci_frontend *device = &mboot_pci_devices[index];
+		u8 bus = device->info.requester >> 8;
+		int error;
+
+		mboot_boot_device_error("SCAN", device->info.requester);
+		if (mboot_pci_buses[bus])
+			continue;
+		error = mboot_pci_scan_bus(bus);
+		if (error)
+			return mboot_pci_publish_failure(device, "SCAN BUS", error, bus);
+		mboot_boot_device_error("SCANNED", device->info.requester);
+	}
+	for (index = 0; index < mboot_pci_device_count; index++) {
+		struct mboot_pci_frontend *device = &mboot_pci_devices[index];
+		struct pci_dev *pdev;
+		int config_vector;
+		int queue_vector;
+		unsigned int resource_index;
+		unsigned long result;
+		int msix_vectors;
+		u8 bus = device->info.requester >> 8;
+		u8 devfn = device->info.requester & 0xff;
+
+		if (mboot_pci_config_only(device))
+			continue;
+		mboot_boot_device_error("IRQ", device->info.requester);
+		pdev = pci_get_domain_bus_and_slot(0, bus, devfn);
+		if (!pdev)
+			return mboot_pci_publish_failure(device, "IRQ LOOKUP", -ENODEV, 0);
+		msix_vectors = pci_msix_vec_count(pdev);
+		if (msix_vectors < 1 && !pdev->msi_cap) {
+			pci_dev_put(pdev);
+			return mboot_pci_publish_failure(device, "NO MSI", -ENODEV, msix_vectors);
+		}
+		device->irq_count = msix_vectors >= 2 ? 2 : 1;
+		device->irqs[0] = mboot_irq_alloc(device, device->irq_count);
+		if (device->irqs[0] < 0) {
+			pci_dev_put(pdev);
+			return mboot_pci_publish_failure(device, "IRQ ALLOC", device->irqs[0], device->irq_count);
+		}
+		device->irqs[1] = device->irq_count == 2 ? device->irqs[0] + 1 : 0;
+		config_vector = mboot_arch_irq_vector(device->irqs[0]);
+		queue_vector = device->irq_count == 2 ? mboot_arch_irq_vector(device->irqs[1]) : -EINVAL;
+		if (config_vector < 0 || config_vector > 0xff ||
+		    (device->irq_count == 2 &&
+		     (queue_vector < 0 || queue_vector > 0xff ||
+		      config_vector == queue_vector))) {
+			pci_dev_put(pdev);
+			irq_domain_free_irqs(device->irqs[0], device->irq_count);
+			return mboot_pci_publish_failure(device, "IRQ VECTOR", -EIO, 0);
+		}
+		pdev->irq = device->irqs[0];
+		for (resource_index = 0;
+		     resource_index < device->resource_count; resource_index++) {
+			const struct mboot_pci_resource *resource =
+				&device->resources[resource_index];
+			struct resource *linux_resource =
+				&pdev->resource[resource->bar_index];
+
+			if (linux_resource->start != resource->guest_address ||
+			    resource_size(linux_resource) != resource->length) {
+				pci_dev_put(pdev);
+				return mboot_pci_publish_failure(device, "BAR MATCH", -EIO, resource->bar_index);
+			}
+			resource_count++;
+		}
+		pci_dev_put(pdev);
+		result = mboot_hypercall(MBOOT_HYPERCALL_IRQ_MASK,
+					 config_vector, 1, 0);
+		if (result)
+			return mboot_pci_publish_failure(device, "MASK IRQ0", -EIO, result);
+		if (device->irq_count == 2) {
+			result = mboot_hypercall(MBOOT_HYPERCALL_IRQ_MASK,
+						 queue_vector, 1, 0);
+			if (result)
+				return mboot_pci_publish_failure(device, "MASK IRQ1", -EIO, result);
+		}
+		mboot_boot_device_error("ACTIVATE", device->info.requester);
+		result = mboot_hypercall(MBOOT_HYPERCALL_DEVICE_ACTIVATE,
+					 device->info.requester,
+					 config_vector,
+					 queue_vector < 0 ? 0 : queue_vector);
+		if (result)
+			return mboot_pci_publish_failure(device, "ACTIVATE", -EIO, result);
+		mboot_boot_device_error("ACTIVE", device->info.requester);
+		device->info.state = MBOOT_PCI_STATE_ACTIVE;
+		if (device->irq_count == 2)
+			pr_info("mDriver: PCI requester %04x uses config IRQ %d vector %#x, queue IRQ %d vector %#x\n",
+				device->info.requester, device->irqs[0],
+				config_vector, device->irqs[1],
+				queue_vector);
+		else
+			pr_info("mDriver: PCI requester %04x uses shared %s IRQ %d vector %#x\n",
+				device->info.requester,
+				msix_vectors == 1 ? "MSI-X" : "MSI",
+				device->irqs[0], config_vector);
+		active++;
+	}
+	pr_info("mDriver: mBoot PCI frontend ready: %u devices, %u resources, %u active\n",
+		mboot_pci_device_count, resource_count, active);
+	mboot_boot_device_error("PCI BIND", mboot_pci_devices[0].info.requester);
+	/*
+	 * Publish display controllers last.  Once a native GPU driver binds,
+	 * the firmware framebuffer no longer belongs to this diagnostic path.
+	 */
+	for (pass = 0; pass < 2; pass++) {
+		for (index = 0; index < mboot_pci_device_count; index++) {
+			struct mboot_pci_frontend *device = &mboot_pci_devices[index];
+			bool display = device->info.class == PCI_BASE_CLASS_DISPLAY;
+			u8 bus = device->info.requester >> 8;
+			u8 devfn = device->info.requester & 0xff;
+			struct pci_dev *pdev;
+
+			if (mboot_pci_config_only(device) ||
+			    display != (pass == 1))
+				continue;
+			mboot_boot_device_error(display ? "GPU PROBE" : "BIND",
+						device->info.requester);
+			pdev = pci_get_domain_bus_and_slot(0, bus, devfn);
+			if (!pdev)
+				return mboot_pci_publish_failure(device, "BIND LOOKUP", -ENODEV, 0);
+			if (display) {
+				int error = device_create_file(&pdev->dev, &dev_attr_gpu_probe);
+
+				if (error)
+					pci_warn(pdev, "gpu_probe sysfs failed: %d\n", error);
+				if (atomic_read(&mboot_gpu_probe_gate) == 1) {
+					pci_dev_put(pdev);
+					continue;
+				}
+			}
+			if (!display && atomic_read(&mboot_gpu_probe_gate) == 1) {
+				char page[256];
+
+				scnprintf(page, sizeof(page),
+					  "DISPLAY\nMDRIVER PCI BIND ENTER\n%04x %04x:%04x CLASS %06x IRQ %u",
+					  device->info.requester, pdev->vendor, pdev->device,
+					  pdev->class, pdev->irq);
+				mboot_boot_status(page);
+			}
+			pci_bus_add_device(pdev);
+			device->driver_published = true;
+			if (!display && atomic_read(&mboot_gpu_probe_gate) == 1) {
+				char page[256];
+
+				scnprintf(page, sizeof(page),
+					  "DISPLAY\nMDRIVER PCI BIND RETURN\n%04x DRIVER %s BOUND %u",
+					  device->info.requester,
+					  pdev->dev.driver ? pdev->dev.driver->name : "NONE",
+					  device_is_bound(&pdev->dev));
+				mboot_boot_status(page);
+			}
+			if (display)
+				mboot_gpu_probe_report(pdev);
+			device->driver_matched = pdev->dev.can_match;
+			device->driver_bound = device_is_bound(&pdev->dev);
+			pci_dev_put(pdev);
+			if (!display)
+				mboot_boot_device_error("BOUND", device->info.requester);
+		}
+	}
+	return 0;
+}
+
+static int __init mboot_query_and_claim_devices(void)
+{
+	struct mboot_pci_device_info *info;
+	unsigned int claimed = 0;
+	unsigned int index;
+
+	BUILD_BUG_ON(sizeof(*info) != 64);
+	info = kzalloc(sizeof(*info), GFP_KERNEL);
+	if (!info) {
+		mboot_boot_device_error("ALLOC", 0);
+		return -ENOMEM;
+	}
+	for (index = 0; index < MBOOT_MAX_PCI_DEVICES; index++) {
+		unsigned long result;
+
+		memset(info, 0, sizeof(*info));
+		result = mboot_hypercall(MBOOT_HYPERCALL_DEVICE_QUERY, index,
+					 virt_to_phys(info), sizeof(*info));
+		if (result == MBOOT_HYPERCALL_INVALID_ARGUMENT)
+			break;
+		if (result || !mboot_pci_info_valid(info)) {
+			pr_err("mDriver: invalid PCI inventory entry %u\n", index);
+			mboot_boot_device_error("QUERY", index);
+			kfree(info);
+			return -EIO;
+		}
+
+		pr_info("mDriver: PCI %02x:%02x.%u class %02x:%02x state %u%s\n",
+			info->requester >> 8, (info->requester >> 3) & 0x1f,
+			info->requester & 0x7, info->class, info->subclass, info->state,
+			info->flags & MBOOT_PCI_FLAG_CLAIMABLE ? " claimable" : "");
+		if (!(info->flags & MBOOT_PCI_FLAG_CLAIMABLE)) {
+			if (info->requester == 0 &&
+			    info->class == PCI_BASE_CLASS_BRIDGE &&
+			    info->subclass == 0 &&
+			    info->flags & MBOOT_PCI_FLAG_READ_ONLY) {
+				if (mboot_pci_device_count == MBOOT_MAX_ASSIGNED_DEVICES) {
+					kfree(info);
+					return -ENOSPC;
+				}
+				mboot_pci_devices[mboot_pci_device_count].info = *info;
+				if (mboot_pci_load_config(
+					    &mboot_pci_devices[mboot_pci_device_count])) {
+					kfree(info);
+					return -EIO;
+				}
+				mboot_pci_device_count++;
+			}
+			continue;
+		}
+
+		result = mboot_hypercall(MBOOT_HYPERCALL_DEVICE_CLAIM,
+					 info->requester, 0, 0);
+		if (result) {
+			pr_err("mDriver: PCI requester %04x claim failed: %lu\n",
+			       info->requester, result);
+			mboot_boot_device_error("CLAIM", info->requester);
+			kfree(info);
+			return -EIO;
+		}
+
+		memset(info, 0, sizeof(*info));
+		result = mboot_hypercall(MBOOT_HYPERCALL_DEVICE_QUERY, index,
+					 virt_to_phys(info), sizeof(*info));
+		if (result || !mboot_pci_info_valid(info) ||
+		    info->state != MBOOT_PCI_STATE_CLAIMED_DISABLED) {
+			pr_err("mDriver: PCI entry %u did not enter claimed-disabled\n",
+			       index);
+			mboot_boot_device_error("STATE", info->requester);
+			kfree(info);
+			return -EIO;
+		}
+		if (mboot_pci_device_count == MBOOT_MAX_ASSIGNED_DEVICES) {
+			mboot_boot_device_error("LIMIT", info->requester);
+			kfree(info);
+			return -ENOSPC;
+		}
+		mboot_pci_devices[mboot_pci_device_count].info = *info;
+		if (mboot_pci_load_config(&mboot_pci_devices[mboot_pci_device_count])) {
+			mboot_boot_device_error("CONFIG", info->requester);
+			kfree(info);
+			return -EIO;
+		}
+		if (mboot_pci_load_resources(&mboot_pci_devices[mboot_pci_device_count])) {
+			mboot_boot_device_error("BAR", info->requester);
+			kfree(info);
+			return -EIO;
+		}
+		mboot_pci_device_count++;
+		claimed++;
+	}
+
+	pr_info("mDriver: mBoot PCI inventory ready: %u devices, %u claimed\n",
+		index, claimed);
+	kfree(info);
+	return 0;
+}
