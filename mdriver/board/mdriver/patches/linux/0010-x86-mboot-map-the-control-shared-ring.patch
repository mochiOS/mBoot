From: mochiOS Developers <developers@mochios.dev>
Subject: [PATCH] x86/mboot: map the control shared ring

Discover the Hardware Domain Grant window through CPUID and find the
System Domain's control Grant through the target-scoped query hypercall.
Map one page, exchange a checked request and response, then unmap it
before reporting the Hardware Domain ready.

Signed-off-by: mochiOS Developers <developers@mochios.dev>
---

--- a/arch/x86/kernel/cpu/mboot.c
+++ b/arch/x86/kernel/cpu/mboot.c
@@ -5,6 +5,7 @@
 #include <linux/build_bug.h>
 #include <linux/errno.h>
 #include <linux/init.h>
+#include <linux/io.h>
 #include <linux/irq.h>
 #include <linux/irqdomain.h>
 #include <linux/ioport.h>
@@ -28,11 +29,14 @@
 #define MBOOT_HYPERCALL_READY 3
 #define MBOOT_HYPERCALL_EVENT_SEND 5
 #define MBOOT_HYPERCALL_EVENT_WAIT 6
+#define MBOOT_HYPERCALL_GRANT_MAP 8
+#define MBOOT_HYPERCALL_GRANT_UNMAP 9
 #define MBOOT_HYPERCALL_DEVICE_QUERY 16
 #define MBOOT_HYPERCALL_DEVICE_CLAIM 17
 #define MBOOT_HYPERCALL_DEVICE_CONFIG_READ 19
 #define MBOOT_HYPERCALL_DEVICE_RESOURCE_QUERY 20
 #define MBOOT_HYPERCALL_DEVICE_ACTIVATE 21
+#define MBOOT_HYPERCALL_GRANT_QUERY 22
 #define MBOOT_HYPERCALL_IRQ_MASK 13
 #define MBOOT_HYPERCALL_INVALID_ARGUMENT (~0UL - 1)
 #define MBOOT_PCI_STATE_QUARANTINED 1
@@ -49,6 +53,42 @@
 #define MBOOT_PCI_RESOURCE_WRITABLE BIT(1)
 #define MBOOT_CONTROL_PORT 1
 #define MBOOT_CONTROL_IRQ_PORT 2
+#define MBOOT_CONTROL_RING_PORT 3
+#define MBOOT_CONTROL_RING_MAGIC 0x474e524948434f4dULL
+#define MBOOT_CONTROL_RING_VERSION 1
+#define MBOOT_CONTROL_RING_SLOTS 31
+#define MBOOT_CONTROL_RING_PAYLOAD_SIZE 48
+#define MBOOT_CONTROL_RING_GENERATION 1
+#define MBOOT_CONTROL_REQUEST_KIND 1
+#define MBOOT_CONTROL_RESPONSE_KIND 2
+#define MBOOT_CONTROL_REQUEST_ID 1
+
+struct mboot_ring_header {
+	u64 magic;
+	u32 version;
+	u32 slot_count;
+	u32 request_producer;
+	u32 request_consumer;
+	u32 response_producer;
+	u32 response_consumer;
+	u64 generation;
+	u64 reserved[3];
+};
+
+struct mboot_ring_message {
+	u16 kind;
+	u16 flags;
+	u32 len;
+	u64 request_id;
+	u8 payload[MBOOT_CONTROL_RING_PAYLOAD_SIZE];
+};
+
+struct mboot_ring_page {
+	struct mboot_ring_header header;
+	struct mboot_ring_message requests[MBOOT_CONTROL_RING_SLOTS];
+	struct mboot_ring_message responses[MBOOT_CONTROL_RING_SLOTS];
+	u8 reserved[64];
+};
 
 struct mboot_pci_device_info {
 	u16 requester;
@@ -634,6 +674,101 @@
 	return 0;
 }
 
+static bool __init mboot_control_ring_valid(struct mboot_ring_page *ring)
+{
+	return READ_ONCE(ring->header.magic) == MBOOT_CONTROL_RING_MAGIC &&
+	       READ_ONCE(ring->header.version) == MBOOT_CONTROL_RING_VERSION &&
+	       READ_ONCE(ring->header.slot_count) == MBOOT_CONTROL_RING_SLOTS &&
+	       READ_ONCE(ring->header.generation) == MBOOT_CONTROL_RING_GENERATION &&
+	       !memchr_inv(ring->header.reserved, 0,
+			   sizeof(ring->header.reserved));
+}
+
+static int __init mboot_control_ring_reply(void)
+{
+	struct mboot_ring_message response = {
+		.kind = MBOOT_CONTROL_RESPONSE_KIND,
+		.len = 5,
+		.request_id = MBOOT_CONTROL_REQUEST_ID,
+		.payload = "ready",
+	};
+	struct mboot_ring_message request;
+	struct mboot_ring_page *ring;
+	unsigned long grant_ref;
+	unsigned long result;
+	u64 grant_window_start;
+	u64 grant_window_size;
+	u32 producer;
+	u32 consumer;
+	u32 eax, ebx, ecx, edx;
+
+	BUILD_BUG_ON(sizeof(struct mboot_ring_header) != 64);
+	BUILD_BUG_ON(sizeof(struct mboot_ring_message) != 64);
+	BUILD_BUG_ON(sizeof(struct mboot_ring_page) != PAGE_SIZE);
+
+	result = mboot_hypercall(MBOOT_HYPERCALL_EVENT_WAIT, 0, 0, 0);
+	if (result != MBOOT_CONTROL_RING_PORT)
+		return -EIO;
+	cpuid(0x40000002, &eax, &ebx, &ecx, &edx);
+	grant_window_start = (u64)ebx << 32 | eax;
+	grant_window_size = (u64)edx << 32 | ecx;
+	if (!grant_window_start || grant_window_start & (PAGE_SIZE - 1) ||
+	    grant_window_size < PAGE_SIZE)
+		return -EIO;
+	grant_ref = mboot_hypercall(MBOOT_HYPERCALL_GRANT_QUERY, 0, 0, 0);
+	if (grant_ref == MBOOT_HYPERCALL_INVALID_ARGUMENT || grant_ref > U32_MAX)
+		return -EIO;
+	result = mboot_hypercall(MBOOT_HYPERCALL_GRANT_MAP, grant_ref,
+				 grant_window_start, 0);
+	if (result)
+		return -EIO;
+	ring = memremap(grant_window_start, PAGE_SIZE, MEMREMAP_WB);
+	if (!ring)
+		goto unmap;
+	if (!mboot_control_ring_valid(ring))
+		goto unmap_memory;
+
+	/* Pair with the System Domain's request publication. */
+	producer = smp_load_acquire(&ring->header.request_producer);
+	consumer = READ_ONCE(ring->header.request_consumer);
+	if (producer == consumer || producer - consumer > MBOOT_CONTROL_RING_SLOTS)
+		goto unmap_memory;
+	memcpy(&request, &ring->requests[consumer % MBOOT_CONTROL_RING_SLOTS],
+	       sizeof(request));
+	if (request.kind != MBOOT_CONTROL_REQUEST_KIND || request.flags ||
+	    request.len != 5 || request.request_id != MBOOT_CONTROL_REQUEST_ID ||
+	    memcmp(request.payload, "probe", 5))
+		goto unmap_memory;
+	/* Finish reading the request before returning its slot. */
+	smp_store_release(&ring->header.request_consumer, consumer + 1);
+
+	producer = READ_ONCE(ring->header.response_producer);
+	/* Pair with the System Domain returning a response slot. */
+	consumer = smp_load_acquire(&ring->header.response_consumer);
+	if (producer - consumer >= MBOOT_CONTROL_RING_SLOTS)
+		goto unmap_memory;
+	memcpy(&ring->responses[producer % MBOOT_CONTROL_RING_SLOTS], &response,
+	       sizeof(response));
+	/* Publish the response only after its contents are visible. */
+	smp_store_release(&ring->header.response_producer, producer + 1);
+	memunmap(ring);
+	result = mboot_hypercall(MBOOT_HYPERCALL_GRANT_UNMAP, grant_ref, 0, 0);
+	if (result)
+		return -EIO;
+	result = mboot_hypercall(MBOOT_HYPERCALL_EVENT_SEND,
+				 MBOOT_CONTROL_RING_PORT, 0, 0);
+	if (result)
+		return -EIO;
+	pr_info("mDriver: mBoot control Shared Ring ready\n");
+	return 0;
+
+unmap_memory:
+	memunmap(ring);
+unmap:
+	mboot_hypercall(MBOOT_HYPERCALL_GRANT_UNMAP, grant_ref, 0, 0);
+	return -EIO;
+}
+
 static int __init mboot_report_ready(void)
 {
 	unsigned long result;
@@ -657,6 +792,8 @@
 	if (result != MBOOT_CONTROL_IRQ_PORT)
 		return -EIO;
 	pr_info("mDriver: mBoot control Event Channel ready\n");
+	if (mboot_control_ring_reply())
+		return -EIO;
 	result = mboot_hypercall(MBOOT_HYPERCALL_READY, 0, 0, 0);
 
 	if (result)

