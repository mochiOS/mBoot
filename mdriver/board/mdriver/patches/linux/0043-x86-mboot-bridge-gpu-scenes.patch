 	u16 version;
 	u16 operation;
@@ -1058,6 +1076,17 @@
 static bool mboot_display_shared_surface;
 static u32 mboot_display_device_id;
 static struct fb_info *mboot_display_info;
+static phys_addr_t mboot_display_buffer_phys;
+static DECLARE_WAIT_QUEUE_HEAD(mboot_gpu_request_wait);
+static DECLARE_WAIT_QUEUE_HEAD(mboot_gpu_response_wait);
+static DEFINE_MUTEX(mboot_gpu_lock);
+static u64 mboot_gpu_generation;
+static u32 mboot_gpu_scene_length;
+static int mboot_gpu_response_status;
+static bool mboot_gpu_open;
+static bool mboot_gpu_pending;
+static bool mboot_gpu_delivered;
+static bool mboot_gpu_responded;
 static bool mboot_block_queue_verified;
 static u64 mboot_control_device_kind(const struct mboot_pci_device_info *info);
 
@@ -1139,6 +1168,7 @@
 		    (MBOOT_DISPLAY_SURFACE_FIRST_PAGE +
