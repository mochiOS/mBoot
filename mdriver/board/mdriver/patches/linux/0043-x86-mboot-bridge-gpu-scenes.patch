+static int mboot_gpu_submit(const struct mboot_control_request *request)
+{
+	long waited;
+	int status;
+
+	if (!mboot_display_shared_surface || !mboot_display_buffer ||
+	    request->device_id != mboot_display_device_id ||
+	    !request->arguments[0] ||
+	    request->arguments[0] > mboot_display_buffer_size ||
+	    request->arguments[1] || request->arguments[2] || request->arguments[3])
+		return -EINVAL;
+	waited = wait_event_interruptible_timeout(mboot_gpu_request_wait,
+		READ_ONCE(mboot_gpu_open), msecs_to_jiffies(60000));
+	if (waited <= 0)
+		return waited ? waited : -ETIMEDOUT;
+	mutex_lock(&mboot_gpu_lock);
+	if (!mboot_gpu_open || mboot_gpu_pending) {
+		mutex_unlock(&mboot_gpu_lock);
+		return -ENODEV;
+	}
+	mboot_gpu_generation++;
+	if (!mboot_gpu_generation)
+		mboot_gpu_generation++;
+	mboot_gpu_scene_length = request->arguments[0];
+	mboot_gpu_response_status = -EIO;
+	mboot_gpu_pending = true;
+	mboot_gpu_delivered = false;
+	mboot_gpu_responded = false;
+	wake_up_interruptible(&mboot_gpu_request_wait);
+	mutex_unlock(&mboot_gpu_lock);
+
+	waited = wait_event_interruptible_timeout(mboot_gpu_response_wait,
+		READ_ONCE(mboot_gpu_responded), msecs_to_jiffies(5000));
+	mutex_lock(&mboot_gpu_lock);
+	status = waited > 0 && mboot_gpu_responded ?
+		mboot_gpu_response_status : -ETIMEDOUT;
+	mboot_gpu_pending = false;
+	mboot_gpu_delivered = false;
+	mboot_gpu_responded = false;
+	mutex_unlock(&mboot_gpu_lock);
+	return status;
+}
+
+static int mboot_gpu_open_device(struct inode *inode, struct file *file)
+{
+	mutex_lock(&mboot_gpu_lock);
+	if (mboot_gpu_open) {
+		mutex_unlock(&mboot_gpu_lock);
+		return -EBUSY;
+	}
+	mboot_gpu_open = true;
+	wake_up_interruptible(&mboot_gpu_request_wait);
+	mutex_unlock(&mboot_gpu_lock);
+	return 0;
+}
+
+static int mboot_gpu_release_device(struct inode *inode, struct file *file)
+{
+	mutex_lock(&mboot_gpu_lock);
+	mboot_gpu_open = false;
+	if (mboot_gpu_pending) {
+		mboot_gpu_response_status = -ENODEV;
+		mboot_gpu_responded = true;
+		wake_up_interruptible(&mboot_gpu_response_wait);
+	}
+	mutex_unlock(&mboot_gpu_lock);
+	return 0;
+}
+
+static ssize_t mboot_gpu_read(struct file *file, char __user *buffer,
+			      size_t length, loff_t *offset)
+{
+	struct mboot_gpu_request request;
+	int result;
+
+	if (length < sizeof(request))
+		return -EINVAL;
+	result = wait_event_interruptible(mboot_gpu_request_wait,
+		READ_ONCE(mboot_gpu_pending) && !READ_ONCE(mboot_gpu_delivered));
+	if (result)
+		return result;
+	mutex_lock(&mboot_gpu_lock);
+	if (!mboot_gpu_pending || mboot_gpu_delivered) {
+		mutex_unlock(&mboot_gpu_lock);
+		return -EAGAIN;
+	}
+	request.generation = mboot_gpu_generation;
+	request.buffer_size = mboot_display_buffer_size;
+	request.scene_length = mboot_gpu_scene_length;
+	request.reserved = 0;
+	mboot_gpu_delivered = true;
+	mutex_unlock(&mboot_gpu_lock);
+	if (copy_to_user(buffer, &request, sizeof(request)))
+		return -EFAULT;
+	return sizeof(request);
+}
+
+static ssize_t mboot_gpu_write(struct file *file, const char __user *buffer,
+			       size_t length, loff_t *offset)
+{
+	struct mboot_gpu_response response;
+
+	if (length != sizeof(response) || copy_from_user(&response, buffer, sizeof(response)))
+		return length == sizeof(response) ? -EFAULT : -EINVAL;
+	mutex_lock(&mboot_gpu_lock);
+	if (!mboot_gpu_pending || !mboot_gpu_delivered || mboot_gpu_responded ||
+	    response.generation != mboot_gpu_generation || response.reserved) {
+		mutex_unlock(&mboot_gpu_lock);
+		return -EINVAL;
+	}
+	mboot_gpu_response_status = response.status;
+	mboot_gpu_responded = true;
+	wake_up_interruptible(&mboot_gpu_response_wait);
+	mutex_unlock(&mboot_gpu_lock);
+	return sizeof(response);
+}
+
+static int mboot_gpu_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	unsigned long size = vma->vm_end - vma->vm_start;
+
+	if (!mboot_display_buffer_phys || !mboot_display_buffer_size ||
+	    vma->vm_pgoff || size > PAGE_ALIGN(mboot_display_buffer_size))
+		return -ENODEV;
+	return remap_pfn_range(vma, vma->vm_start,
+		mboot_display_buffer_phys >> PAGE_SHIFT, size, vma->vm_page_prot);
+}
+
+static const struct file_operations mboot_gpu_fops = {
+	.owner = THIS_MODULE,
+	.open = mboot_gpu_open_device,
+	.release = mboot_gpu_release_device,
+	.read = mboot_gpu_read,
+	.write = mboot_gpu_write,
+	.mmap = mboot_gpu_mmap,
+	.llseek = noop_llseek,
+};
+
+static struct miscdevice mboot_gpu_device = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = "mboot-gpu",
+	.fops = &mboot_gpu_fops,
+	.mode = 0600,
+};
+
 static bool mboot_device_descends_from(struct device *device,
 				       const struct device *ancestor)
 {
@@ -3018,6 +3190,12 @@
 		response->status = mboot_display_present(request) ?
 			MBOOT_CONTROL_STATUS_IO_ERROR : MBOOT_CONTROL_STATUS_OK;
 		return;
+	case MBOOT_CONTROL_PRESENT_GPU_SCENE:
+		if (!mboot_control_active)
+			return;
+		response->status = mboot_gpu_submit(request) ?
+			MBOOT_CONTROL_STATUS_IO_ERROR : MBOOT_CONTROL_STATUS_OK;
+		return;
 	case MBOOT_CONTROL_CLOSE_DISPLAY:
 		if (!mboot_control_active ||
 		    request->device_id != mboot_display_device_id ||
@@ -3340,6 +3518,12 @@
 	return -EIO;
 }
 
+static int __init mboot_gpu_device_init(void)
+{
+	return misc_register(&mboot_gpu_device);
+}
+device_initcall(mboot_gpu_device_init);
+
 static int mboot_finish_ready(void)
 {
 	unsigned long result;
