From: mochiOS developers
Subject: [PATCH] x86/mboot: retain PCI matching and GPU probe evidence

Record the initial attach return, PCI match, bus and driver probe results,
defer reasons, and i915 MMIO substage failures. Expose a bounded report in
sysfs and through the existing boot error console without changing scanout.

diff --git a/arch/x86/kernel/cpu/mboot.c b/arch/x86/kernel/cpu/mboot.c
--- a/arch/x86/kernel/cpu/mboot.c
+++ b/arch/x86/kernel/cpu/mboot.c
@@ -19,6 +19,7 @@
 #include <linux/kthread.h>
 #include <linux/miscdevice.h>
 #include <linux/mm.h>
+#include <linux/mboot_probe.h>
 #include <linux/numa.h>
 #include <linux/overflow.h>
 #include <linux/pci.h>
@@ -329,6 +330,8 @@
 	unsigned int irq_count;
 	bool driver_matched;
 	bool driver_bound;
+	char probe_trace[2048];
+	size_t probe_trace_len;
 };
 
 static struct mboot_pci_frontend mboot_pci_devices[MBOOT_MAX_ASSIGNED_DEVICES];
@@ -706,6 +709,126 @@
 	.write = mboot_pci_config_write,
 };
 
+static DEFINE_SPINLOCK(mboot_probe_lock);
+
+void mboot_gpu_probe_trace(struct device *dev, const char *event,
+			   const char *detail, int result)
+{
+	struct mboot_pci_frontend *frontend;
+	struct pci_dev *pdev;
+	unsigned long flags;
+	char line[192];
+	size_t len;
+
+	if (!dev_is_pci(dev))
+		return;
+	pdev = to_pci_dev(dev);
+	if (pdev->bus->ops != &mboot_pci_ops ||
+	    pdev->class >> 16 != PCI_BASE_CLASS_DISPLAY)
+		return;
+	frontend = mboot_pci_find(pdev->bus->number, pdev->devfn);
+	if (!frontend)
+		return;
+	len = scnprintf(line, sizeof(line), "%s %s rc=%d\n",
+			event, detail ?: "-", result);
+	/* Defer reasons can contain a trailing newline. Keep one event per line. */
+	for (size_t i = 0; i + 1 < len; i++)
+		if (line[i] < ' ' || line[i] > '~')
+			line[i] = ' ';
+	pr_info("mDriver GPU %s: %s", pci_name(pdev), line);
+	spin_lock_irqsave(&mboot_probe_lock, flags);
+	/* Preserve the first attempt; do not let readiness polling erase it. */
+	if (frontend->probe_trace_len + len < sizeof(frontend->probe_trace)) {
+		memcpy(frontend->probe_trace + frontend->probe_trace_len, line, len + 1);
+		frontend->probe_trace_len += len;
+	}
+	spin_unlock_irqrestore(&mboot_probe_lock, flags);
+}
+
+static ssize_t gpu_probe_show(struct device *dev,
+			      struct device_attribute *attr, char *buf)
+{
+	struct pci_dev *pdev = to_pci_dev(dev);
+	struct mboot_pci_frontend *frontend =
+		mboot_pci_find(pdev->bus->number, pdev->devfn);
+	unsigned long flags;
+	u32 opregion = 0, bdsm = 0, bgsm = 0;
+	u16 command = 0;
+	unsigned long physical_command;
+	size_t len = 0;
+	unsigned int i;
+
+	pci_read_config_word(pdev, PCI_COMMAND, &command);
+	pci_read_config_dword(pdev, 0xfc, &opregion);
+	pci_read_config_dword(pdev, 0x5c, &bdsm);
+	pci_read_config_dword(pdev, 0x70, &bgsm);
+	physical_command = mboot_hypercall(MBOOT_HYPERCALL_DEVICE_CONFIG_READ,
+					  frontend->info.requester, PCI_COMMAND, 0);
+	len += scnprintf(buf + len, PAGE_SIZE - len,
+		"GPU PROBE REPORT %s\n"
+		"id=%04x:%04x rev=%02x class=%06x command=%04x (guest shadow)\n"
+		"pci:v%08Xd%08Xsv%08Xsd%08Xbc%02Xsc%02Xi%02X\n"
+		"bound=%u driver=%s can_match=%u match_driver=%u\n",
+		pci_name(pdev), pdev->vendor, pdev->device, pdev->revision,
+		pdev->class, command, pdev->vendor, pdev->device,
+		pdev->subsystem_vendor, pdev->subsystem_device,
+		pdev->class >> 16, (pdev->class >> 8) & 0xff, pdev->class & 0xff,
+		device_is_bound(dev), dev_driver_string(dev), dev->can_match,
+		pdev->match_driver);
+	len += scnprintf(buf + len, PAGE_SIZE - len,
+		"i915_registered=%u physical_config=%lx (command=low16; error if >ffffffff)\n",
+		!!driver_find("i915", &pci_bus_type), physical_command);
+	if (pdev->vendor == PCI_VENDOR_ID_INTEL && frontend->info.requester == 0x10) {
+		struct mboot_pci_frontend *bridge = mboot_pci_find(0, 0);
+
+		if (bridge)
+			len += scnprintf(buf + len, PAGE_SIZE - len,
+				"host bridge BDSM=%08x BGSM=%08x TOLUD=%08x (raw)\n",
+				bridge->config[0xb0 / 4], bridge->config[0xb4 / 4],
+				bridge->config[0xbc / 4]);
+	}
+	for (i = 0; i <= 2; i += 2)
+		len += scnprintf(buf + len, PAGE_SIZE - len,
+			"BAR%u start=%llx size=%llx flags=%lx\n", i,
+			(unsigned long long)pci_resource_start(pdev, i),
+			(unsigned long long)pci_resource_len(pdev, i),
+			pci_resource_flags(pdev, i));
+	len += scnprintf(buf + len, PAGE_SIZE - len,
+		"OpRegion=%08x address_set=%u BDSM=%08x BGSM=%08x (raw)\n"
+		"IRQ transport=%s linux_irq=%u vectors=%u\n",
+		opregion, opregion && opregion != ~0U, bdsm, bgsm,
+		pci_msix_vec_count(pdev) > 0 ? "MSI-X" : "MSI", pdev->irq,
+		frontend->irq_count);
+	for (i = 0; i < frontend->irq_count; i++) {
+		struct irq_cfg *cfg = irq_cfg(frontend->irqs[i]);
+
+		len += scnprintf(buf + len, PAGE_SIZE - len,
+			"IRQ%u linux=%d vector=%x\n", i, frontend->irqs[i],
+			cfg ? cfg->vector : 0);
+	}
+	spin_lock_irqsave(&mboot_probe_lock, flags);
+	len += scnprintf(buf + len, PAGE_SIZE - len, "%s", frontend->probe_trace);
+	spin_unlock_irqrestore(&mboot_probe_lock, flags);
+	return len;
+}
+static DEVICE_ATTR_RO(gpu_probe);
+
+static void mboot_gpu_probe_report(struct pci_dev *pdev)
+{
+	char *report = (char *)get_zeroed_page(GFP_KERNEL);
+	ssize_t len;
+
+	if (!report)
+		return;
+	len = gpu_probe_show(&pdev->dev, NULL, report);
+	pr_info("mDriver: %s", report);
+	/* Existing error channel; never request a modeset or a scanout change. */
+	if (!device_is_bound(&pdev->dev))
+		mboot_hypercall(MBOOT_HYPERCALL_CONSOLE_WRITE,
+				virt_to_phys(report), len, MBOOT_CONSOLE_ERROR | 1);
+	free_page((unsigned long)report);
+}
+
 static int __init mboot_pci_load_config(struct mboot_pci_frontend *device)
 {
 	unsigned int offset;
@@ -947,6 +1070,13 @@
 			if (!pdev)
 				return -ENODEV;
 			pci_bus_add_device(pdev);
+			if (display) {
+				int error = device_create_file(&pdev->dev, &dev_attr_gpu_probe);
+
+				if (error)
+					pci_warn(pdev, "gpu_probe sysfs failed: %d\n", error);
+				mboot_gpu_probe_report(pdev);
+			}
 			device->driver_matched = pdev->dev.can_match;
 			device->driver_bound = device_is_bound(&pdev->dev);
 			pci_dev_put(pdev);
@@ -3736,15 +3866,14 @@
 			mboot_boot_device_error("GPU RETRY",
 						device->info.requester);
 			result = device_attach(&pdev->dev);
+			mboot_gpu_probe_trace(&pdev->dev, "attach-late", NULL, result);
 			pr_info("mDriver: display %04x reprobe result=%d\n",
 				device->info.requester, result);
 		}
 		device->driver_matched = pdev->dev.can_match;
 		device->driver_bound = device_is_bound(&pdev->dev);
+		mboot_gpu_probe_report(pdev);
 		pci_dev_put(pdev);
-		if (!device->driver_bound && !mboot_display_probe_error)
-			mboot_boot_device_error("GPU UNBOUND",
-						device->info.requester);
 	}
 }
 
