From: mochiOS developers
Subject: [PATCH] x86/mboot: gate first GPU probe on log receiver readiness

Allow the diagnostic hardware configuration to publish network controllers
before IP autoconfiguration, while keeping display drivers unpublished.
A root-only one-shot sysfs trigger releases the first GPU probe after the
userspace log relay has connected to its receiver. No synchronous reprobe
is attempted in this mode and no timeout changes display ownership.

diff --git a/arch/x86/kernel/cpu/mboot.c b/arch/x86/kernel/cpu/mboot.c
--- a/arch/x86/kernel/cpu/mboot.c
+++ b/arch/x86/kernel/cpu/mboot.c
@@ -330,6 +330,7 @@
 	unsigned int irq_count;
 	bool driver_matched;
 	bool driver_bound;
+	bool driver_published;
 	char probe_trace[2048];
 	size_t probe_trace_len;
 };
@@ -340,6 +341,17 @@
 static unsigned int mboot_pci_device_count;
 static struct irq_domain *mboot_irq_domain;
 
+/* 0: normal boot, 1: wait for log receiver, 2: receiver acknowledged. */
+static atomic_t mboot_gpu_probe_gate = ATOMIC_INIT(0);
+
+static int __init mboot_gpu_wait_for_log(char *value)
+{
+	if (value && *value)
+		atomic_set(&mboot_gpu_probe_gate, 1);
+	return 1;
+}
+__setup("mboot.log=", mboot_gpu_wait_for_log);
+
 static unsigned long mboot_hypercall(unsigned long number,
 				     unsigned long arg0, unsigned long arg1,
 				     unsigned long arg2);
@@ -1069,14 +1081,21 @@
 			pdev = pci_get_domain_bus_and_slot(0, bus, devfn);
 			if (!pdev)
 				return -ENODEV;
-			pci_bus_add_device(pdev);
 			if (display) {
 				int error = device_create_file(&pdev->dev, &dev_attr_gpu_probe);
 
 				if (error)
 					pci_warn(pdev, "gpu_probe sysfs failed: %d\n", error);
-				mboot_gpu_probe_report(pdev);
+				if (atomic_read(&mboot_gpu_probe_gate) == 1) {
+					mboot_gpu_probe_report(pdev);
+					pci_dev_put(pdev);
+					continue;
+				}
 			}
+			pci_bus_add_device(pdev);
+			device->driver_published = true;
+			if (display)
+				mboot_gpu_probe_report(pdev);
 			device->driver_matched = pdev->dev.can_match;
 			device->driver_bound = device_is_bound(&pdev->dev);
 			pci_dev_put(pdev);
@@ -3834,6 +3853,21 @@
 
 static void mboot_ready_workfn(struct work_struct *work);
 static DECLARE_DELAYED_WORK(mboot_ready_work, mboot_ready_workfn);
+
+static ssize_t mboot_gpu_probe_start_store(struct kobject *kobj,
+					  struct kobj_attribute *attr,
+					  const char *buf, size_t count)
+{
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	if (atomic_cmpxchg(&mboot_gpu_probe_gate, 1, 2) != 1)
+		return -EALREADY;
+	pr_info("mDriver: log receiver acknowledged; starting first GPU probe\n");
+	mod_delayed_work(system_wq, &mboot_ready_work, 0);
+	return count;
+}
+static struct kobj_attribute mboot_gpu_probe_start_attr =
+	__ATTR_WO(mboot_gpu_probe_start);
 static atomic_t mboot_ready_started = ATOMIC_INIT(0);
 static struct notifier_block mboot_fb_notifier;
 static bool mboot_display_reprobe_done;
@@ -3862,7 +3896,12 @@
 					       device->info.requester & 0xff);
 		if (!pdev)
 			continue;
-		if (!device_is_bound(&pdev->dev)) {
+		if (!device->driver_published) {
+			/* PCI drivers and the log transport are ready; publish once. */
+			pci_bus_add_device(pdev);
+			device->driver_published = true;
+		} else if (!device_is_bound(&pdev->dev) &&
+			   atomic_read(&mboot_gpu_probe_gate) == 0) {
 			mboot_boot_device_error("GPU RETRY",
 						device->info.requester);
 			result = device_attach(&pdev->dev);
@@ -3879,6 +3918,8 @@
 
 static void mboot_ready_workfn(struct work_struct *work)
 {
+	if (atomic_read(&mboot_gpu_probe_gate) == 1)
+		return;
 	mboot_reprobe_display();
 	if (!mboot_display_backend_ready()) {
 		/* Do not reset the deadline on each 100 ms readiness retry. */
@@ -3924,6 +3965,13 @@
 	}
 	if (fb_register_client(&mboot_fb_notifier))
 		return -EIO;
+	if (atomic_read(&mboot_gpu_probe_gate) == 1) {
+		int error = sysfs_create_file(kernel_kobj, &mboot_gpu_probe_start_attr.attr);
+
+		if (error)
+			return error;
+		pr_info("mDriver: GPU probe held until the network log receiver acknowledges\n");
+	}
 	/* Run after late init returns so a GPU probe cannot block initcalls. */
 	mod_delayed_work(system_wq, &mboot_ready_work, msecs_to_jiffies(100));
 	return 0;
