From 0000000000000000000000000000000000000036 Mon Sep 17 00:00:00 2001
From: tas0dev <156896971+tas0dev@users.noreply.github.com>
Date: Mon, 31 Aug 2026 20:30:00 +0900
Subject: [PATCH] x86/mboot: cache PCI driver state during publication

The display readiness check runs immediately after PCI publication.  Keep the
driver-core match and bind result while the publishing loop already owns a
reference to the device, rather than looking it up again during late init.
---
 arch/x86/kernel/cpu/mboot.c | 19 ++++++++-----------
 1 file changed, 8 insertions(+), 11 deletions(-)

diff --git a/arch/x86/kernel/cpu/mboot.c b/arch/x86/kernel/cpu/mboot.c
index e3bb22700000..4e76e4500000 100644
--- a/arch/x86/kernel/cpu/mboot.c
+++ b/arch/x86/kernel/cpu/mboot.c
@@ -296,6 +296,8 @@ struct mboot_pci_frontend {
 	u8 resource_count;
 	int irqs[2];
 	unsigned int irq_count;
+	bool driver_matched;
+	bool driver_bound;
 };
 
 static struct mboot_pci_frontend mboot_pci_devices[MBOOT_MAX_ASSIGNED_DEVICES];
@@ -886,6 +888,8 @@ static int __init mboot_pci_publish_frontend(void)
 		if (!pdev)
 			return -ENODEV;
 		pci_bus_add_device(pdev);
+		device->driver_matched = pdev->dev.can_match;
+		device->driver_bound = device_is_bound(&pdev->dev);
 		pci_dev_put(pdev);
 		mboot_boot_device_error("BOUND", device->info.requester);
 	}
@@ -1021,7 +1025,6 @@ static int __init mboot_wait_for_display_backend(void)
 	for (index = 0; index < mboot_pci_device_count; index++) {
 		const struct mboot_pci_frontend *device =
 			&mboot_pci_devices[index];
-		struct pci_dev *pdev;
 
 		if (mboot_control_device_kind(&device->info) !=
 		    MBOOT_DEVICE_KIND_DISPLAY)
@@ -1029,16 +1032,10 @@ static int __init mboot_wait_for_display_backend(void)
 		display_present = true;
 		display_vendor = device->config[PCI_VENDOR_ID / 4] & 0xffff;
 		display_device = device->config[PCI_VENDOR_ID / 4] >> 16;
-		pdev = pci_get_domain_bus_and_slot(0,
-					       device->info.requester >> 8,
-					       device->info.requester & 0xff);
-		if (pdev) {
-			driver_matched = pdev->dev.can_match;
-			driver_bound = device_is_bound(&pdev->dev);
-			pr_info("mDriver: display matched=%u, bound=%u\n",
-				driver_matched, driver_bound);
-			pci_dev_put(pdev);
-		}
+		driver_matched = device->driver_matched;
+		driver_bound = device->driver_bound;
+		pr_info("mDriver: display matched=%u, bound=%u\n",
+			driver_matched, driver_bound);
 		if (driver_bound)
 			break;
 	}
-- 
