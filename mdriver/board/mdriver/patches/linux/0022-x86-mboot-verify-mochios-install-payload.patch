From 7e5c5b93d2a6249ac3c5a7400f61f269be957da9 Mon Sep 17 00:00:00 2001
From: tas0dev <156896971+tas0dev@users.noreply.github.com>
Date: Sat, 29 Aug 2026 00:00:02 +0900
Subject: [PATCH] x86/mboot: verify the mochiOS install payload

Hash the complete source payload before writing to the selected target.
The expected SHA-256 digest arrives through a read-only grant created by the
System Domain from its signed initfs.
---
 arch/x86/kernel/cpu/mboot.c | 73 +++++++++++++++++++++++++++++++++++--
 1 file changed, 71 insertions(+), 2 deletions(-)

diff --git a/arch/x86/kernel/cpu/mboot.c b/arch/x86/kernel/cpu/mboot.c
index 0c815a44e943..860404cfcf21 100644
--- a/arch/x86/kernel/cpu/mboot.c
+++ b/arch/x86/kernel/cpu/mboot.c
@@ -23,6 +23,7 @@
 #include <linux/slab.h>
 #include <linux/string.h>
 #include <linux/unaligned.h>
+#include <crypto/hash.h>
 
 #include <asm/apic.h>
 #include <asm/cpufeature.h>
@@ -148,6 +149,7 @@ static const u8 mboot_installer_payload_type[16] = {
 #define MBOOT_BLOCK_DATA_PAGE 1
 #define MBOOT_BLOCK_RING_PAGE 2
 #define MBOOT_BLOCK_BUFFER_FIRST_PAGE 3
+#define MBOOT_INSTALL_METADATA_PAGE 8
 #define MBOOT_BLOCK_BUFFER_COUNT 4
 #define MBOOT_BLOCK_RING_GENERATION 1
 #define MBOOT_BLOCK_REQUEST_KIND 3
@@ -2208,6 +2210,70 @@ static int mboot_installer_find_payload(struct block_device *target_bdev,
 	return found == 1 && !result ? 0 : result ?: -ENOENT;
 }
 
+static int mboot_installer_verify_payload(struct file *source, u64 first,
+					   u64 count, unsigned long grant_ref)
+{
+	struct crypto_shash *tfm;
+	struct shash_desc *desc;
+	u8 actual[32];
+	u8 *buffer;
+	void *expected = NULL;
+	u64 length;
+	u64 offset = 0;
+	u64 address = mboot_grant_window_start +
+		MBOOT_INSTALL_METADATA_PAGE * PAGE_SIZE;
+	int result;
+
+	if (!grant_ref || check_mul_overflow(count,
+					     (u64)MBOOT_BLOCK_SECTOR_SIZE,
+					     &length) || !length)
+		return -EINVAL;
+	result = mboot_hypercall(MBOOT_HYPERCALL_GRANT_MAP,
+				 grant_ref, address, 0);
+	if (result)
+		return -EINVAL;
+	expected = memremap(address, PAGE_SIZE, MEMREMAP_WB);
+	if (!expected) {
+		result = -ENOMEM;
+		goto out_unmap;
+	}
+	tfm = crypto_alloc_shash("sha256", 0, 0);
+	if (IS_ERR(tfm)) {
+		result = PTR_ERR(tfm);
+		goto out_expected;
+	}
+	desc = kzalloc(sizeof(*desc) + crypto_shash_descsize(tfm), GFP_KERNEL);
+	buffer = kvmalloc(SZ_1M, GFP_KERNEL);
+	if (!desc || !buffer) {
+		result = -ENOMEM;
+		goto out_crypto;
+	}
+	desc->tfm = tfm;
+	result = crypto_shash_init(desc);
+	while (!result && offset < length) {
+		size_t chunk = min_t(u64, SZ_1M, length - offset);
+		u64 source_offset = first * MBOOT_BLOCK_SECTOR_SIZE + offset;
+
+		result = mboot_block_read_exact(source, source_offset, buffer, chunk);
+		if (!result)
+			result = crypto_shash_update(desc, buffer, chunk);
+		offset += chunk;
+	}
+	if (!result)
+		result = crypto_shash_final(desc, actual);
+	if (!result && memcmp(actual, expected, sizeof(actual)))
+		result = -EKEYREJECTED;
+out_crypto:
+	kvfree(buffer);
+	kfree(desc);
+	crypto_free_shash(tfm);
+out_expected:
+	memunmap(expected);
+out_unmap:
+	mboot_hypercall(MBOOT_HYPERCALL_GRANT_UNMAP, grant_ref, 0, 0);
+	return result;
+}
+
 static int mboot_installer_copy_partition(struct file *target,
 					   const u64 arguments[4], u64 values[4])
 {
@@ -2220,7 +2286,7 @@ static int mboot_installer_copy_partition(struct file *target,
 	u8 *buffer;
 	int result;
 
-	if (arguments[0] > U32_MAX || arguments[3] ||
+	if (arguments[0] > U32_MAX || !arguments[3] || arguments[3] > U32_MAX ||
 	    (!arguments[1] && !arguments[2]))
 		return -EINVAL;
 	result = mboot_storage_inspect(target,
@@ -2245,6 +2311,10 @@ static int mboot_installer_copy_partition(struct file *target,
 		result = -ENOSPC;
 		goto out_source;
 	}
+	result = mboot_installer_verify_payload(source, source_first,
+						 source_count, arguments[3]);
+	if (result)
+		goto out_source;
 	buffer = kvmalloc(SZ_1M, GFP_KERNEL);
 	if (!buffer) {
 		result = -ENOMEM;
@@ -2312,7 +2382,8 @@ static void mboot_control_install_partition(const struct mboot_control_request *
 		response->status = MBOOT_CONTROL_STATUS_NOT_FOUND;
 	else if (result == -ENOSPC || result == -ERANGE)
 		response->status = MBOOT_CONTROL_STATUS_OUT_OF_RANGE;
-	else if (result == -EINVAL || result == -ESTALE || result == -EEXIST)
+	else if (result == -EINVAL || result == -ESTALE || result == -EEXIST ||
+		 result == -EKEYREJECTED)
 		response->status = MBOOT_CONTROL_STATUS_INVALID_REQUEST;
 	else
 		response->status = MBOOT_CONTROL_STATUS_IO_ERROR;
-- 
2.43.0

