From: mochiOS developers
Subject: [PATCH] x86/mboot: release first GPU probe without a log receiver

Publish the GPU once PCI drivers are ready, independently of the network
relay. Keep the released state so the old device_attach retry is not used.
Do not report an intentionally unpublished device as a probe failure.
Keep the sysfs endpoint for relay compatibility (it returns EALREADY).

diff --git a/arch/x86/kernel/cpu/mboot.c b/arch/x86/kernel/cpu/mboot.c
--- a/arch/x86/kernel/cpu/mboot.c
+++ b/arch/x86/kernel/cpu/mboot.c
@@ -1202,7 +1202,6 @@
 				if (error)
 					pci_warn(pdev, "gpu_probe sysfs failed: %d\n", error);
 				if (atomic_read(&mboot_gpu_probe_gate) == 1) {
-					mboot_gpu_probe_report(pdev);
 					pci_dev_put(pdev);
 					continue;
 				}
@@ -4105,12 +4104,15 @@
 	if (atomic_read(&mboot_gpu_probe_gate) == 1) {
 		int error = sysfs_create_file(kernel_kobj, &mboot_gpu_probe_start_attr.attr);
 
 		if (error)
-			return error;
-		pr_info("mDriver: GPU probe held until the network log receiver acknowledges\n");
-		mboot_boot_status("DISPLAY\nMDRIVER PCI PUBLISHED\nWAIT DHCP / LOG ACK\nGPU PROBE NOT STARTED");
+			pr_warn("mDriver: optional GPU probe status endpoint: %d\n", error);
+		mboot_boot_status("DISPLAY\nMDRIVER PCI PUBLISHED\nSTARTING GPU PROBE\nLOG RECEIVER OPTIONAL");
+		/* Drivers are registered. Network readiness must not gate the GPU. */
+		atomic_set(&mboot_gpu_probe_gate, 2);
+		unregister_console(&mboot_log_console);
+		pr_info("mDriver: starting first GPU probe without log receiver ACK\n");
 	}
 	/* Run after late init returns so a GPU probe cannot block initcalls. */
 	mod_delayed_work(system_wq, &mboot_ready_work, msecs_to_jiffies(100));
 	return 0;
 }
