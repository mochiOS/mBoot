From: mochiOS developers
Subject: [PATCH] x86/mboot: stop before GPU publication for MMIO comparison

Explicit diagnostic boot only. Read FORCEWAKE_MT without register writes,
report through the retained firmware display, and never publish the GPU.

--- a/arch/x86/kernel/cpu/mboot.c
+++ b/arch/x86/kernel/cpu/mboot.c
@@ -354,6 +354,15 @@
 }
 early_param("mboot.log", mboot_gpu_wait_for_log);
 
+static bool mboot_mmio_check;
+static int __init mboot_mmio_check_param(char *value)
+{
+	mboot_mmio_check = true;
+	atomic_set(&mboot_gpu_probe_gate, 1);
+	return 0;
+}
+early_param("mboot.mmio_check", mboot_mmio_check_param);
+
 static unsigned long mboot_hypercall(unsigned long number,
 				     unsigned long arg0, unsigned long arg1,
 				     unsigned long arg2);
@@ -882,6 +891,64 @@
 }
 static DEVICE_ATTR_RO(gpu_probe);
 
+static void __init mboot_check_gpu_mmio(void)
+{
+	unsigned int index;
+	bool found = false;
+
+	for (index = 0; index < mboot_pci_device_count; index++) {
+		struct mboot_pci_frontend *device = &mboot_pci_devices[index];
+		struct pci_dev *pdev;
+		void __iomem *reg = NULL;
+		char report[768];
+		u16 command = 0;
+		u32 first = 0, second = 0;
+		int len;
+
+		if (device->info.class != PCI_BASE_CLASS_DISPLAY)
+			continue;
+		pdev = pci_get_domain_bus_and_slot(0, device->info.requester >> 8,
+						 device->info.requester & 0xff);
+		if (!pdev)
+			continue;
+		if (pdev->vendor != PCI_VENDOR_ID_INTEL || pdev->devfn != PCI_DEVFN(2, 0)) {
+			pci_dev_put(pdev);
+			continue;
+		}
+		found = true;
+		pci_read_config_word(pdev, PCI_COMMAND, &command);
+		if ((command & PCI_COMMAND_MEMORY) &&
+		    (pci_resource_flags(pdev, 0) & IORESOURCE_MEM) &&
+		    pci_resource_len(pdev, 0) >= 0xa18c)
+			reg = ioremap(pci_resource_start(pdev, 0) + 0xa188, 4);
+		if (reg) {
+			first = readl(reg);
+			second = readl(reg);
+			iounmap(reg);
+		}
+		len = scnprintf(report, sizeof(report),
+			"GPU MMIO CHECK\nSTOPPED BEFORE I915 / NO KMS\n"
+			"BDF %s ID %04x:%04x REV %02x\n"
+			"LINUX COMMAND %04x\n"
+			"LINUX BAR0 GPA %llx SIZE %llx FLAGS %lx\n"
+			"LINUX BAR2 GPA %llx SIZE %llx FLAGS %lx\n"
+			"LINUX FORCEWAKE_MT OFFSET 0000a188\n"
+			"LINUX READ_VALID %u VALUES %08x %08x\n",
+			pci_name(pdev), pdev->vendor, pdev->device, pdev->revision,
+			command, (u64)pci_resource_start(pdev, 0),
+			(u64)pci_resource_len(pdev, 0), pci_resource_flags(pdev, 0),
+			(u64)pci_resource_start(pdev, 2),
+			(u64)pci_resource_len(pdev, 2), pci_resource_flags(pdev, 2),
+			!!reg, first, second);
+		mboot_console_write_buffer(report, len, MBOOT_CONSOLE_ERROR | 1);
+		pci_dev_put(pdev);
+	}
+	if (!found) {
+		const char *report = "GPU MMIO CHECK\nSTOPPED BEFORE I915 / NO KMS\nNO ASSIGNED INTEL GPU AT SLOT 02.0\n";
+		mboot_console_write_buffer(report, strlen(report), MBOOT_CONSOLE_ERROR | 1);
+	}
+}
+
 static void mboot_gpu_probe_report(struct pci_dev *pdev)
 {
 	char *report = (char *)get_zeroed_page(GFP_KERNEL);
@@ -4099,6 +4166,11 @@
 	error = mboot_pci_device_count ? mboot_pci_publish_frontend() : 0;
 	if (error)
 		return error;
+	if (mboot_mmio_check) {
+		mboot_check_gpu_mmio();
+		/* Deliberate diagnostic stop: no GPU publication or release endpoint. */
+		return 0;
+	}
 	if (fb_register_client(&mboot_fb_notifier))
 		return -EIO;
 	if (atomic_read(&mboot_gpu_probe_gate) == 1) {
