--- /dev/null
+++ b/drivers/virt/mboot/mboot_ramdisk.h
@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Explicit, ephemeral RAM storage for an admitted boot image. This is a real
+ * Linux block device, never a fabricated PCI requester or a DMA assignment.
+ */
+#include <linux/major.h>
+
+#define MBOOT_RAMDISK_ID 0x40000001U
+#define MBOOT_DEVICE_FEATURE_SOFTWARE BIT_ULL(32)
+
+static bool mboot_ramdisk_expected;
+static bool mboot_ramdisk_ready;
+
+static int __init mboot_boot_ramdisk_param(char *value)
+{
+	return value ? kstrtobool(value, &mboot_ramdisk_expected) : -EINVAL;
+}
+early_param("mboot.boot_ramdisk", mboot_boot_ramdisk_param);
+
+static bool mboot_ramdisk_available(void)
+{
+	return smp_load_acquire(&mboot_ramdisk_ready);
+}
+
+static unsigned int mboot_catalog_count(void)
+{
+	return mboot_pci_device_count + mboot_ramdisk_available();
+}
+
+static u64 mboot_catalog_kind(u32 id)
+{
+	if (id == MBOOT_RAMDISK_ID && mboot_ramdisk_available())
+		return MBOOT_DEVICE_KIND_BLOCK;
+	if (!id || id > mboot_pci_device_count)
+		return MBOOT_DEVICE_KIND_OTHER;
+	return mboot_control_device_kind(&mboot_pci_devices[id - 1].info);
+}
+
+static u64 mboot_catalog_features(u32 id)
+{
+	if (id == MBOOT_RAMDISK_ID && mboot_ramdisk_available())
+		return MBOOT_DEVICE_FEATURE_SOFTWARE | MBOOT_DEVICE_FEATURE_EPHEMERAL |
+			MBOOT_DEVICE_FEATURE_BLOCK_READ | MBOOT_DEVICE_FEATURE_BLOCK_WRITE |
+			MBOOT_DEVICE_FEATURE_BLOCK_FLUSH;
+	if (!id || id > mboot_pci_device_count)
+		return 0;
+	return mboot_control_device_features(&mboot_pci_devices[id - 1].info);
+}
+
+static struct file *mboot_catalog_block(u32 id, u64 *first, u64 *count)
+{
+	struct file *file;
+
+	if (id != MBOOT_RAMDISK_ID) {
+		if (!id || id > mboot_pci_device_count ||
+		    mboot_catalog_kind(id) != MBOOT_DEVICE_KIND_BLOCK)
+			return ERR_PTR(-ENODEV);
+		return mboot_block_lookup(&mboot_pci_devices[id - 1].info, first, count);
+	}
+	if (!mboot_ramdisk_available())
+		return ERR_PTR(-ENODEV);
+	file = bdev_file_open_by_dev(MKDEV(RAMDISK_MAJOR, 0),
+				    BLK_OPEN_READ | BLK_OPEN_WRITE, NULL, NULL);
+	if (IS_ERR(file))
+		return file;
+	if (mboot_scope_conflicts(file)) {
+		fput(file);
+		return ERR_PTR(-EBUSY);
+	}
+	*first = 0;
+	*count = bdev_nr_sectors(file_bdev(file));
+	return file;
+}
+
+static int mboot_ramdisk_validate(struct file *file)
+{
+	struct block_device *bdev = file_bdev(file);
+	struct mboot_gpt_copy primary, backup;
+	const u8 *entry;
+	u32 slot, block = bdev_logical_block_size(bdev);
+	u64 sectors;
+	int result;
+
+	if (block != 512 || !disk_live(bdev->bd_disk))
+		return -EINVAL;
+	sectors = bdev_nr_sectors(bdev);
+	if (sectors < 6)
+		return -EINVAL;
+	result = mboot_gpt_validate_pmbr(file, sectors, block);
+	if (result)
+		return result;
+	result = mboot_gpt_read_copy(file, 1, sectors - 1, sectors, block,
+				     NULL, &primary);
+	if (result)
+		return result;
+	result = mboot_gpt_read_copy(file, sectors - 1, 1, sectors, block,
+				     NULL, &backup);
+	if (result)
+		goto out_primary;
+	if (!mboot_gpt_copies_match(&primary, &backup))
+		result = -EINVAL;
+	else
+		/* Also checks every entry, unique GUIDs, bounds and overlap. */
+		result = mboot_gpt_partition_at(&primary, 0, &entry, &slot);
+	mboot_gpt_copy_free(&backup);
+out_primary:
+	mboot_gpt_copy_free(&primary);
+	return result;
+}
+
+static ssize_t mboot_boot_disk_ready_store(struct kobject *kobject,
+					 struct kobj_attribute *attribute,
+					 const char *buffer, size_t count)
+{
+	struct file *file;
+	int result;
+
+	if (!mboot_ramdisk_expected || !sysfs_streq(buffer, "1"))
+		return -EINVAL;
+	if (mboot_ramdisk_available())
+		return -EALREADY;
+	file = bdev_file_open_by_dev(MKDEV(RAMDISK_MAJOR, 0),
+				    BLK_OPEN_READ | BLK_OPEN_WRITE, NULL, NULL);
+	if (IS_ERR(file))
+		return PTR_ERR(file);
+	result = vfs_fsync(file, 0);
+	if (!result)
+		result = mboot_ramdisk_validate(file);
+	fput(file);
+	if (result)
+		return result;
+	smp_store_release(&mboot_ramdisk_ready, true);
+	pr_info("mDriver: validated ephemeral RAM block device available\n");
+	return count;
+}
+
+static struct kobj_attribute mboot_boot_disk_ready_attr =
+	__ATTR_WO(mboot_boot_disk_ready);
+
+static int __init mboot_ramdisk_init(void)
+{
+	if (!mboot_arch_present() || !mboot_ramdisk_expected)
+		return 0;
+	if (!IS_ENABLED(CONFIG_BLK_DEV_RAM))
+		return -EOPNOTSUPP;
+	return sysfs_create_file(kernel_kobj, &mboot_boot_disk_ready_attr.attr);
+}
+device_initcall(mboot_ramdisk_init);
