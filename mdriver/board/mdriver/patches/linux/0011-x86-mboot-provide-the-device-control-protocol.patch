+#define MBOOT_DEVICE_KIND_BLOCK 1
+#define MBOOT_DEVICE_KIND_NETWORK 2
+#define MBOOT_DEVICE_KIND_DISPLAY 3
+#define MBOOT_DEVICE_KIND_USB 4
+#define MBOOT_DEVICE_KIND_SOUND 5
