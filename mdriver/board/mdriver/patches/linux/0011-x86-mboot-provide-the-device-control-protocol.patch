-static int __init mboot_control_ring_reply(void)
+static struct mboot_ring_page *mboot_control_ring;
+static bool mboot_control_negotiated;
+static bool mboot_control_active;
+
+static u64 mboot_control_device_kind(const struct mboot_pci_device_info *info)
+{
+	switch (info->class) {
+	case PCI_BASE_CLASS_STORAGE:
+		return MBOOT_DEVICE_KIND_BLOCK;
+	case PCI_BASE_CLASS_NETWORK:
+		return MBOOT_DEVICE_KIND_NETWORK;
+	case PCI_BASE_CLASS_DISPLAY:
+		return MBOOT_DEVICE_KIND_DISPLAY;
+	case PCI_BASE_CLASS_MULTIMEDIA:
+		return MBOOT_DEVICE_KIND_SOUND;
+	case PCI_BASE_CLASS_SERIAL:
+		return info->subclass == (PCI_CLASS_SERIAL_USB & 0xff) ?
+			MBOOT_DEVICE_KIND_USB : MBOOT_DEVICE_KIND_OTHER;
+	default:
+		return MBOOT_DEVICE_KIND_OTHER;
+	}
+}
+
+static bool mboot_control_zero_arguments(const u64 arguments[4])
+{
+	return !memchr_inv(arguments, 0, sizeof(u64) * 4);
+}
+
+static void mboot_control_handle(const struct mboot_control_request *request,
+				 struct mboot_control_response *response)
 {
-	struct mboot_ring_message response = {
-		.kind = MBOOT_CONTROL_RESPONSE_KIND,
-		.len = 5,
-		.request_id = MBOOT_CONTROL_REQUEST_ID,
-		.payload = "ready",
-	};
+	const struct mboot_pci_frontend *device;
+	u32 index;
+
+	memset(response, 0, sizeof(*response));
+	response->version = MBOOT_CONTROL_VERSION;
+	response->operation = request->operation;
+	response->device_id = request->device_id;
+	response->status = MBOOT_CONTROL_STATUS_INVALID_REQUEST;
+	if (request->flags || request->reserved)
+		return;
+	if (request->version != MBOOT_CONTROL_VERSION) {
+		response->status = MBOOT_CONTROL_STATUS_UNSUPPORTED_VERSION;
+		return;
+	}
+	if (request->operation == MBOOT_CONTROL_NEGOTIATE) {
+		if (request->device_id || request->arguments[2] ||
+		    request->arguments[3])
+			return;
+		if (request->arguments[0] > MBOOT_CONTROL_VERSION ||
+		    request->arguments[1] < MBOOT_CONTROL_VERSION) {
+			response->status = MBOOT_CONTROL_STATUS_UNSUPPORTED_VERSION;
+			return;
+		}
+		mboot_control_negotiated = true;
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		response->values[0] = MBOOT_CONTROL_VERSION;
+		response->values[1] = MBOOT_CONTROL_CAPABILITIES;
+		response->values[2] = mboot_pci_device_count;
+		response->values[3] = mboot_control_ring->header.generation;
+		return;
+	}
+	if (!mboot_control_negotiated) {
+		response->status = MBOOT_CONTROL_STATUS_BAD_STATE;
+		return;
+	}
+	switch (request->operation) {
+	case MBOOT_CONTROL_ENUMERATE:
+		if (request->device_id || request->arguments[1] ||
+		    request->arguments[2] || request->arguments[3] ||
+		    request->arguments[0] > U32_MAX)
+			return;
+		index = request->arguments[0];
+		if (index >= mboot_pci_device_count) {
+			response->status = MBOOT_CONTROL_STATUS_END;
+			return;
+		}
+		device = &mboot_pci_devices[index];
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		response->device_id = index + 1;
+		response->values[0] = index + 1;
+		response->values[1] = mboot_control_device_kind(&device->info);
+		response->values[2] = MBOOT_DEVICE_STATE_ONLINE;
+		response->values[3] = MBOOT_DEVICE_FEATURES;
+		return;
+	case MBOOT_CONTROL_DESCRIBE:
+		if (!mboot_control_zero_arguments(request->arguments))
+			return;
+		if (!request->device_id ||
+		    request->device_id > mboot_pci_device_count) {
+			response->status = MBOOT_CONTROL_STATUS_NOT_FOUND;
+			return;
+		}
+		device = &mboot_pci_devices[request->device_id - 1];
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		response->values[0] = mboot_control_device_kind(&device->info);
+		response->values[1] = MBOOT_DEVICE_STATE_ONLINE;
+		response->values[2] = MBOOT_DEVICE_FEATURES;
+		response->values[3] = device->info.requester |
+				      (u64)device->info.class << 16 |
+				      (u64)device->info.subclass << 24;
+		return;
+	case MBOOT_CONTROL_PING:
+		if (request->device_id || request->arguments[1] ||
+		    request->arguments[2] || request->arguments[3])
+			return;
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		response->values[0] = request->arguments[0];
+		return;
+	case MBOOT_CONTROL_START_SESSION:
+		if (request->device_id ||
+		    !mboot_control_zero_arguments(request->arguments))
+			return;
+		if (mboot_control_active) {
+			response->status = MBOOT_CONTROL_STATUS_BAD_STATE;
+			return;
+		}
+		mboot_control_active = true;
+		response->status = MBOOT_CONTROL_STATUS_OK;
+		response->values[0] = mboot_control_ring->header.generation;
+		return;
+	default:
+		response->status = MBOOT_CONTROL_STATUS_UNSUPPORTED_OPERATION;
+	}
+}
+
+static int mboot_control_process(bool *session_started)
+{
+	struct mboot_control_response control_response;
+	struct mboot_control_request control_request;
+	struct mboot_ring_message response;
 	struct mboot_ring_message request;
-	struct mboot_ring_page *ring;
+	u32 response_producer;
+	u32 response_consumer;
+	u32 response_index;
+	u32 producer;
+	u32 consumer;
+	bool processed = false;
+
+	/* Pair with the System Domain's request publication. */
+	producer = smp_load_acquire(&mboot_control_ring->header.request_producer);
+	consumer = READ_ONCE(mboot_control_ring->header.request_consumer);
+	if (producer - consumer > MBOOT_CONTROL_RING_SLOTS)
+		return -EIO;
+	while (consumer != producer) {
+		bool valid_request;
+
+		memcpy(&request,
+		       &mboot_control_ring->requests[consumer % MBOOT_CONTROL_RING_SLOTS],
+		       sizeof(request));
+		memset(&control_request, 0, sizeof(control_request));
+		valid_request = request.kind == MBOOT_CONTROL_REQUEST_KIND &&
+				!request.flags &&
+				request.len == sizeof(control_request);
+		if (valid_request)
+			memcpy(&control_request, request.payload,
+			       sizeof(control_request));
+		if (valid_request) {
+			mboot_control_handle(&control_request, &control_response);
+		} else {
+			memset(&control_response, 0, sizeof(control_response));
+			control_response.version = MBOOT_CONTROL_VERSION;
+			control_response.status =
+				MBOOT_CONTROL_STATUS_INVALID_REQUEST;
+		}
+		memset(&response, 0, sizeof(response));
+		response.kind = MBOOT_CONTROL_RESPONSE_KIND;
+		response.len = sizeof(control_response);
+		response.request_id = request.request_id;
+		memcpy(response.payload, &control_response,
+		       sizeof(control_response));
+
+		response_producer = READ_ONCE(mboot_control_ring->header.response_producer);
+		/* Pair with the System Domain returning a response slot. */
+		response_consumer = smp_load_acquire(&mboot_control_ring->header.response_consumer);
+		if (response_producer - response_consumer >= MBOOT_CONTROL_RING_SLOTS)
+			return -ENOSPC;
+		response_index = response_producer % MBOOT_CONTROL_RING_SLOTS;
+		memcpy(&mboot_control_ring->responses[response_index], &response,
+		       sizeof(response));
+		/* Publish the response only after its contents are visible. */
+		smp_store_release(&mboot_control_ring->header.response_producer,
+				  response_producer + 1);
+		consumer++;
+		/* Finish reading the request before returning its slot. */
+		smp_store_release(&mboot_control_ring->header.request_consumer,
+				  consumer);
+		if (control_request.operation == MBOOT_CONTROL_START_SESSION &&
+		    control_response.status == MBOOT_CONTROL_STATUS_OK)
+			*session_started = true;
+		processed = true;
+	}
+	if (!processed)
+		return 0;
+	return mboot_hypercall(MBOOT_HYPERCALL_EVENT_SEND,
+			       MBOOT_CONTROL_RING_PORT, 0, 0) ? -EIO : 0;
+}
+
+static int mboot_control_worker(void *unused)
+{
+	while (!kthread_should_stop()) {
+		unsigned long result;
+		bool ignored = false;
+
+		result = mboot_hypercall(MBOOT_HYPERCALL_EVENT_POLL, 0, 0, 0);
+		if (result == MBOOT_CONTROL_RING_PORT) {
+			if (mboot_control_process(&ignored))
+				break;
+		} else if (result != MBOOT_EVENT_NO_EVENT) {
+			break;
+		}
+		msleep_interruptible(10);
+	}
+	pr_err("mDriver: device control worker stopped\n");
+	return -EIO;
+}
